@prefix dct: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://vocab.destiny-evidence.org/actors/DSNY000162> a skos:Concept ;
    skos:altLabel "Intergovernmental bodies",
        "Multilateral organisations",
        "UN agencies" ;
    skos:definition "Supranational bodies including United Nations agencies, multilateral development banks, and intergovernmental organisations that coordinate global climate governance and financing." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "International organizations" .

<https://vocab.destiny-evidence.org/actors/DSNY000163> a skos:Concept ;
    skos:altLabel "Governments",
        "Public authorities",
        "State" ;
    skos:definition "National, regional, and local government bodies responsible for setting climate policy, enacting legislation, and implementing adaptation and mitigation measures within their jurisdictions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "Government" .

<https://vocab.destiny-evidence.org/actors/DSNY000164> a skos:Concept ;
    skos:altLabel "Business",
        "Corporations",
        "Industry" ;
    skos:definition "Commercial enterprises, industries, and business associations whose operations contribute to greenhouse gas emissions and who play a key role in the transition to a low-carbon economy." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "Private sector" .

<https://vocab.destiny-evidence.org/actors/DSNY000165> a skos:Concept ;
    skos:altLabel "Community organisations",
        "NGOs",
        "Non-governmental organisations" ;
    skos:definition "Non-profit organisations, advocacy groups, and community-based organisations that champion climate action, support vulnerable communities, and hold governments and businesses accountable." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "Civil society" .

<https://vocab.destiny-evidence.org/actors/DSNY000166> a skos:Concept ;
    skos:altLabel "Citizens",
        "Communities",
        "Individuals" ;
    skos:definition "Individual people and domestic units whose everyday choices, behaviours, and exposure to climate risks make them both contributors to and targets of climate action." ;
    skos:inScheme <https://vocab.destiny-evidence.org/actors> ;
    skos:prefLabel "Households and individuals" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000056> a skos:Concept ;
    skos:altLabel "General climate change",
        "Unspecified climate change" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000055> ;
    skos:definition "Climate change where the specific driver or mechanism is not identified or distinguished, used when studies refer to climate change in general terms." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Climate change (unspecified)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000057> a skos:Concept ;
    skos:altLabel "Temperature change",
        "Temperature shift",
        "Warming" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000055> ;
    skos:definition "Long-term shifts in average or extreme temperature conditions, including warming trends, that affect human health, ecosystems, and society." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Changes in temperature" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000058> a skos:Concept ;
    skos:altLabel "Changes in rainfall",
        "Precipitation variability",
        "Rainfall change" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000055> ;
    skos:definition "Alterations in the amount, timing, or intensity of rainfall and snowfall, affecting water availability, flood risk, and drought conditions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Changes in precipitation" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000059> a skos:Concept ;
    skos:altLabel "Atmospheric moisture change",
        "Humidity change" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000055> ;
    skos:definition "Shifts in atmospheric moisture levels that affect thermal comfort, respiratory health, and the prevalence of moisture-related diseases." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Changes in humidity" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000060> a skos:Concept ;
    skos:altLabel "Wind pattern change",
        "Wind variability" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000055> ;
    skos:definition "Alterations in wind patterns and velocity that can affect air quality, energy systems, and the spread of airborne pathogens and pollutants." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Changes in wind speed" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000061> a skos:Concept ;
    skos:altLabel "Cryosphere change",
        "Glacier melt",
        "Snowmelt" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000055> ;
    skos:definition "Accelerated melting of glaciers and snowpack due to rising temperatures, affecting freshwater supply, sea levels, and downstream ecosystems." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Changes in glaciar/snow melt" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000062> a skos:Concept ;
    skos:altLabel "Phenological change",
        "Season length change",
        "Seasonal shift" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000055> ;
    skos:definition "Shifts in the duration of seasons, including earlier spring onset and extended summers, with consequences for agriculture, vector biology, and human health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Changes in season lenght" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000063> a skos:Concept ;
    skos:altLabel "Unspecified weather change",
        "Weather variability" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000055> ;
    skos:definition "General changes in weather patterns not attributed to a specific meteorological variable, used when studies refer to weather variability in broad terms." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Changes in weather (unspecified)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000064> a skos:Concept ;
    skos:altLabel "Coastal inundation",
        "Ocean level rise",
        "Sea level change" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000055> ;
    skos:definition "The increase in mean sea level resulting from thermal expansion of seawater and melting ice, threatening coastal communities, infrastructure, and freshwater resources." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Sea level rise" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000066> a skos:Concept ;
    skos:altLabel "General climate extremes",
        "Unspecified extreme weather" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000065> ;
    skos:definition "Extreme weather events where the specific type is not identified, used when studies refer to climate extremes without distinguishing between event types." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Extreme weather events (unspecified)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000067> a skos:Concept ;
    skos:altLabel "Flash floods",
        "Flooding",
        "Inundation" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000065> ;
    skos:definition "Temporary inundation of normally dry land caused by excessive rainfall, storm surges, or rapid snowmelt, posing risks to human health, displacement, and infrastructure." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Floods" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000068> a skos:Concept ;
    skos:altLabel "Arid conditions",
        "Drought conditions",
        "Water scarcity" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000065> ;
    skos:definition "Prolonged periods of abnormally low rainfall leading to water scarcity, crop failure, and increased risk of wildfires, with significant health and livelihood consequences." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Droughts" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000069> a skos:Concept ;
    skos:altLabel "Cyclones",
        "Hurricanes",
        "Typhoons" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000065> ;
    skos:definition "Intense meteorological events including tropical cyclones, hurricanes, typhoons, and severe thunderstorms, causing wind damage, flooding, and displacement." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Storms" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000070> a skos:Concept ;
    skos:altLabel "Heat events",
        "Heatwaves",
        "High temperature extremes" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000065> ;
    skos:definition "Periods of abnormally high temperatures, including heatwaves, that pose direct health risks such as heat exhaustion, heat stroke, and excess mortality." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Extreme heat" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000071> a skos:Concept ;
    skos:altLabel "Cold snaps",
        "Cold waves",
        "Freezing events" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000065> ;
    skos:definition "Episodes of abnormally low temperatures, including cold snaps and blizzards, associated with increased risk of hypothermia, cardiovascular events, and respiratory illness." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Extreme cold" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000072> a skos:Concept ;
    skos:altLabel "Bushfires",
        "Forest fires",
        "Landscape fires" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000065> ;
    skos:definition "Uncontrolled fires in natural vegetation, increasingly associated with drought and heat, producing smoke and air pollution with severe respiratory and cardiovascular health impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Wildfires" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000074> a skos:Concept ;
    skos:altLabel "GHGs",
        "Heat-trapping gases",
        "Unspecified greenhouse gases" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000073> ;
    skos:definition "Atmospheric gases that trap heat and contribute to the greenhouse effect, referred to collectively without specifying the individual gas type." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Greenhouse gases (unspecified)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000075> a skos:Concept ;
    skos:altLabel "CO2",
        "Carbon dioxide emissions" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000073> ;
    skos:definition "The primary long-lived greenhouse gas produced by fossil fuel combustion, deforestation, and industrial processes, responsible for the majority of anthropogenic radiative forcing." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Carbon dioxide (CO₂)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000076> a skos:Concept ;
    skos:altLabel "CH4",
        "Methane emissions",
        "Natural gas emissions" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000073> ;
    skos:definition "A potent short-lived greenhouse gas emitted from livestock, rice cultivation, landfills, and fossil fuel extraction, with a global warming potential far exceeding that of CO₂ over 20 years." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Methane (CH₄)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000077> a skos:Concept ;
    skos:altLabel "Agricultural greenhouse gas",
        "N2O",
        "Nitrous oxide emissions" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000073> ;
    skos:definition "A greenhouse gas and ozone-depleting substance emitted primarily from agricultural soils, livestock, and nitrogen fertilisers, with a high global warming potential." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Nitrous oxide (N₂O)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000078> a skos:Concept ;
    skos:altLabel "F-gases",
        "HFCs",
        "Synthetic greenhouse gases" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000073> ;
    skos:definition "A group of potent synthetic greenhouse gases used in industrial applications, refrigeration, and electronics manufacturing, with very high global warming potentials and long atmospheric lifetimes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Fluorinated gases (hydrofluorocarbons, perfluorocarbons, sulfur hexafluoride, nitrogen trifluoride)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000079> a skos:Concept ;
    skos:altLabel "Ground-level ozone",
        "O3",
        "Ozone pollution" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000073> ;
    skos:definition "A short-lived climate pollutant and air quality hazard formed by photochemical reactions between nitrogen oxides and volatile organic compounds, harmful to respiratory health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Tropospheric ozone (O₃)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000080> a skos:Concept ;
    skos:altLabel "CFCs",
        "ODSs",
        "Ozone-depleting chemicals" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000073> ;
    skos:definition "Chemical compounds that destroy stratospheric ozone and act as potent greenhouse gases, regulated under the Montreal Protocol due to their combined climate and health impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Ozone-depleting substances (chlorofluorocarbons, hydrochlorofluorocarbons, halons, carbon tetrachloride, methyl chloroform)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000081> a skos:Concept ;
    skos:altLabel "Fine particles",
        "PM2.5",
        "Particulate air pollution" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000073> ;
    skos:definition "Airborne particles of 2.5 micrometres or less in diameter, including black carbon and sulfate aerosols, that affect both climate and human health through respiratory and cardiovascular pathways." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Fine particulate matter (PM₂.₅) (and its components black carbon, organic carbon, sulfate aerosols, nitrate aerosols)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000083> a skos:Concept ;
    skos:altLabel "General fossil fuels",
        "Unspecified fossil fuels" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000082> ;
    skos:definition "Fossil fuel use or combustion where the specific fuel type is not identified, used when studies refer to fossil fuels in general without distinguishing between coal, oil, or gas." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Fossil fuels (unspecified)" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000084> a skos:Concept ;
    skos:altLabel "Brown coal",
        "Hard coal",
        "Lignite" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000082> ;
    skos:definition "A solid fossil fuel formed from ancient plant matter, the most carbon-intensive energy source and a major contributor to greenhouse gas emissions and air pollution." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Coal" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000085> a skos:Concept ;
    skos:altLabel "Gas",
        "LNG",
        "Methane gas" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000082> ;
    skos:definition "A fossil fuel composed primarily of methane, used for heating, electricity generation, and industrial processes, with lower CO₂ emissions than coal but significant methane leakage risks." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Natural gas" .

<https://vocab.destiny-evidence.org/climate-factor/DSNY000086> a skos:Concept ;
    skos:altLabel "Crude oil",
        "Petrol",
        "Petroleum" ;
    skos:broader <https://vocab.destiny-evidence.org/climate-factor/DSNY000082> ;
    skos:definition "A liquid fossil fuel refined into petroleum products including petrol, diesel, and jet fuel, a major source of greenhouse gas emissions from transport and industry." ;
    skos:inScheme <https://vocab.destiny-evidence.org/climate-factor> ;
    skos:prefLabel "Oil" .

<https://vocab.destiny-evidence.org/country-income-category/DSNY000136> a skos:Concept ;
    skos:altLabel "LIC",
        "Least developed countries",
        "Low-income countries" ;
    skos:definition "Countries classified by the World Bank as having the lowest gross national income per capita, typically facing the greatest climate vulnerability and least adaptive capacity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/country-income-category> ;
    skos:prefLabel "Low" .

<https://vocab.destiny-evidence.org/country-income-category/DSNY000137> a skos:Concept ;
    skos:altLabel "Developing countries",
        "LMIC",
        "Lower-middle income countries" ;
    skos:definition "Countries classified by the World Bank in the lower-middle income tier, often experiencing rapid development while remaining highly vulnerable to climate-related health and economic impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/country-income-category> ;
    skos:prefLabel "Lower middle" .

<https://vocab.destiny-evidence.org/country-income-category/DSNY000138> a skos:Concept ;
    skos:altLabel "Emerging economies",
        "UMIC",
        "Upper-middle income countries" ;
    skos:definition "Countries classified by the World Bank in the upper-middle income tier, with growing capacity for climate adaptation and mitigation but still facing significant climate risks." ;
    skos:inScheme <https://vocab.destiny-evidence.org/country-income-category> ;
    skos:prefLabel "Upper middle" .

<https://vocab.destiny-evidence.org/country-income-category/DSNY000139> a skos:Concept ;
    skos:altLabel "Developed countries",
        "HIC",
        "High-income countries" ;
    skos:definition "Countries classified by the World Bank as having the highest gross national income per capita, generally with the greatest adaptive capacity but also the highest historical contributions to cumulative emissions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/country-income-category> ;
    skos:prefLabel "High" .

<https://vocab.destiny-evidence.org/exposure/DSNY000155> a skos:Concept ;
    skos:altLabel "Heat exposure",
        "Thermal load",
        "Thermal stress" ;
    skos:definition "Physiological strain experienced by the body when ambient heat and humidity exceed its capacity to regulate temperature, leading to heat-related illness and increased mortality risk." ;
    skos:inScheme <https://vocab.destiny-evidence.org/exposure> ;
    skos:prefLabel "Heat stress" .

<https://vocab.destiny-evidence.org/exposure/DSNY000156> a skos:Concept ;
    skos:altLabel "Air pollution exposure",
        "Ambient air quality",
        "Atmospheric pollution" ;
    skos:definition "Exposure to pollutants in outdoor and indoor air, including particulate matter, ozone, and wildfire smoke, which are exacerbated by climate change and harm respiratory and cardiovascular health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/exposure> ;
    skos:prefLabel "Air quality" .

<https://vocab.destiny-evidence.org/exposure/DSNY000157> a skos:Concept ;
    skos:altLabel "Food security",
        "Food system impacts",
        "Nutritional exposure" ;
    skos:definition "Climate-related changes to the availability, safety, and nutritional quality of food, including impacts on crop yields, food contamination risks, and supply chain disruptions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/exposure> ;
    skos:prefLabel "Food supply and safety" .

<https://vocab.destiny-evidence.org/exposure/DSNY000158> a skos:Concept ;
    skos:altLabel "Hydrological exposure",
        "Water availability",
        "Water security" ;
    skos:definition "Climate-related changes to the quantity and quality of freshwater resources, including drought-driven scarcity, flood-related contamination, and shifts in precipitation affecting drinking water supply." ;
    skos:inScheme <https://vocab.destiny-evidence.org/exposure> ;
    skos:prefLabel "Water quality and quantity" .

<https://vocab.destiny-evidence.org/exposure/DSNY000159> a skos:Concept ;
    skos:altLabel "Meteorological exposure",
        "Natural hazard exposure",
        "Weather hazard" ;
    skos:definition "Direct physical exposure to extreme weather events such as floods, heatwaves, storms, and wildfires, which cause injury, displacement, mental health impacts, and mortality." ;
    skos:inScheme <https://vocab.destiny-evidence.org/exposure> ;
    skos:prefLabel "Extreme weather events" ;
    skos:scopeNote "Refers to human exposure to extreme weather events and their direct health consequences, including injury, displacement, and mortality. Distinct from 'Extreme weather events' in the Climate factor scheme, which classifies the meteorological phenomena as climate drivers." .

<https://vocab.destiny-evidence.org/exposure/DSNY000160> a skos:Concept ;
    skos:altLabel "Disease vector distribution",
        "Vector ecology",
        "Vector-borne disease risk" ;
    skos:definition "Climate-driven changes in the geographic range, seasonality, and abundance of disease vectors such as mosquitoes and ticks, altering the transmission risk of vector-borne diseases." ;
    skos:inScheme <https://vocab.destiny-evidence.org/exposure> ;
    skos:prefLabel "Vector distribution and ecology" .

<https://vocab.destiny-evidence.org/exposure/DSNY000161> a skos:Concept ;
    skos:altLabel "Conflict exposure",
        "Displacement",
        "Psychosocial stressors" ;
    skos:definition "Social and psychosocial stressors arising from climate-related displacement, resource scarcity, and conflict, which compound direct climate health impacts on affected populations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/exposure> ;
    skos:prefLabel "Social factors (forced displacement, violence, conflict)" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000140> a skos:Concept ;
    skos:altLabel "Built-up area",
        "City",
        "Metropolitan area" ;
    skos:definition "Densely populated areas characterised by built infrastructure and high human activity, where urban heat island effects and air pollution amplify climate-related health risks." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Urban" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000141> a skos:Concept ;
    skos:altLabel "Agricultural land",
        "Countryside",
        "Non-urban" ;
    skos:definition "Sparsely populated areas outside urban centres, often reliant on agriculture and natural resources, and facing distinct climate risks including drought, flooding, and reduced service access." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Rural" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000142> a skos:Concept ;
    skos:altLabel "Arid landscape",
        "Arid region",
        "Dryland" ;
    skos:definition "Arid landscapes receiving very low annual precipitation, characterised by sparse vegetation and high temperatures, making them particularly vulnerable to heat stress and water scarcity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Desert" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000143> a skos:Concept ;
    skos:altLabel "Boreal forest",
        "Temperate forest",
        "Woodland" ;
    skos:definition "Land covered predominantly by trees and associated flora, providing critical ecosystem services including carbon sequestration, biodiversity habitat, and water regulation, all threatened by climate change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Forest" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000144> a skos:Concept ;
    skos:altLabel "Freshwater ecosystems",
        "Inland water",
        "Rivers and lakes" ;
    skos:definition "Inland water bodies including rivers, lakes, and streams, whose temperature, flow, and quality are sensitive to climate variability with consequences for drinking water and aquatic health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Freshwater" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000145> a skos:Concept ;
    skos:altLabel "Meadow",
        "Prairie",
        "Savanna" ;
    skos:definition "Open landscapes dominated by grasses and low vegetation, sensitive to changes in precipitation and temperature, and at increased risk of drought and wildfire under climate change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Grassland" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000146> a skos:Concept ;
    skos:altLabel "Archipelago",
        "Island state",
        "Small island" ;
    skos:definition "Land masses surrounded by water, particularly small island developing states, which face existential threats from sea level rise, coastal erosion, and increased storm intensity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Island" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000147> a skos:Concept ;
    skos:altLabel "Alpine",
        "Highland",
        "Upland" ;
    skos:definition "Elevated terrain characterised by steep slopes and cooler temperatures, where glacier retreat, altered precipitation patterns, and biodiversity shifts are prominent climate change impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Mountain" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000148> a skos:Concept ;
    skos:altLabel "Coast",
        "Marine and coastal",
        "Shoreline" ;
    skos:definition "Areas where land meets the sea, including coastlines, estuaries, and marine environments, highly exposed to sea level rise, storm surges, and ocean warming." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Ocean/Coastal" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000149> a skos:Concept ;
    skos:altLabel "Antarctic",
        "Arctic",
        "Polar region" ;
    skos:definition "Cold, high-latitude environments at the Earth's poles, experiencing some of the fastest rates of climate warming globally, with consequences for sea ice, permafrost, and global sea levels." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Polar" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000150> a skos:Concept ;
    skos:altLabel "Amazon",
        "Jungle",
        "Tropical forest" ;
    skos:definition "Dense tropical forests characterised by high biodiversity and rainfall, playing a critical role in global carbon cycling and increasingly threatened by deforestation and drought." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Rainforest" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000151> a skos:Concept ;
    skos:altLabel "Floodplain valley",
        "Lowland valley",
        "River valley" ;
    skos:definition "Low-lying areas between hills or mountains, often fertile and densely settled, which can be highly exposed to flooding and temperature extremes under climate change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Valley" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000152> a skos:Concept ;
    skos:altLabel "Mid-latitude",
        "Temperate climate",
        "Temperate zone" ;
    skos:definition "Regions with moderate climates experiencing distinct seasons, where climate change is altering seasonal patterns, increasing extreme weather frequency, and affecting biodiversity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Temperate" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000153> a skos:Concept ;
    skos:altLabel "Equatorial",
        "Tropical zone",
        "Tropics" ;
    skos:definition "Regions near the equator characterised by warm temperatures and high humidity year-round, where climate change is intensifying heat stress, vector-borne disease risk, and extreme rainfall." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Tropical" .

<https://vocab.destiny-evidence.org/geographic-feature/DSNY000154> a skos:Concept ;
    skos:altLabel "Bog",
        "Marsh",
        "Swamp" ;
    skos:definition "Low-lying ecosystems saturated with water, including marshes, swamps, and peatlands, which serve as important carbon stores and biodiversity habitats, threatened by drainage and climate change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/geographic-feature> ;
    skos:prefLabel "Wetland" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000127> a skos:Concept ;
    skos:altLabel "Earth-wide",
        "Planetary scale",
        "Worldwide" ;
    skos:definition "The highest level of governance encompassing worldwide institutions, agreements, and processes that address climate change across all nations, such as the UNFCCC and IPCC." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Global" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000129> a skos:Concept ;
    skos:altLabel "Cross-national",
        "Multi-country",
        "Plurilateral" ;
    skos:broader <https://vocab.destiny-evidence.org/governance-scale/DSNY000128> ;
    skos:definition "Governance arrangements and interventions involving a defined group of countries, such as trade blocs or regional climate coalitions, that operate across national boundaries." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Several countries" ;
    skos:scopeNote "Refers to a defined group of countries acting together, such as a bilateral partnership or plurilateral coalition, without necessarily sharing a geographic region or formal institutional structure. Distinct from 'Multi-country regional', which refers to geographically or institutionally defined regional blocs." .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000130> a skos:Concept ;
    skos:altLabel "Regional bloc",
        "Supranational region",
        "World region" ;
    skos:broader <https://vocab.destiny-evidence.org/governance-scale/DSNY000128> ;
    skos:definition "Governance operating at a regional geographic scale spanning multiple countries, such as European Union climate policy or regional development bank initiatives." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Multi-country regional" ;
    skos:scopeNote "Refers to governance within a formally defined geographic or institutional regional bloc spanning multiple countries, such as the European Union or the African Union. Distinct from 'Several countries', which refers to looser multi-country groupings without a formal regional structure." .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000131> a skos:Concept ;
    skos:altLabel "Country-level",
        "Federal",
        "State-level governance" ;
    skos:definition "Governance and policy implemented at the level of a single sovereign nation, including national legislation, climate plans, and government-led adaptation strategies." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "National" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000133> a skos:Concept ;
    skos:altLabel "Administrative region",
        "Devolved region",
        "Province" ;
    skos:broader <https://vocab.destiny-evidence.org/governance-scale/DSNY000132> ;
    skos:definition "Governance at the level of regions or provinces within a single country, such as states, counties, or devolved administrations with responsibility for climate-related policy." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Subnational region" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000134> a skos:Concept ;
    skos:altLabel "City-level",
        "Local government",
        "Municipal" ;
    skos:broader <https://vocab.destiny-evidence.org/governance-scale/DSNY000132> ;
    skos:definition "Governance at the local or municipal level, including city councils and district authorities, which play a frontline role in climate adaptation and urban resilience planning." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Local/municipal" .

<https://vocab.destiny-evidence.org/governance-scale/DSNY000135> a skos:Concept ;
    skos:altLabel "Community level",
        "Domestic level",
        "Individual level" ;
    skos:definition "The smallest unit of governance scale, referring to decisions and actions taken by individual people or households to manage climate risk and reduce emissions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/governance-scale> ;
    skos:prefLabel "Household and individual" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000088> a skos:Concept ;
    skos:altLabel "Climate accords",
        "International agreements",
        "Treaties" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087> ;
    skos:definition "Formal binding or non-binding agreements between nations or organisations to coordinate action on climate change, including treaties, protocols, and multilateral accords." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Agreements" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000089> a skos:Concept ;
    skos:altLabel "Carbon pricing",
        "Economic incentives",
        "Financial instruments" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087> ;
    skos:definition "Market-based and fiscal mechanisms such as carbon taxes, emissions trading schemes, and subsidies used to incentivise emissions reductions or climate adaptation investments." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Economic instruments" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000090> a skos:Concept ;
    skos:altLabel "Climate governance",
        "Climate targets",
        "Strategic planning" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087> ;
    skos:definition "Institutional frameworks, strategies, and targets that guide governments and organisations in planning and implementing climate action, including national determined contributions and climate plans." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Governance, strategies and targets" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000091> a skos:Concept ;
    skos:altLabel "Climate communication",
        "Climate education",
        "Public awareness" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087> ;
    skos:definition "Interventions that use information dissemination, education, and capacity building to increase awareness of climate risks and promote behaviour change at individual or community level." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Information, education and training" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000092> a skos:Concept ;
    skos:altLabel "Climate regulation",
        "Legal instruments",
        "Standards" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087> ;
    skos:definition "Legally binding rules, standards, and enforcement mechanisms that mandate emissions reductions, land use changes, or other climate-related behaviours by governments, industries, or individuals." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Regulatory instruments" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000094> a skos:Concept ;
    skos:altLabel "Clean energy infrastructure",
        "Decarbonisation technology",
        "Low-carbon technology" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000093> ;
    skos:definition "Technologies and infrastructure designed to reduce or eliminate greenhouse gas emissions, including renewable energy systems, energy efficiency improvements, and carbon capture technologies." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Mitigation technologies/infrastructure" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000095> a skos:Concept ;
    skos:altLabel "Adaptation infrastructure",
        "Adaptive technology",
        "Climate-resilient infrastructure" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000093> ;
    skos:definition "Technologies and built infrastructure designed to reduce vulnerability to climate impacts, including flood defences, heat-resilient buildings, and early warning systems." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Adaptation technologies/infractstructure" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000096> a skos:Concept ;
    skos:altLabel "Carbon-intensive technology",
        "Emission-intensive technology",
        "Polluting infrastructure" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000093> ;
    skos:definition "Technologies and infrastructure that generate significant greenhouse gas emissions, whose phase-out or retrofitting is central to climate mitigation strategies." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Emitting technologies/infrastructure" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000099> a skos:Concept ;
    skos:altLabel "Climate activism",
        "Community participation",
        "Political engagement" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098> ;
    skos:definition "Participation in collective and political processes aimed at influencing climate policy, community resilience planning, or social responses to climate hazards." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Civic engagement" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000100> a skos:Concept ;
    skos:altLabel "Consumer behaviour",
        "Consumption patterns",
        "Purchasing choices" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098> ;
    skos:definition "Adaptive changes in purchasing and consumption patterns in response to climate risks, including reducing use of climate-sensitive goods or shifting to more resilient alternatives." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Consumption" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000101> a skos:Concept ;
    skos:altLabel "Emotional adaptation",
        "Mental coping strategies",
        "Psychological resilience" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098> ;
    skos:definition "Psychological strategies and mental health practices that individuals use to manage stress, anxiety, and trauma associated with climate change and climate-related disasters." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Psychological coping" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000102> a skos:Concept ;
    skos:altLabel "Domestic preparedness",
        "Home protection",
        "Household adaptation" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098> ;
    skos:definition "Actions taken at the household level to reduce exposure to climate hazards, such as installing insulation, flood barriers, air conditioning, or emergency preparedness measures." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Household protection" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000103> a skos:Concept ;
    skos:altLabel "Capacity building",
        "Knowledge building",
        "Skill acquisition" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098> ;
    skos:definition "Acquiring knowledge and skills that enable individuals and communities to understand and respond effectively to climate risks and adapt their livelihoods accordingly." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Learning" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000104> a skos:Concept ;
    skos:altLabel "In-place adaptation",
        "Local adaptation",
        "Staying in place" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098> ;
    skos:definition "Changes to daily routines, work patterns, or living arrangements made within a person's current location to adapt to changing climate conditions without relocating." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Lifestyle change in place" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000105> a skos:Concept ;
    skos:altLabel "Climate migration",
        "Displacement",
        "Relocation" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098> ;
    skos:definition "Movement of individuals or communities away from areas made uninhabitable or highly hazardous by climate change, including both voluntary relocation and forced displacement." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Migration" ;
    skos:scopeNote "Refers to migration as a deliberate adaptive behaviour in response to climate hazards — the act of relocating as a coping or protective strategy. Distinct from 'Migrants' in the Population scheme, which classifies people who have migrated as a potentially vulnerable population group." .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000106> a skos:Concept ;
    skos:altLabel "Individual protection",
        "Personal protection",
        "Self-care adaptation" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098> ;
    skos:definition "Individual actions taken to protect personal health from climate hazards, such as using sunscreen, staying hydrated during heat events, or wearing respiratory protection during wildfires." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Self-protection" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000108> a skos:Concept ;
    skos:altLabel "Mobility behaviour",
        "Transport behaviour",
        "Travel choices" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107> ;
    skos:definition "Behavioural changes in how individuals travel and commute, such as switching to public transport, cycling, or electric vehicles, to reduce transport-related emissions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Behavior in the transportation domain" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000109> a skos:Concept ;
    skos:altLabel "Home energy behaviour",
        "Housing consumption behaviour",
        "Residential energy use" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107> ;
    skos:definition "Household-level actions to reduce energy consumption and emissions in residential settings, including reducing heating and cooling use, improving insulation, and adopting renewable energy." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Behavior in the housing domain" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000110> a skos:Concept ;
    skos:altLabel "Dietary behaviour",
        "Food choices",
        "Food consumption behaviour" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107> ;
    skos:definition "Changes in dietary patterns and food purchasing to reduce the carbon footprint of food consumption, such as reducing meat intake or choosing locally produced food." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Behavior in the food domain" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000111> a skos:Concept ;
    skos:altLabel "Goods purchasing behaviour",
        "Material consumption",
        "Product consumption behaviour" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107> ;
    skos:definition "Reductions or shifts in the purchase and use of physical goods to lower associated greenhouse gas emissions, including buying less, repairing, or choosing low-carbon products." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Behavior in the goods domain" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000112> a skos:Concept ;
    skos:altLabel "Digital consumption",
        "Service consumption behaviour",
        "Service sector behaviour" ;
    skos:broader <https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107> ;
    skos:definition "Changes in the consumption of services — including digital, financial, and leisure services — to reduce associated indirect greenhouse gas emissions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Behavior in the services domain" .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000113> a skos:Concept ;
    skos:altLabel "Ecosystem-based adaptation",
        "Green infrastructure",
        "Nature-based solutions" ;
    skos:definition "Interventions that use the sustainable management, restoration, or conservation of ecosystems to address climate change, reduce hazard risks, and deliver co-benefits for biodiversity and human health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Ecosystem-based" ;
    skos:scopeNote "Ecosystem-based interventions are expected to be expanded with narrower concepts in a future revision. Currently used as a top-level tag for nature-based solutions and green infrastructure approaches." .

<https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000114> a skos:Concept ;
    skos:altLabel "Institutional response",
        "Organisational measures",
        "System-level response" ;
    skos:definition "Actions taken by formal organisations and institutions — including governments, health systems, and international bodies — to build climate resilience and coordinate adaptation or mitigation efforts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/interventions-measures-responses> ;
    skos:prefLabel "Institutional" ;
    skos:scopeNote "Institutional interventions are expected to be expanded with narrower concepts in a future revision. Currently used as a top-level tag for formal organisational and system-level climate responses." .

<https://vocab.destiny-evidence.org/methods/DSNY000169> a skos:Concept ;
    skos:altLabel "Prospective registration",
        "Protocol",
        "Trial registration" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000168> ;
    skos:definition "A registered or published research protocol or trials registry record describing a study that is planned or underway but has not yet reported results." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Planned research (trials registry record, protocol)" .

<https://vocab.destiny-evidence.org/methods/DSNY000170> a skos:Concept ;
    skos:altLabel "Non-peer-reviewed manuscript",
        "Preprint",
        "Working paper" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000168> ;
    skos:definition "A research manuscript that has been made publicly available prior to formal peer review and journal publication, such as those posted on medRxiv or SSRN." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Preprint article / working paper" .

<https://vocab.destiny-evidence.org/methods/DSNY000171> a skos:Concept ;
    skos:altLabel "Journal publication",
        "Peer-reviewed article",
        "Published article" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000168> ;
    skos:definition "A peer-reviewed research output published in an academic journal, including full research articles, letters to the editor, commentaries, and opinion pieces." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Journal article (full publication, letter, comment, opinion)" .

<https://vocab.destiny-evidence.org/methods/DSNY000174> a skos:Concept ;
    skos:altLabel "Non-experimental quantitative",
        "Observational study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000173> ;
    skos:definition "A quantitative study in which researchers observe and measure exposures and outcomes without intervening, including cohort, case-control, and cross-sectional designs." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Quantitative: Observational" .

<https://vocab.destiny-evidence.org/methods/DSNY000175> a skos:Concept ;
    skos:altLabel "Experimental study",
        "Interventional study",
        "Trial" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000173> ;
    skos:definition "A quantitative study in which researchers actively assign an intervention or exposure to participants, including randomised and non-randomised controlled trials." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Quantitative: Experimental" .

<https://vocab.destiny-evidence.org/methods/DSNY000176> a skos:Concept ;
    skos:altLabel "Computational modelling",
        "Mathematical modelling",
        "Simulation study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000173> ;
    skos:definition "A study that uses mathematical, statistical, or computational models to simulate processes, estimate outcomes, or project future scenarios, rather than directly observing or experimentally manipulating study subjects." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Modelling/simulation" ;
    skos:scopeNote "Modelling studies may draw on quantitative or qualitative inputs and are distinct from empirical observational or experimental paradigms." .

<https://vocab.destiny-evidence.org/methods/DSNY000177> a skos:Concept ;
    skos:altLabel "Interpretive research",
        "Qualitative research" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000173> ;
    skos:definition "A study that uses non-numerical methods such as interviews, focus groups, or ethnography to explore experiences, perceptions, and social processes relevant to climate and health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Qualitative" .

<https://vocab.destiny-evidence.org/methods/DSNY000179> a skos:Concept ;
    skos:altLabel "Diagnostic accuracy",
        "Prediction model",
        "Prognostic study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000178> ;
    skos:definition "Studies aimed at developing or validating tools to identify the presence of a condition, predict future outcomes, or estimate individual risk." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Diagnostic/Prognostic/Prediction" .

<https://vocab.destiny-evidence.org/methods/DSNY000180> a skos:Concept ;
    skos:altLabel "HSR",
        "Health systems research",
        "Service delivery research" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000178> ;
    skos:definition "Research examining the organisation, delivery, financing, and outcomes of health services, including how health systems respond to climate-related health burdens." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Health Services Research" .

<https://vocab.destiny-evidence.org/methods/DSNY000181> a skos:Concept ;
    skos:altLabel "Epidemiological research",
        "Population health research" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000178> ;
    skos:definition "Research examining the distribution, determinants, and frequency of health conditions in populations, including the epidemiological consequences of climate change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Epidemiology" .

<https://vocab.destiny-evidence.org/methods/DSNY000182> a skos:Concept ;
    skos:altLabel "Preventive research",
        "Primary prevention",
        "Public health intervention" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000178> ;
    skos:definition "Research focused on reducing the incidence of disease or injury through protective interventions, including climate-related public health measures." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Prevention" .

<https://vocab.destiny-evidence.org/methods/DSNY000183> a skos:Concept ;
    skos:altLabel "Clinical effectiveness",
        "Intervention effectiveness",
        "Therapeutic research" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000178> ;
    skos:definition "Research evaluating the effectiveness of clinical treatments, management strategies, or interventions in reducing morbidity or mortality, including those relevant to climate-sensitive diseases." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Treatment and Management / Effectiveness" .

<https://vocab.destiny-evidence.org/methods/DSNY000185> a skos:Concept ;
    skos:altLabel "Causal attribution",
        "Climate attribution",
        "Event attribution" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000184> ;
    skos:definition "Research that establishes the causal contribution of climate change to a specific observed health outcome or extreme weather event, using formal attribution methods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Attribution" ;
    skos:scopeNote "Refers to attribution as a study aim within primary research — studies that use formal methods to establish the causal contribution of climate change to a specific health outcome or event. Distinct from 'Attribution' in the Topic scheme, which classifies attribution as a high-level thematic area of climate research." .

<https://vocab.destiny-evidence.org/methods/DSNY000186> a skos:Concept ;
    skos:altLabel "Causal pathway",
        "Mechanistic research",
        "Transmission pathway" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000178> ;
    skos:definition "Research investigating the biological, physical, or social pathways through which climate factors cause or modify health outcomes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Mechanism / Transmission" .

<https://vocab.destiny-evidence.org/methods/DSNY000188> a skos:Concept ;
    skos:altLabel "Case study",
        "Single case report" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000187> ;
    skos:definition "A detailed description of the clinical presentation, diagnosis, treatment, and outcome of a single individual, used to document unusual or novel findings." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Case Report" .

<https://vocab.destiny-evidence.org/methods/DSNY000189> a skos:Concept ;
    skos:altLabel "Cross-sectional survey",
        "Prevalence study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000187> ;
    skos:definition "A study design in which data on exposure and outcome are collected at a single point in time from a defined population, providing a snapshot of prevalence and associations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Cross-Sectional" .

<https://vocab.destiny-evidence.org/methods/DSNY000190> a skos:Concept ;
    skos:altLabel "Analytical observational",
        "Longitudinal study",
        "Observational designs" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000187> ;
    skos:definition "A family of observational study designs including case series, case-control studies, and cohort studies, which follow participants over time or compare groups with and without an outcome or exposure." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Case Series/Case Control/Cohort" .

<https://vocab.destiny-evidence.org/methods/DSNY000192> a skos:Concept ;
    skos:altLabel "RCT",
        "Random allocation",
        "Randomised controlled trial" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000191> ;
    skos:definition "A controlled trial in which participants are randomly allocated to intervention or control groups, providing the strongest protection against selection bias." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Randomised" .

<https://vocab.destiny-evidence.org/methods/DSNY000193> a skos:Concept ;
    skos:altLabel "Pseudo-randomised",
        "Quasi-experimental" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000191> ;
    skos:definition "A controlled trial using a non-random but systematic method of allocation (e.g. alternation or date of birth), approximating but not achieving full randomisation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Quasi-randomised" .

<https://vocab.destiny-evidence.org/methods/DSNY000194> a skos:Concept ;
    skos:altLabel "NRCT",
        "Non-randomised controlled trial" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000191> ;
    skos:definition "A controlled trial in which allocation to intervention or control is determined by the investigator or participant without randomisation, introducing a higher risk of selection bias." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Non-randomised" .

<https://vocab.destiny-evidence.org/methods/DSNY000196> a skos:Concept ;
    skos:altLabel "Interrupted time series",
        "Time-series analysis" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000187> ;
    skos:definition "A study design that analyses data collected at multiple time points to identify trends, seasonal patterns, or the effect of an intervention or exposure over time." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Time Series" .

<https://vocab.destiny-evidence.org/methods/DSNY000197> a skos:Concept ;
    skos:altLabel "Before-after study",
        "Counterfactual design",
        "Pre-post study" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000187> ;
    skos:definition "Study designs that assess change over time by comparing outcomes before and after an intervention or event, including single-arm studies, controlled before-after designs, and counterfactual analyses." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Single Arm/Controlled Before After/Counterfactual" .

<https://vocab.destiny-evidence.org/methods/DSNY000200> a skos:Concept ;
    skos:altLabel "Meta-review",
        "Overview of reviews",
        "Review of reviews" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000199> ;
    skos:definition "A synthesis that systematically compiles and summarises findings from multiple systematic reviews on a related topic, providing a high-level overview of the evidence base." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Umbrella review / Overview of reviews" .

<https://vocab.destiny-evidence.org/methods/DSNY000202> a skos:Concept ;
    skos:altLabel "Comprehensive systematic review",
        "Full SR" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic review conducted with comprehensive search strategies and full methodological rigour, without time or resource constraints that would limit its scope." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Full systematic review" .

<https://vocab.destiny-evidence.org/methods/DSNY000203> a skos:Concept ;
    skos:altLabel "Accelerated review",
        "Fast-track review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic review conducted within a shortened timeframe using streamlined methods, trading some comprehensiveness for speed to meet urgent policy or practice needs." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Rapid review" .

<https://vocab.destiny-evidence.org/methods/DSNY000204> a skos:Concept ;
    skos:altLabel "Evidence map",
        "Scoping study",
        "Systematic map" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic review that maps the extent, range, and nature of evidence on a broad topic without synthesising findings, used to identify gaps and inform future research priorities." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Scoping review" .

<https://vocab.destiny-evidence.org/methods/DSNY000205> a skos:Concept ;
    skos:altLabel "Evidence gap map",
        "Gap map" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000201> ;
    skos:definition "A systematic mapping exercise that visually represents the distribution of evidence across a framework of interventions and outcomes, highlighting areas where evidence is absent or weak." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Evidence gap map" .

<https://vocab.destiny-evidence.org/methods/DSNY000206> a skos:Concept ;
    skos:altLabel "Literature review",
        "Non-systematic review",
        "Traditional review" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000199> ;
    skos:definition "A non-systematic review that summarises and interprets the literature on a topic based on the author's expertise and judgement, without exhaustive or reproducible search methods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Narrative review" .

<https://vocab.destiny-evidence.org/methods/DSNY000207> a skos:Concept ;
    skos:altLabel "Clinical guideline",
        "Evidence-based guideline",
        "Public health guideline" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000199> ;
    skos:definition "A systematically developed statement providing recommendations to guide clinical or public health practice, typically based on a synthesis of the available evidence." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Guideline (Public health or health guideline)" .

<https://vocab.destiny-evidence.org/methods/DSNY000208> a skos:Concept ;
    skos:altLabel "HTA",
        "Health technology assessment" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000199> ;
    skos:definition "A comprehensive policy-relevant evaluation of a health technology that typically includes clinical effectiveness, cost-effectiveness, and broader social and ethical considerations." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "HTA report" ;
    skos:scopeNote "A broader evaluation of a health technology (drug, device, or intervention) used for policy and decision-making. Typically includes: clinical effectiveness (often via a systematic review), cost-effectiveness (economic modelling), ethical, legal, and social implications, and organisational impact." .

<https://vocab.destiny-evidence.org/methods/DSNY000212> a skos:Concept ;
    skos:altLabel "Modelled evidence",
        "Simulation-based evidence" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000211> ;
    skos:definition "Evidence derived from mathematical, statistical, or computational models rather than direct empirical observation or experimentation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Modelled" .

<https://vocab.destiny-evidence.org/methods/DSNY000213> a skos:Concept ;
    skos:altLabel "Non-experimental quantitative evidence",
        "Observational evidence" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000211> ;
    skos:definition "Evidence drawn from quantitative studies in which researchers observe and measure without intervening, such as cohort, case-control, or cross-sectional studies." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Quantitative: Observational" .

<https://vocab.destiny-evidence.org/methods/DSNY000214> a skos:Concept ;
    skos:altLabel "Experimental evidence",
        "RCT evidence",
        "Trial evidence" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000211> ;
    skos:definition "Evidence drawn from quantitative studies in which an intervention or exposure is actively assigned by researchers, including randomised and non-randomised trials." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Quantitative: Experimental" .

<https://vocab.destiny-evidence.org/methods/DSNY000215> a skos:Concept ;
    skos:altLabel "Combined trial and observational",
        "Mixed quantitative evidence" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000211> ;
    skos:definition "Evidence syntheses that include both experimental and observational quantitative primary studies within the same review." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Quantitative: Experimental and Observational" .

<https://vocab.destiny-evidence.org/methods/DSNY000216> a skos:Concept ;
    skos:altLabel "Interpretive evidence",
        "Qualitative evidence" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000211> ;
    skos:definition "Evidence drawn from qualitative primary studies using non-numerical methods such as interviews, focus groups, or ethnography." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Qualitative" .

<https://vocab.destiny-evidence.org/methods/DSNY000217> a skos:Concept ;
    skos:altLabel "Convergent evidence",
        "Mixed methods evidence" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000211> ;
    skos:definition "Evidence syntheses that include both quantitative and qualitative primary studies, integrating numerical and interpretive findings." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Mixed-methods (quantitative and qualitative)" .

<https://vocab.destiny-evidence.org/methods/DSNY000218> a skos:Concept ;
    skos:altLabel "Mixed methods research",
        "Multi-method study",
        "Quantitative and qualitative" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000173> ;
    skos:definition "A primary study that intentionally combines quantitative and qualitative methods within a single research design, integrating numerical and interpretive data to address a research question more comprehensively than either approach alone." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:prefLabel "Mixed-methods" .

<https://vocab.destiny-evidence.org/population/DSNY000023> a skos:Concept ;
    skos:altLabel "Occupational vulnerability",
        "Work-related vulnerability" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability arising from the nature of a person's employment, particularly occupations with high outdoor exposure or reliance on climate-sensitive industries such as agriculture or fishing." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Occupation-based" .

<https://vocab.destiny-evidence.org/population/DSNY000024> a skos:Concept ;
    skos:altLabel "Economically disadvantaged",
        "Low socioeconomic status",
        "Poverty" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability associated with limited financial resources, reducing capacity to access protective measures, healthcare, or to recover from climate-related impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Low-income" .

<https://vocab.destiny-evidence.org/population/DSNY000025> a skos:Concept ;
    skos:altLabel "Disability",
        "Impairment",
        "People with disabilities" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability experienced by individuals with physical, sensory, cognitive, or mental health impairments that may limit their ability to respond to or recover from climate-related hazards." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Disabled" .

<https://vocab.destiny-evidence.org/population/DSNY000026> a skos:Concept ;
    skos:altLabel "Chronic disease",
        "Comorbidities",
        "Long-term health conditions" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability associated with long-term health conditions such as cardiovascular disease, diabetes, or respiratory illness, which may be exacerbated by climate-related exposures." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Chronic conditions" .

<https://vocab.destiny-evidence.org/population/DSNY000027> a skos:Concept ;
    skos:altLabel "Displaced persons",
        "Migrant populations",
        "Refugees" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability experienced by people who have moved from their place of origin, including refugees and displaced persons, who may face additional barriers to climate adaptation and healthcare access." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Migrants" ;
    skos:scopeNote "Refers to people who have migrated as a potentially vulnerable population group, facing additional barriers to climate adaptation and healthcare access. Distinct from 'Migration' in the Interventions scheme, which refers to the act of relocating as a deliberate adaptive behaviour in response to climate hazards." .

<https://vocab.destiny-evidence.org/population/DSNY000028> a skos:Concept ;
    skos:altLabel "First Nations",
        "Indigenous communities",
        "Native peoples" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability experienced by communities with distinct cultural identities and historical ties to specific territories, who often rely directly on natural ecosystems and face disproportionate climate impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Indigenous peoples" .

<https://vocab.destiny-evidence.org/population/DSNY000029> a skos:Concept ;
    skos:altLabel "Minority ethnic groups",
        "Racial minorities" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability experienced by racial or ethnic minority groups, who may face compounded climate risks due to structural inequalities in healthcare access, housing, and socioeconomic status." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Ethnic minorities" .

<https://vocab.destiny-evidence.org/population/DSNY000030> a skos:Concept ;
    skos:altLabel "Pregnancy",
        "Pregnant women" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability during pregnancy, when physiological changes may increase sensitivity to climate-related exposures such as heat stress, air pollution, and infectious disease." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Pregnant people" .

<https://vocab.destiny-evidence.org/population/DSNY000031> a skos:Concept ;
    skos:altLabel "Ageing population",
        "Elderly",
        "Vulnerable older people" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability among older adults due to age-related physiological changes, higher prevalence of chronic conditions, and reduced thermoregulatory capacity, increasing susceptibility to climate hazards." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Older adults (vulnerability)" ;
    skos:scopeNote "Refers to older adults as a vulnerable population group in the context of climate and health research. Distinct from the Age scheme concepts which classify life stages; this concept captures the vulnerability dimension of ageing." .

<https://vocab.destiny-evidence.org/population/DSNY000032> a skos:Concept ;
    skos:altLabel "Pediatric populations",
        "Vulnerable children",
        "Young children" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000022> ;
    skos:definition "Vulnerability among individuals from birth through early adolescence, whose developing physiology and dependence on caregivers increases susceptibility to climate-related health impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Infants and children (vulnerability)" ;
    skos:scopeNote "Refers to infants and children as a vulnerable population group in the context of climate and health research. Distinct from the Age scheme concepts which classify life stages; this concept captures the vulnerability dimension of young age." .

<https://vocab.destiny-evidence.org/population/DSNY000034> a skos:Concept ;
    skos:altLabel "All sexes",
        "Gender-inclusive" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000033> ;
    skos:definition "Studies or interventions that include all gender identities without restriction, capturing the full spectrum of gender diversity in a population." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "All Genders" .

<https://vocab.destiny-evidence.org/population/DSNY000035> a skos:Concept ;
    skos:altLabel "Boys",
        "Men" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000033> ;
    skos:definition "Population category encompassing individuals who identify as male or are assigned male at birth, used to examine sex- and gender-specific climate health outcomes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Male" .

<https://vocab.destiny-evidence.org/population/DSNY000036> a skos:Concept ;
    skos:altLabel "Girls",
        "Women" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000033> ;
    skos:definition "Population category encompassing individuals who identify as female or are assigned female at birth, used to examine sex- and gender-specific climate health outcomes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Female" .

<https://vocab.destiny-evidence.org/population/DSNY000037> a skos:Concept ;
    skos:altLabel "Gender diverse",
        "Non-binary",
        "Transgender" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000033> ;
    skos:definition "Population category encompassing individuals with gender identities outside the binary male/female classification, including non-binary, transgender, and intersex people." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Diverse" .

<https://vocab.destiny-evidence.org/population/DSNY000039> a skos:Concept ;
    skos:altLabel "All age groups",
        "Lifespan" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000038> ;
    skos:definition "Studies or interventions that include participants across the full age spectrum without age-based exclusion criteria." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "All Ages" .

<https://vocab.destiny-evidence.org/population/DSNY000040> a skos:Concept ;
    skos:altLabel "Babies",
        "Infants",
        "Toddlers" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000038> ;
    skos:definition "Population category covering children aged 1 to 23 months, a period of rapid development and high physiological vulnerability to climate-related exposures." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Infant (1-23 months)" .

<https://vocab.destiny-evidence.org/population/DSNY000042> a skos:Concept ;
    skos:altLabel "Early childhood",
        "Pre-school age",
        "Preschool children" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000041> ;
    skos:definition "Population category covering children aged 2 to 5 years, a critical developmental period with heightened sensitivity to climate-related environmental exposures." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Child, Preschool (2 to 5 years)" .

<https://vocab.destiny-evidence.org/population/DSNY000043> a skos:Concept ;
    skos:altLabel "Primary school age",
        "School-age children" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000041> ;
    skos:definition "Population category covering school-age children aged 6 to 12 years, who may be exposed to climate hazards through outdoor activities and school environments." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Child (6 to 12 years)" .

<https://vocab.destiny-evidence.org/population/DSNY000044> a skos:Concept ;
    skos:altLabel "Teenagers",
        "Young people",
        "Youth" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000038> ;
    skos:definition "Population category covering individuals aged 13 to 18 years, a transitional life stage with distinct physiological, behavioural, and social vulnerability to climate impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Adolescent (13 to 18 years)" .

<https://vocab.destiny-evidence.org/population/DSNY000046> a skos:Concept ;
    skos:altLabel "Working-age adults",
        "Young adults" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000045> ;
    skos:definition "Population category covering young to middle adults aged 19 to 44 years, generally considered to have lower climate-related health vulnerability than older or younger groups." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Adult (19-44 years)" .

<https://vocab.destiny-evidence.org/population/DSNY000047> a skos:Concept ;
    skos:altLabel "Mid-life",
        "Middle-aged adults" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000045> ;
    skos:definition "Population category covering adults aged 45 to 64 years, a group with increasing prevalence of chronic conditions that may heighten sensitivity to climate-related health risks." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Middle Aged (45 - 64 years)" .

<https://vocab.destiny-evidence.org/population/DSNY000049> a skos:Concept ;
    skos:altLabel "Early older adults",
        "Young old" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000048> ;
    skos:definition "Population category covering adults aged 65 to 78 years, often referred to as the 'young old', who may retain greater functional capacity than the oldest old." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Aged (65-78 years)" .

<https://vocab.destiny-evidence.org/population/DSNY000050> a skos:Concept ;
    skos:altLabel "Octogenarians and older",
        "Oldest old",
        "Very elderly" ;
    skos:broader <https://vocab.destiny-evidence.org/population/DSNY000048> ;
    skos:definition "Population category covering adults aged 80 years and older, the oldest age group with the highest vulnerability to climate-related health impacts due to frailty and multimorbidity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/population> ;
    skos:prefLabel "Aged, 80 and over (80 years and older)" .

<https://vocab.destiny-evidence.org/sectors/DSNY000115> a skos:Concept ;
    skos:altLabel "Farming",
        "Food production",
        "Forestry and fisheries" ;
    skos:definition "The sector encompassing crop cultivation, livestock rearing, aquaculture, fishing, and forest management, all of which are highly sensitive to climate variability and change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Agriculture, fishing and forestry" .

<https://vocab.destiny-evidence.org/sectors/DSNY000116> a skos:Concept ;
    skos:altLabel "Construction",
        "Housing",
        "Residential sector" ;
    skos:definition "The sector covering residential and commercial buildings, housing provision, and construction, relevant to climate adaptation through heat resilience, flood protection, and energy efficiency." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Buildings and housing" .

<https://vocab.destiny-evidence.org/sectors/DSNY000117> a skos:Concept ;
    skos:altLabel "Academic institutions",
        "Learning sector",
        "Schools" ;
    skos:definition "The sector encompassing formal and informal education systems, including schools and universities, which are both affected by climate change and central to building climate literacy and adaptive capacity." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Education" .

<https://vocab.destiny-evidence.org/sectors/DSNY000118> a skos:Concept ;
    skos:altLabel "Energy sector",
        "Mining",
        "Power generation" ;
    skos:definition "The sector covering electricity generation, fuel production, and resource extraction, a central focus of climate mitigation efforts due to its dominant role in global greenhouse gas emissions." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Energy and extractives" .

<https://vocab.destiny-evidence.org/sectors/DSNY000119> a skos:Concept ;
    skos:altLabel "Banking",
        "Financial sector",
        "Investment" ;
    skos:definition "The sector encompassing banking, insurance, investment, and financial services, which plays a critical role in climate finance, risk assessment, and funding for mitigation and adaptation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Finance" .

<https://vocab.destiny-evidence.org/sectors/DSNY000120> a skos:Concept ;
    skos:altLabel "Health sector",
        "Health systems",
        "Medical services" ;
    skos:definition "The sector providing medical care, public health services, and health infrastructure, which must adapt to increasing climate-related health burdens while reducing its own carbon footprint." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Healthcare" .

<https://vocab.destiny-evidence.org/sectors/DSNY000121> a skos:Concept ;
    skos:altLabel "Safety nets",
        "Social services",
        "Welfare" ;
    skos:definition "The sector providing social safety nets, welfare services, and support systems that help vulnerable populations cope with and recover from climate-related health and livelihood impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Social protection" .

<https://vocab.destiny-evidence.org/sectors/DSNY000122> a skos:Concept ;
    skos:altLabel "Commerce",
        "Manufacturing",
        "Trade" ;
    skos:definition "The sector encompassing manufacturing, retail, wholesale trade, and commercial services, relevant to climate change through supply chain emissions, heat impacts on workers, and resource use." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Industry, trade and services" .

<https://vocab.destiny-evidence.org/sectors/DSNY000123> a skos:Concept ;
    skos:altLabel "Digital sector",
        "ICT sector",
        "Technology sector" ;
    skos:definition "The sector covering telecommunications, digital infrastructure, and information technology, relevant both as a source of emissions and as an enabler of climate monitoring, adaptation, and mitigation." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Information and communications technologies" .

<https://vocab.destiny-evidence.org/sectors/DSNY000124> a skos:Concept ;
    skos:altLabel "Civil service",
        "Government",
        "Public services" ;
    skos:definition "The sector encompassing government agencies, civil services, and public institutions responsible for policy-making, regulation, and the delivery of public services in the context of climate change." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Public administration" .

<https://vocab.destiny-evidence.org/sectors/DSNY000125> a skos:Concept ;
    skos:altLabel "Logistics",
        "Mobility",
        "Transport" ;
    skos:definition "The sector covering road, rail, air, and maritime transport systems, a major source of greenhouse gas emissions and a sector requiring significant adaptation to climate-related infrastructure risks." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Transportation" .

<https://vocab.destiny-evidence.org/sectors/DSNY000126> a skos:Concept ;
    skos:altLabel "Sanitation",
        "Waste management",
        "Water sector" ;
    skos:definition "The sector responsible for water supply, sewage treatment, and solid waste management, which is highly exposed to climate impacts including drought, flooding, and heat, and critical for public health." ;
    skos:inScheme <https://vocab.destiny-evidence.org/sectors> ;
    skos:prefLabel "Water, sanitation and waste management" .

<https://vocab.destiny-evidence.org/topic/DSNY000051> a skos:Concept ;
    skos:altLabel "Climate mitigation",
        "Emissions reduction",
        "GHG reduction" ;
    skos:definition "Actions and strategies aimed at reducing or preventing greenhouse gas emissions in order to limit the magnitude of future climate change and its associated health and environmental impacts." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Mitigation" .

<https://vocab.destiny-evidence.org/topic/DSNY000052> a skos:Concept ;
    skos:altLabel "Adaptive response",
        "Climate adaptation",
        "Climate adjustment" ;
    skos:definition "Adjustments in natural or human systems in response to actual or anticipated climate change, intended to moderate harm or exploit beneficial opportunities arising from climate variability." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Adaptation" .

<https://vocab.destiny-evidence.org/topic/DSNY000054> a skos:Concept ;
    skos:altLabel "Causal attribution",
        "Climate attribution",
        "Event attribution" ;
    skos:broader <https://vocab.destiny-evidence.org/topic/DSNY000053> ;
    skos:definition "The process of establishing the causal contribution of climate change to observed changes in physical, ecological, or human systems, including specific extreme weather events or health outcomes." ;
    skos:inScheme <https://vocab.destiny-evidence.org/topic> ;
    skos:prefLabel "Attribution" ;
    skos:scopeNote "Refers to attribution as a high-level thematic area of climate research, encompassing the field of climate and health attribution broadly. Distinct from 'Attribution' in the Methods scheme, which classifies attribution as a specific study aim within primary research." .

<https://vocab.destiny-evidence.org/methods/DSNY000167> a skos:Concept ;
    skos:altLabel "Empirical research",
        "Original research",
        "Primary study" ;
    skos:definition "Original research studies that collect and analyse data directly, as distinct from evidence syntheses that aggregate findings from existing studies." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:narrower <https://vocab.destiny-evidence.org/methods/DSNY000172> ;
    skos:prefLabel "Primary Research" .

<https://vocab.destiny-evidence.org/methods/DSNY000184> a skos:Concept ;
    skos:altLabel "Causal evaluation",
        "Impact assessment",
        "Programme evaluation" ;
    skos:broader <https://vocab.destiny-evidence.org/methods/DSNY000178> ;
    skos:definition "Research assessing the consequences of climate change or climate-related interventions on health, social, or environmental outcomes, often using causal inference methods." ;
    skos:inScheme <https://vocab.destiny-evidence.org/methods> ;
    skos:narrower <https://vocab.destiny-evidence.org/methods/DSNY000185> ;
    skos:prefLabel "Impact / Impact Evaluation" .

<https://vocab.destiny-evidence.org/topic/DSNY000053> a skos:Concept ;
    skos:altLabel "Climate consequences",
        "Climate effects",
        "Climate impact" ;
