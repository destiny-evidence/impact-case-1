    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infection and inflammation of the middle ear, commonly caused by bacterial or viral pathogens following upper respiratory infection.</skos:definition>
    <skos:scopeNote>GBD ref: 329</skos:scopeNote>
    <skos:altLabel>Ear infection</skos:altLabel>
    <skos:altLabel>Middle ear infection</skos:altLabel>
