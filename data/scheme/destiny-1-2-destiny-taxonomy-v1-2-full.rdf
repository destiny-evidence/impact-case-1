  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000463">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Congenital birth defects</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Structural or functional abnormalities present at birth, including chromosomal disorders and congenital malformations of the heart, limbs, and other organs.</skos:definition>
    <skos:scopeNote>GBD ref: 641</skos:scopeNote>
    <skos:altLabel>Birth defects</skos:altLabel>
    <skos:altLabel>Congenital anomalies</skos:altLabel>
