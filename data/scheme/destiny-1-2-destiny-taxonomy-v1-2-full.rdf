  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000111">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Behaviour related to goods/consumption/services</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Reductions or shifts in the purchase and use of physical goods and services to lower associated environmental impacts, including buying less, repairing, reusing, or choosing lower-impact products and services.</skos:definition>
    <skos:altLabel>Product consumption behaviour</skos:altLabel>
    <skos:altLabel>Material consumption</skos:altLabel>
    <skos:altLabel>Goods purchasing behaviour</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000350">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Leptospirosis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A bacterial zoonosis caused by Leptospira species, transmitted through contact with water or soil contaminated by infected animal urine, with risk elevated during flooding events.</skos:definition>
    <skos:altLabel>Weil's disease</skos:altLabel>
    <skos:altLabel>Leptospira</skos:altLabel>
    <skos:altLabel>Rat fever</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000394">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Lower extremity peripheral arterial disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Atherosclerotic obstruction of the arteries supplying the lower limbs, causing claudication, ischaemia, and risk of amputation.</skos:definition>
    <skos:scopeNote>GBD ref: 502</skos:scopeNote>
    <skos:altLabel>PAD</skos:altLabel>
    <skos:altLabel>Peripheral vascular disease</skos:altLabel>
    <skos:altLabel>PVD</skos:altLabel>
    <skos:altLabel>Peripheral arterial disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000279">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Infant / child mortality (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>Mortality rates among infants and children, typically measured as deaths per live births within specified age bands including neonatal, infant, and under-five periods.</skos:definition>
    <skos:altLabel>Child mortality</skos:altLabel>
    <skos:altLabel>Under-5 mortality</skos:altLabel>
    <skos:altLabel>Perinatal mortality</skos:altLabel>
    <skos:altLabel>Neonatal mortality rate</skos:altLabel>
    <skos:altLabel>Infant mortality rate</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000274"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000101">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Psychological coping</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Psychological strategies and mental health practices that individuals use to manage stress, anxiety, and trauma associated with climate change and climate-related disasters.</skos:definition>
    <skos:altLabel>Psychological resilience</skos:altLabel>
    <skos:altLabel>Mental coping strategies</skos:altLabel>
    <skos:altLabel>Emotional adaptation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000558">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Low-emission transport</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Infrastructure and systems enabling low-emission travel and transport, including active travel networks, electric vehicle charging infrastructure, and public transit systems.</skos:definition>
    <skos:altLabel>Active travel</skos:altLabel>
    <skos:altLabel>Electric vehicles</skos:altLabel>
    <skos:altLabel>Public transport</skos:altLabel>
    <skos:altLabel>EV infrastructure</skos:altLabel>
    <skos:altLabel>Cycling infrastructure</skos:altLabel>
    <skos:altLabel>Low-carbon mobility</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000094"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000316">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>HIV/AIDS</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infection caused by the human immunodeficiency virus (HIV), which progressively damages the immune system and, without treatment, leads to acquired immunodeficiency syndrome (AIDS).</skos:definition>
    <skos:scopeNote>GBD ref: 298</skos:scopeNote>
    <skos:altLabel>HIV</skos:altLabel>
    <skos:altLabel>AIDS</skos:altLabel>
    <skos:altLabel>Human immunodeficiency virus</skos:altLabel>
    <skos:altLabel>Acquired immunodeficiency syndrome</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000315"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000481">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Electrocution</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injury caused by passage of electrical current through the body, including low-voltage electrocution and lightning strike, causing tissue damage, cardiac arrest, and burns.</skos:definition>
    <skos:scopeNote>GBD ref: 940</skos:scopeNote>
    <skos:altLabel>Electric shock</skos:altLabel>
    <skos:altLabel>Lightning strike</skos:altLabel>
    <skos:altLabel>Electrical injury</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000472"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000369">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Low birth weight</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Birth weight below 2,500 grams, associated with increased neonatal mortality, infection susceptibility, and long-term developmental and metabolic risk.</skos:definition>
    <skos:scopeNote>REI ref: 339</skos:scopeNote>
    <skos:altLabel>LBW</skos:altLabel>
    <skos:altLabel>Small for gestational age</skos:altLabel>
    <skos:altLabel>Birth weight</skos:altLabel>
    <skos:altLabel>Foetal growth restriction</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000367"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000478">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Adverse effects of medical treatment</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Harm resulting from medical or surgical interventions, including adverse drug reactions, surgical complications, and healthcare-associated infections.</skos:definition>
    <skos:scopeNote>GBD ref: 708</skos:scopeNote>
    <skos:altLabel>Iatrogenic injury</skos:altLabel>
    <skos:altLabel>Medical error</skos:altLabel>
    <skos:altLabel>Adverse drug reaction</skos:altLabel>
    <skos:altLabel>Treatment complication</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000472"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000395">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Endocarditis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infection of the endocardium, most commonly involving the heart valves, caused by bacterial or fungal organisms and associated with significant morbidity and mortality.</skos:definition>
    <skos:scopeNote>GBD ref: 503</skos:scopeNote>
    <skos:altLabel>Infective endocarditis</skos:altLabel>
    <skos:altLabel>Heart valve infection</skos:altLabel>
    <skos:altLabel>Bacterial endocarditis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/actors/DSNY000165">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Civil society (Actor)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/actors"/>
    <skos:definition>Non-profit organisations, advocacy groups, and community-based organisations that represent public interests, support communities, and hold governments and businesses accountable.</skos:definition>
    <skos:altLabel>NGOs</skos:altLabel>
    <skos:altLabel>Non-governmental organisations</skos:altLabel>
    <skos:altLabel>Community organisations</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000262">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Air quality (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Exposure to outdoor or indoor air containing pollutants — including particulate matter, ozone, nitrogen dioxide, and wildfire smoke — at concentrations harmful to health.</skos:definition>
    <skos:scopeNote>Air quality deteriorates with climate change through many pathways. 1. Hotter temperatures result in higher levels of ground-level ozone, wildfires result in increased levels of particulate matter and other air pollutants, and plants produce more pollen and allergens as a result of higher CO2 concentrations in the atmosphere. Increased pollen concentrations in the air also result from spread of certain heat- and drought-resistant plant species due to climate change (e.g. ragweed, Ambrosia artemisiifolia). 2. In addition to releasing CO2, the burning or combustion of fossil fuels releases particulate air pollutants. 3. Household (indoor) air pollution (from combustion of fossil fuels used for cooking and heating) is a major contributor to ambient (outdoor) air pollution. Biomass burning (in agricultural production) also causes air pollution. 4. Include indoor air-pollution only if related to fossil fuel combustion. 5. Radon is considered an air quality related exposure which can occur indoor and outdoor (it is related to open mines and can be exacerbated by heat). 6. There is an increase in sand and dust storms due to climate change, which contributes to air pollution. 

Examples of health impacts of this exposure: Exacerbations of asthma and other respiratory diseases (COPD); respiratory allergies; cardiovascular diseases; bacterial meningitis and invasive bacterial disease (linked to airborne dust).



</skos:scopeNote>
    <skos:altLabel>Air pollution</skos:altLabel>
    <skos:altLabel>Ambient air quality</skos:altLabel>
    <skos:altLabel>Indoor air quality</skos:altLabel>
    <skos:altLabel>Particulate matter exposure</skos:altLabel>
    <skos:altLabel>PM2.5 exposure</skos:altLabel>
    <skos:altLabel>PM10 exposure</skos:altLabel>
    <skos:altLabel>Air pollutants</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000267">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000268"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000269"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000270"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000271"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000272"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Social factors (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Social, economic, and structural conditions that mediate vulnerability to environmental hazards and shape health outcomes at individual and population level.</skos:definition>
    <skos:scopeNote>Adverse effects of climate change — including effects on availability of water and food, extreme weather, and coastal flooding — are causing forced displacement of populations within their own countries (internally displaced persons) or across national borders (climate refugees) and leading to conflict and violence.</skos:scopeNote>
    <skos:altLabel>Social determinants</skos:altLabel>
    <skos:altLabel>Socioeconomic factors</skos:altLabel>
    <skos:altLabel>Structural factors</skos:altLabel>
    <skos:altLabel>Social conditions</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000233">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Chronic conditions (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Individuals living with one or more long-term physical health conditions that reduce physiological resilience and increase susceptibility to adverse health outcomes.</skos:definition>
    <skos:altLabel>Chronic disease</skos:altLabel>
    <skos:altLabel>Long-term conditions</skos:altLabel>
    <skos:altLabel>Chronic illness</skos:altLabel>
    <skos:altLabel>Comorbidities</skos:altLabel>
    <skos:altLabel>Multimorbidity</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000241">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Occupation-based (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Individuals whose occupation exposes them to elevated health hazards, including outdoor workers in agriculture, construction, and other sectors with high physical exposure to environmental conditions.</skos:definition>
    <skos:altLabel>Occupational vulnerability</skos:altLabel>
    <skos:altLabel>Workers</skos:altLabel>
    <skos:altLabel>Outdoor workers</skos:altLabel>
    <skos:altLabel>Agricultural workers</skos:altLabel>
    <skos:altLabel>Construction workers</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000198">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>C.2 Evidence synthesis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Research that systematically or narratively aggregates and synthesises findings from multiple primary studies to draw broader conclusions about a topic.</skos:definition>
    <skos:altLabel>Review</skos:altLabel>
    <skos:altLabel>Secondary research</skos:altLabel>
    <skos:altLabel>Research synthesis</skos:altLabel>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000207"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000208"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000206"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000201"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000200"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000555"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/fossil-fuels/DSNY000619">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>(Unspecified) fossil fuels</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/fossil-fuels"/>
    <skos:definition>Fossil fuel use or combustion where the specific fuel type is not identified, used when studies refer to fossil fuels in general without distinguishing between coal, oil, or gas.</skos:definition>
    <skos:altLabel>Unspecified fossil fuels</skos:altLabel>
    <skos:altLabel>General fossil fuels</skos:altLabel>
    <skos:altLabel>Carbon fuels</skos:altLabel>
    <skos:altLabel>solid fuels</skos:altLabel>
    <skos:altLabel>fossil energy sources</skos:altLabel>
    <skos:altLabel>carbon-based fuels</skos:altLabel>
    <skos:altLabel>conventional fuels</skos:altLabel>
    <skos:altLabel>mineral fuels</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000447">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Bacterial skin diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Bacterial infections of the skin and soft tissue, including cellulitis, impetigo, and erysipelas, caused predominantly by Staphylococcus aureus and Streptococcus pyogenes.</skos:definition>
    <skos:scopeNote>GBD ref: 980</skos:scopeNote>
    <skos:altLabel>Cellulitis</skos:altLabel>
    <skos:altLabel>Impetigo</skos:altLabel>
    <skos:altLabel>Skin infection</skos:altLabel>
    <skos:altLabel>Erysipelas</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000140">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Urban</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Densely populated areas characterised by built infrastructure and high human activity, where urban heat island effects and air pollution amplify climate-related health risks.</skos:definition>
    <skos:altLabel>City</skos:altLabel>
    <skos:altLabel>Metropolitan area</skos:altLabel>
    <skos:altLabel>Built-up area</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000153">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Tropical</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Regions near the equator characterised by warm temperatures and high humidity year-round, where climate change is intensifying heat stress, vector-borne disease risk, and extreme rainfall.</skos:definition>
    <skos:altLabel>Tropical zone</skos:altLabel>
    <skos:altLabel>Tropics</skos:altLabel>
    <skos:altLabel>Equatorial</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000409">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Inguinal, femoral, and abdominal hernia</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Protrusion of abdominal contents through a weakness in the abdominal wall, including inguinal, femoral, and other hernias requiring surgical repair.</skos:definition>
    <skos:scopeNote>GBD ref: 531</skos:scopeNote>
    <skos:altLabel>Hernia</skos:altLabel>
    <skos:altLabel>Abdominal hernia</skos:altLabel>
    <skos:altLabel>Inguinal hernia</skos:altLabel>
    <skos:altLabel>Femoral hernia</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000552">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Qualitative evidence synthesis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A systematic review that searches for, appraises, and synthesises findings from qualitative primary studies, using methods such as meta-ethnography, thematic synthesis, or framework synthesis.</skos:definition>
    <skos:altLabel>QES</skos:altLabel>
    <skos:altLabel>Qualitative synthesis</skos:altLabel>
    <skos:altLabel>Meta-ethnography</skos:altLabel>
    <skos:altLabel>Thematic synthesis</skos:altLabel>
    <skos:altLabel>Narrative synthesis of qualitative evidence</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000201"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000266">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Vector distribution and ecology (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Changes in the geographic range, abundance, and seasonal activity of vectors — such as mosquitoes, ticks and mites — that alter the transmission risk of vector-borne diseases.</skos:definition>
    <skos:scopeNote>Climate change is altering the geographic distributions and life cycles of insect vectors, such as mosquitoes, ticks and mites, which may increase the risk, incidence, or geographic range of some vector-borne diseases and the emergence of new diseases (e.g. climate-sensitive zoonotic diseases). Animal disease vectors also comprise other taxonomic groups than insects, e.g. ticks (mites, arachnids), other arthropods, and also mammals (e.g. bats, rats and mice). These changes have important implications for several diseases such as Chikungunya (vector: mosquitoes), dengue (vector: mosquitoes), encephalitis (e.g. tick-borne encephalitis, Japanese encephalitis, Murray Valley encephalitis, or West Nile encephalitis.), Hantavirus infection (vector: rodents), Lyme disease (vector: ticks), malaria (vector: mosquitoes), Rift Valley fever (vector: mosquitoes), West Nile virus infection (vector: mosquitoes), Zika virus infection (vector: mosquitoes), Ross River fever (vector: mosquitoes), Crimean-Congo haemorrhagic fever (vector: ticks), Leishmaniasis (vector: sandflies), Oropouche virus disease/fever (vector: midges, especially Culicoides paraensis). 


</skos:scopeNote>
    <skos:altLabel>Vector-borne disease risk</skos:altLabel>
    <skos:altLabel>Mosquito distribution</skos:altLabel>
    <skos:altLabel>Tick distribution</skos:altLabel>
    <skos:altLabel>Vector ecology</skos:altLabel>
    <skos:altLabel>Disease vector range</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000525">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Controlled before-after (CBA)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A study comparing pre- and post-intervention outcomes in both an intervention group and a non-randomised control group, improving on uncontrolled before-after designs by accounting for secular trends.</skos:definition>
    <skos:altLabel>CBA</skos:altLabel>
    <skos:altLabel>Controlled pre-post study</skos:altLabel>
    <skos:altLabel>Non-randomised controlled before-after</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000522"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000623">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Climate variability</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>Climate variability refers to fluctuations in climate conditions (temperature, precipitation, wind patterns, etc.) over months, years, or decades around a longer-term average. Climate variability is influenced by multiple climate drivers.</skos:definition>
    <skos:scopeNote>Refers to variations in the mean state and other climate statistics (standard deviations, the occurrence of extremes, etc.) on all temporal and spatial scales beyond those of individual weather events.</skos:scopeNote>
    <skos:altLabel>Climate variation</skos:altLabel>
    <skos:altLabel>Climatic variation</skos:altLabel>
    <skos:altLabel>Climate alteration</skos:altLabel>
    <skos:altLabel>Climate instability</skos:altLabel>
    <skos:altLabel>Cimate trends</skos:altLabel>
    <skos:altLabel>Climate shifts</skos:altLabel>
    <skos:altLabel>Climate fluctuations</skos:altLabel>
    <skos:altLabel>Climatic oscillations</skos:altLabel>
    <skos:altLabel>Climate anomalies</skos:altLabel>
    <skos:altLabel>El Niño ((Southern Oscillation/ENSO)</skos:altLabel>
    <skos:altLabel>La Niña</skos:altLabel>
    <skos:altLabel>North Atlantic Oscillation</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000097">
