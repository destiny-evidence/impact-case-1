    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000438"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000151">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Valley</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Low-lying areas between hills or mountains, often fertile and densely settled, which can be highly exposed to flooding and temperature extremes under climate change.</skos:definition>
    <skos:altLabel>River valley</skos:altLabel>
    <skos:altLabel>Lowland valley</skos:altLabel>
    <skos:altLabel>Floodplain valley</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000487">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Interpersonal violence</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Physical, sexual, or psychological harm intentionally inflicted by one person on another, including assault, domestic violence, and sexual violence.</skos:definition>
    <skos:scopeNote>GBD ref: 724</skos:scopeNote>
    <skos:altLabel>Assault</skos:altLabel>
    <skos:altLabel>Physical violence</skos:altLabel>
    <skos:altLabel>Domestic violence</skos:altLabel>
    <skos:altLabel>Intimate partner violence</skos:altLabel>
    <skos:altLabel>IPV</skos:altLabel>
    <skos:altLabel>Sexual violence</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000485"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/extreme-weather-events/DSNY000606">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Extreme cold</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/extreme-weather-events"/>
    <skos:definition>Episodes of abnormally low temperatures, including cold snaps and blizzards, associated with increased risk of hypothermia, cardiovascular events, and respiratory illness.</skos:definition>
    <skos:altLabel>Cold snaps</skos:altLabel>
    <skos:altLabel>Cold waves</skos:altLabel>
    <skos:altLabel>Freezing events</skos:altLabel>
    <skos:altLabel>Cold spells</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000297">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Total / all-cause mortality (Outcome)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths from any cause combined, used as an overall measure of fatal burden without attribution to a specific disease or condition.</skos:definition>
    <skos:altLabel>All-cause death</skos:altLabel>
    <skos:altLabel>Overall mortality</skos:altLabel>
    <skos:altLabel>Total deaths</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000296"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000382">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other malignant neoplasms</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Malignant neoplasms not classified under the specific GBD cancer sub-categories, spanning other primary tumour sites and histological types.</skos:definition>
    <skos:scopeNote>GBD ref: 489</skos:scopeNote>
    <skos:altLabel>Other cancers</skos:altLabel>
    <skos:altLabel>Other malignant tumours</skos:altLabel>
    <skos:altLabel>Other cancer types</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000378"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000364">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Maternal and neonatal disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Conditions arising during pregnancy, childbirth, or the neonatal period, including obstetric complications and disorders of the newborn.</skos:definition>
    <skos:scopeNote>GBD ref: 962</skos:scopeNote>
    <skos:altLabel>Maternal and neonatal conditions</skos:altLabel>
    <skos:altLabel>Pregnancy complications</skos:altLabel>
    <skos:altLabel>Perinatal conditions</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000314"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000365"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000367"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000299">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cardiovascular mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths attributable to diseases of the heart and circulatory system, including ischemic heart disease, stroke, and heart failure.</skos:definition>
    <skos:altLabel>Heart disease mortality</skos:altLabel>
    <skos:altLabel>CVD mortality</skos:altLabel>
    <skos:altLabel>Cardiovascular death</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000298"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/topic/DSNY000052">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Adaptation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/topic"/>
    <skos:definition>Adjustments in natural or human systems in response to actual or anticipated climate change, intended to moderate harm or exploit beneficial opportunities arising from climate variability.</skos:definition>
    <skos:altLabel>Climate adaptation</skos:altLabel>
    <skos:altLabel>Adaptive response</skos:altLabel>
    <skos:altLabel>Climate adjustment</skos:altLabel>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000490"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000611">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>(Unspecified) greenhouse gases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents"/>
    <skos:definition>Atmospheric gases that trap heat and contribute to the greenhouse effect, referred to collectively without specifying the individual gas type.</skos:definition>
    <skos:altLabel>GHGs</skos:altLabel>
    <skos:altLabel>Unspecified greenhouse gases</skos:altLabel>
    <skos:altLabel>Heat-trapping gases</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000235">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Ethnic minorities (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Population groups defined by shared ethnic, cultural, or racial identity that may face structural disadvantage, discrimination, or disproportionate exposure to environmental and social risk factors.</skos:definition>
    <skos:altLabel>Ethnic minorities</skos:altLabel>
    <skos:altLabel>Racial minorities</skos:altLabel>
    <skos:altLabel>BAME</skos:altLabel>
    <skos:altLabel>Racialised communities</skos:altLabel>
    <skos:altLabel>People of colour</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000422">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other neurological disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Neurological conditions not classified under the major GBD neurological sub-categories, including rare and unspecified disorders of the nervous system.</skos:definition>
    <skos:scopeNote>GBD ref: 557</skos:scopeNote>
    <skos:altLabel>Other brain disease</skos:altLabel>
    <skos:altLabel>Other neurological conditions</skos:altLabel>
    <skos:altLabel>Other nervous system disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000415"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000391">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Pulmonary Arterial Hypertension</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Elevated blood pressure in the pulmonary arterial circulation leading to progressive right heart failure and exercise limitation.</skos:definition>
    <skos:scopeNote>GBD ref: 1004</skos:scopeNote>
    <skos:altLabel>PAH</skos:altLabel>
    <skos:altLabel>Pulmonary hypertension</skos:altLabel>
    <skos:altLabel>Pulmonary vascular disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000115">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Agriculture / fishing / forestry (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector encompassing crop cultivation, livestock rearing, aquaculture, fishing, and forest management.</skos:definition>
    <skos:altLabel>Farming</skos:altLabel>
    <skos:altLabel>Food production</skos:altLabel>
    <skos:altLabel>Forestry and fisheries</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000325">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000326"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Diarrheal diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Illness characterised by loose or watery stools, caused by a range of enteric pathogens and strongly associated with unsafe water, poor sanitation, and food contamination.</skos:definition>
    <skos:scopeNote>GBD ref: 302</skos:scopeNote>
    <skos:altLabel>Diarrhoea</skos:altLabel>
    <skos:altLabel>Diarrheal disease</skos:altLabel>
    <skos:altLabel>Gastroenteritis</skos:altLabel>
    <skos:altLabel>Acute watery diarrhoea</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000324"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000113">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000580"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000581"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000579"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000582"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Ecosystem-based</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Interventions that use the sustainable management, conservation, or restoration of ecosystems to reduce climate-related health risks and deliver co-benefits for biodiversity and human wellbeing, including urban green-blue infrastructure, coastal and marine protection, and forest and land management.</skos:definition>
    <skos:scopeNote>Ecosystem-based interventions are expected to be expanded with narrower concepts in a future revision. Currently used as a top-level tag for nature-based solutions and green infrastructure approaches.</skos:scopeNote>
    <skos:altLabel>Nature-based solutions</skos:altLabel>
    <skos:altLabel>NbS</skos:altLabel>
    <skos:altLabel>Green infrastructure</skos:altLabel>
    <skos:altLabel>Ecosystem-based adaptation</skos:altLabel>
    <skos:altLabel>EbA</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/extreme-weather-events/DSNY000604">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>(Unspecified) extreme weather events</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/extreme-weather-events"/>
    <skos:definition>Extreme weather events where the specific type is not identified, used when studies refer to climate extremes without distinguishing between event types.</skos:definition>
    <skos:altLabel>Unspecified extreme weather</skos:altLabel>
    <skos:altLabel>General climate extremes</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000503">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Mediterranean</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>A climate zone and biome characterised by hot dry summers and mild wet winters, occurring around the Mediterranean Basin and analogous regions, with distinctive shrubland vegetation and high biodiversity.</skos:definition>
    <skos:altLabel>Mediterranean climate</skos:altLabel>
    <skos:altLabel>Mediterranean region</skos:altLabel>
    <skos:altLabel>Mediterranean biome</skos:altLabel>
    <skos:altLabel>Mediterranean-type ecosystem</skos:altLabel>
    <skos:altLabel>Maquis</skos:altLabel>
    <skos:altLabel>Garrigue</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000497">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Coral reef</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Shallow marine ecosystems built by calcium carbonate-secreting corals, supporting exceptional biodiversity and coastal protection but highly vulnerable to ocean warming and acidification.</skos:definition>
    <skos:altLabel>Reef ecosystem</skos:altLabel>
    <skos:altLabel>Coral ecosystem</skos:altLabel>
    <skos:altLabel>Tropical reef</skos:altLabel>
    <skos:altLabel>Marine reef</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000443">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Acute glomerulonephritis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Acute inflammatory disease of the glomeruli, typically immune-mediated, presenting with haematuria, proteinuria, hypertension, and impaired renal function.</skos:definition>
    <skos:scopeNote>GBD ref: 588</skos:scopeNote>
    <skos:altLabel>Glomerulonephritis</skos:altLabel>
    <skos:altLabel>Nephritic syndrome</skos:altLabel>
    <skos:altLabel>Renal inflammation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000438"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000149">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Polar</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Cold, high-latitude environments at the Earth's poles, experiencing some of the fastest rates of climate warming globally, with consequences for sea ice, permafrost, and global sea levels.</skos:definition>
    <skos:altLabel>Arctic</skos:altLabel>
    <skos:altLabel>Antarctic</skos:altLabel>
    <skos:altLabel>Polar region</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000386">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Ischemic heart disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Reduction in blood supply to the heart muscle due to atherosclerosis of the coronary arteries, presenting as angina, myocardial infarction, or sudden cardiac death.</skos:definition>
    <skos:scopeNote>GBD ref: 493</skos:scopeNote>
    <skos:altLabel>IHD</skos:altLabel>
    <skos:altLabel>Coronary heart disease</skos:altLabel>
    <skos:altLabel>Coronary artery disease</skos:altLabel>
    <skos:altLabel>Heart attack</skos:altLabel>
    <skos:altLabel>Myocardial infarction</skos:altLabel>
    <skos:altLabel>Angina</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/actors/DSNY000166">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Households / individuals (Actor)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/actors"/>
    <skos:definition>Individual people and domestic units whose everyday choices, behaviours, and circumstances make them both agents of and subjects of wider social and environmental change.</skos:definition>
    <skos:altLabel>Individuals</skos:altLabel>
    <skos:altLabel>Communities</skos:altLabel>
    <skos:altLabel>Citizens</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000591">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Social cohesion / mutual aid</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Community networks and informal support systems that enable mutual assistance during times of stress or shock, including food sharing, community care, and grassroots first response.</skos:definition>
    <skos:altLabel>Social support networks</skos:altLabel>
    <skos:altLabel>Mutual aid</skos:altLabel>
    <skos:altLabel>Community resilience</skos:altLabel>
    <skos:altLabel>Solidarity networks</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000588"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/country-income/DSNY000138">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Upper middle</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/country-income"/>
    <skos:definition>Countries classified by the World Bank in the upper-middle income tier, with growing capacity for climate adaptation and mitigation but still facing significant climate risks.</skos:definition>
    <skos:altLabel>UMIC</skos:altLabel>
    <skos:altLabel>Upper-middle income countries</skos:altLabel>
    <skos:altLabel>Emerging economies</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/extreme-weather-events/DSNY000610">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Wildfires</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/extreme-weather-events"/>
    <skos:definition>Uncontrolled fires in natural vegetation, increasingly associated with drought and heat, producing smoke and air pollution with severe respiratory and cardiovascular health impacts.</skos:definition>
    <skos:altLabel>Forest fires</skos:altLabel>
    <skos:altLabel>Bushfires</skos:altLabel>
    <skos:altLabel>Landscape fires</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age/DSNY000255">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Adult</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Individuals aged 19 years and older, encompassing young adults, middle-aged, and older adult sub-groups across the adult life course.</skos:definition>
    <skos:altLabel>Adults</skos:altLabel>
    <skos:altLabel>Working-age adults</skos:altLabel>
    <skos:altLabel>Grown-ups</skos:altLabel>
    <skos:altLabel>Adult population</skos:altLabel>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000256"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000258"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000257"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000310">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Other infectious diseases mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths from infectious diseases not classified under respiratory, enteric, or vector-borne categories, including meningitis, encephalitis, and vaccine-preventable infections.</skos:definition>
    <skos:altLabel>Other infection mortality</skos:altLabel>
    <skos:altLabel>Other infectious death</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000306"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000477">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Exposure to mechanical forces</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injuries caused by physical mechanical forces including crushing, cutting, impact, and blast, covering occupational and other unintentional mechanical trauma.</skos:definition>
    <skos:scopeNote>GBD ref: 704</skos:scopeNote>
    <skos:altLabel>Mechanical injury</skos:altLabel>
    <skos:altLabel>Crushing injury</skos:altLabel>
    <skos:altLabel>Impact injury</skos:altLabel>
    <skos:altLabel>Blast injury</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000472"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/country-income/DSNY000137">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Lower middle</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/country-income"/>
    <skos:definition>Countries classified by the World Bank in the lower-middle income tier, often experiencing rapid development while remaining highly vulnerable to climate-related health and economic impacts.</skos:definition>
    <skos:altLabel>LMIC</skos:altLabel>
    <skos:altLabel>Lower-middle income countries</skos:altLabel>
    <skos:altLabel>Developing countries</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000124">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Public administration (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector encompassing government agencies, civil services, and public institutions responsible for policy-making, regulation, and the delivery of public services in the context of climate change.</skos:definition>
    <skos:altLabel>Government</skos:altLabel>
    <skos:altLabel>Public services</skos:altLabel>
    <skos:altLabel>Civil service</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/topic/DSNY000491">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Co-Benefits</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/topic"/>
    <skos:definition>Positive health, social, or environmental benefits arising from mitigation actions that are additional to the primary goal of reducing greenhouse gas emissions, such as improved air quality or increased physical activity.</skos:definition>
    <skos:altLabel>Co-benefits of mitigation</skos:altLabel>
    <skos:altLabel>Health co-benefits</skos:altLabel>
    <skos:altLabel>Ancillary benefits</skos:altLabel>
    <skos:altLabel>Triple wins</skos:altLabel>
    <skos:altLabel>Mitigation co-benefits</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000051"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000119">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Finance (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector encompassing banking, insurance, investment, and financial services, including public and private finance mechanisms.</skos:definition>
    <skos:altLabel>Financial sector</skos:altLabel>
    <skos:altLabel>Banking</skos:altLabel>
    <skos:altLabel>Investment</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000415">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000416"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000421"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000418"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000420"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000419"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000417"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000422"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Neurological disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Diseases affecting the brain, spinal cord, and peripheral nervous system, including degenerative, inflammatory, and functional neurological conditions.</skos:definition>
    <skos:scopeNote>GBD ref: 542</skos:scopeNote>
    <skos:altLabel>Brain diseases</skos:altLabel>
    <skos:altLabel>Neurodegenerative diseases</skos:altLabel>
    <skos:altLabel>Nervous system disorders</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000377"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000294">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Attributable fraction / risk (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The proportion of disease cases or deaths in a population attributable to a specific exposure, estimating the potential reduction in burden if the exposure were eliminated.</skos:definition>
    <skos:altLabel>Attributable risk</skos:altLabel>
    <skos:altLabel>Population attributable fraction</skos:altLabel>
    <skos:altLabel>PAF</skos:altLabel>
    <skos:altLabel>Attributable burden</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000293"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000315">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000316"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000317"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>HIV/AIDS and sexually transmitted infections</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infections transmitted through sexual contact or blood-borne routes, including HIV/AIDS and bacterial and viral sexually transmitted infections.</skos:definition>
    <skos:scopeNote>GBD ref: 955</skos:scopeNote>
    <skos:altLabel>HIV</skos:altLabel>
    <skos:altLabel>STIs</skos:altLabel>
    <skos:altLabel>Sexually transmitted diseases</skos:altLabel>
    <skos:altLabel>STDs</skos:altLabel>
    <skos:altLabel>HIV and STIs</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000314"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000502">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Mangrove</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Coastal forest ecosystems dominated by salt-tolerant trees growing in intertidal zones of tropical and subtropical coastlines, providing habitat, carbon storage, and protection against storm surge and coastal erosion.</skos:definition>
    <skos:altLabel>Mangrove forest</skos:altLabel>
    <skos:altLabel>Mangrove swamp</skos:altLabel>
    <skos:altLabel>Mangrove wetland</skos:altLabel>
    <skos:altLabel>Coastal mangrove</skos:altLabel>
    <skos:altLabel>Intertidal forest</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>F. Interventions / responses / solutions</dct:title>
    <dct:description>Policies, technologies, behaviours, and institutional responses deployed to mitigate or adapt to climate change and reduce associated health and environmental impacts.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000097"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000588"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000113"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000114"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000093"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000585">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Emergency / disaster management</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Systems and institutions for preparedness, response, and recovery in relation to emergencies and disasters, including early warning, evacuation planning, and surge capacity for acute events.</skos:definition>
    <skos:altLabel>Emergency preparedness</skos:altLabel>
    <skos:altLabel>Disaster response</skos:altLabel>
    <skos:altLabel>Disaster risk reduction</skos:altLabel>
    <skos:altLabel>Crisis management</skos:altLabel>
    <skos:altLabel>Humanitarian response</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000114"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000121">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Social protection (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector providing social safety nets, welfare services, and support systems that protect vulnerable populations from economic and social risks.</skos:definition>
    <skos:altLabel>Social services</skos:altLabel>
    <skos:altLabel>Welfare</skos:altLabel>
    <skos:altLabel>Safety nets</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000542">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Ethnographic / interview-based</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A qualitative research design using immersive fieldwork, participant observation, or in-depth interviews to explore lived experiences, cultural practices, and social contexts.</skos:definition>
    <skos:altLabel>Ethnography</skos:altLabel>
    <skos:altLabel>In-depth interviews</skos:altLabel>
    <skos:altLabel>Qualitative interviews</skos:altLabel>
    <skos:altLabel>Interview-based study</skos:altLabel>
    <skos:altLabel>Fieldwork</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000541"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000442">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Acute kidney injury</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Sudden deterioration of kidney function over hours to days, causing accumulation of waste products and fluid imbalance, often associated with sepsis, dehydration, or nephrotoxic exposure.</skos:definition>
    <skos:altLabel>AKI</skos:altLabel>
    <skos:altLabel>Acute renal failure</skos:altLabel>
    <skos:altLabel>Acute kidney failure</skos:altLabel>
    <skos:altLabel>Acute renal injury</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000440"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000203">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Rapid review</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A systematic review conducted within a shortened timeframe using streamlined methods, trading some comprehensiveness for speed to meet urgent policy or practice needs.</skos:definition>
    <skos:altLabel>Accelerated review</skos:altLabel>
    <skos:altLabel>Fast-track review</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000201"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000469">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Sudden infant death syndrome</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>The sudden unexpected death of an apparently healthy infant, typically during sleep, for which no cause is identified after thorough post-mortem investigation.</skos:definition>
    <skos:scopeNote>GBD ref: 686</skos:scopeNote>
    <skos:altLabel>SIDS</skos:altLabel>
    <skos:altLabel>Cot death</skos:altLabel>
    <skos:altLabel>Sudden unexplained infant death</skos:altLabel>
    <skos:altLabel>SUID</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000462"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000465">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Gynecological diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Diseases of the female reproductive system, including endometriosis, uterine fibroids, polycystic ovary syndrome, and pelvic inflammatory disease.</skos:definition>
    <skos:scopeNote>GBD ref: 603</skos:scopeNote>
    <skos:altLabel>Gynaecological conditions</skos:altLabel>
    <skos:altLabel>Female reproductive diseases</skos:altLabel>
    <skos:altLabel>Uterine disease</skos:altLabel>
    <skos:altLabel>Endometriosis</skos:altLabel>
    <skos:altLabel>Pelvic inflammatory disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000462"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000617">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Ozone-depleting substances / chlorofluorocarbons / hydrochlorofluorocarbons / halons / carbon tetrachloride / methyl chloroform</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents"/>
    <skos:definition>Chemical compounds that destroy stratospheric ozone and act as potent greenhouse gases, regulated under the Montreal Protocol due to their combined climate and health impacts.</skos:definition>
    <skos:altLabel>ODSs</skos:altLabel>
    <skos:altLabel>CFCs</skos:altLabel>
    <skos:altLabel>Ozone-depleting chemicals</skos:altLabel>
    <skos:altLabel>HCFCs</skos:altLabel>
    <skos:altLabel>Halons</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000543">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Focus group</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A qualitative method collecting data through facilitated group discussion among selected participants, used to explore shared perspectives, norms, and experiences on a defined topic.</skos:definition>
    <skos:altLabel>Focus group discussion</skos:altLabel>
    <skos:altLabel>FGD</skos:altLabel>
    <skos:altLabel>Group interview</skos:altLabel>
    <skos:altLabel>Group discussion</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000541"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/country-income/DSNY000139">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>High</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/country-income"/>
    <skos:definition>Countries classified by the World Bank as having the highest gross national income per capita, generally with the greatest adaptive capacity but also the highest historical contributions to cumulative emissions.</skos:definition>
    <skos:altLabel>HIC</skos:altLabel>
    <skos:altLabel>High-income countries</skos:altLabel>
    <skos:altLabel>Developed countries</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000110">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Behaviour related to food/diet</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Changes in dietary patterns and food purchasing behaviour, such as reducing meat intake, minimising food waste, or choosing locally produced food, to lower the environmental footprint of food consumption.</skos:definition>
    <skos:altLabel>Dietary behaviour</skos:altLabel>
    <skos:altLabel>Food choices</skos:altLabel>
    <skos:altLabel>Food consumption behaviour</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000425">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Depressive disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A common mental disorder characterised by persistent low mood, anhedonia, and a range of cognitive, physical, and emotional symptoms causing significant functional impairment.</skos:definition>
    <skos:scopeNote>GBD ref: 567</skos:scopeNote>
    <skos:altLabel>Depression</skos:altLabel>
    <skos:altLabel>Major depressive disorder</skos:altLabel>
    <skos:altLabel>MDD</skos:altLabel>
    <skos:altLabel>Unipolar depression</skos:altLabel>
    <skos:altLabel>Depressive episode</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000423"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000597">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Changes in glacier / snow melt</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>Accelerated melting of glaciers and snowpack due to rising temperatures, affecting freshwater supply, sea levels, and downstream ecosystems.</skos:definition>
    <skos:altLabel>Glacier melt</skos:altLabel>
    <skos:altLabel>Snowmelt</skos:altLabel>
    <skos:altLabel>Cryosphere change</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000329">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other intestinal infectious diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Intestinal infectious diseases not classified under diarrhoea, cholera, typhoid, or iNTS, including other bacterial, viral, and parasitic gut infections.</skos:definition>
    <skos:scopeNote>GBD ref: 321</skos:scopeNote>
    <skos:altLabel>Intestinal infections</skos:altLabel>
    <skos:altLabel>Other gut infections</skos:altLabel>
    <skos:altLabel>Other enteric diseases</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000324"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000600">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Changes in sea level</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>The increase in mean sea level resulting from thermal expansion of seawater and melting ice, threatening coastal communities, infrastructure, and freshwater resources.</skos:definition>
    <skos:altLabel>Coastal inundation</skos:altLabel>
    <skos:altLabel>Ocean level rise</skos:altLabel>
    <skos:altLabel>Sea level change</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000570">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Fossil fuel-based energy systems</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Power generation infrastructure using coal, oil, or gas combustion, associated with significant greenhouse gas emissions and air pollution health burdens.</skos:definition>
    <skos:altLabel>Coal power</skos:altLabel>
    <skos:altLabel>Oil and gas generation</skos:altLabel>
    <skos:altLabel>Fossil fuel energy</skos:altLabel>
    <skos:altLabel>Air pollution from power generation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000096"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements/DSNY000514">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other informal settlements</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Informal settlements not classified as slums, favelas, or refugee and displaced settlements, including other forms of unplanned or unauthorised housing such as illegal subdivisions, informal extensions of formal areas, and transitional settlements.</skos:definition>
    <skos:altLabel>Other unplanned settlements</skos:altLabel>
    <skos:altLabel>Other unauthorised settlements</skos:altLabel>
    <skos:altLabel>Other informal housing</skos:altLabel>
    <skos:altLabel>Miscellaneous informal settlements</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000511"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/extreme-weather-events/DSNY000608">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Floods</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/extreme-weather-events"/>
    <skos:definition>Temporary inundation of normally dry land caused by excessive rainfall, storm surges, or rapid snowmelt, posing risks to human health, displacement, and infrastructure.</skos:definition>
    <skos:altLabel>Flooding</skos:altLabel>
    <skos:altLabel>Inundation</skos:altLabel>
    <skos:altLabel>Flash floods</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000242">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Pregnancy (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Individuals during pregnancy, whose altered physiology and increased metabolic demands heighten susceptibility to environmental exposures and infectious disease with potential consequences for both maternal and foetal health.</skos:definition>
    <skos:altLabel>Pregnant women</skos:altLabel>
    <skos:altLabel>Expectant mothers</skos:altLabel>
    <skos:altLabel>Antenatal</skos:altLabel>
    <skos:altLabel>Prenatal</skos:altLabel>
    <skos:altLabel>Gestational period</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000387">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Stroke</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Sudden interruption or rupture of blood supply to the brain, causing focal neurological deficits, classified as ischaemic or haemorrhagic in type.</skos:definition>
    <skos:scopeNote>GBD ref: 494</skos:scopeNote>
    <skos:altLabel>Cerebrovascular disease</skos:altLabel>
    <skos:altLabel>Brain attack</skos:altLabel>
    <skos:altLabel>Ischaemic stroke</skos:altLabel>
    <skos:altLabel>Haemorrhagic stroke</skos:altLabel>
    <skos:altLabel>CVA</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000574">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Industrial / extractive infrastructure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Mining, cement, steel, chemical, and other extractive and heavy industrial processes associated with high greenhouse gas emissions and direct health burdens from air, water, and soil pollution.</skos:definition>
    <skos:altLabel>Mining</skos:altLabel>
    <skos:altLabel>Cement production</skos:altLabel>
    <skos:altLabel>Steel production</skos:altLabel>
    <skos:altLabel>Heavy industry</skos:altLabel>
    <skos:altLabel>Extractive industries</skos:altLabel>
    <skos:altLabel>Industrial emissions</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000096"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000290">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Outpatient / primary care visit (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The rate or number of non-emergency contacts with primary care or outpatient services, including general practice, specialist clinics, and community health settings.</skos:definition>
    <skos:altLabel>GP visit</skos:altLabel>
    <skos:altLabel>Primary care visit</skos:altLabel>
    <skos:altLabel>Outpatient attendance</skos:altLabel>
    <skos:altLabel>Clinic visit</skos:altLabel>
    <skos:altLabel>Ambulatory care visit</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000287"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/topic/DSNY000054">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Attribution</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/topic"/>
    <skos:definition>The process of establishing the causal contribution of climate change to observed changes in physical, ecological, or human systems, including specific extreme weather events or health outcomes.</skos:definition>
    <skos:scopeNote>Refers to attribution as a high-level thematic area of climate research, encompassing the field of climate and health attribution broadly. Distinct from 'Attribution' in the Methods scheme, which classifies attribution as a specific study aim within primary research.</skos:scopeNote>
    <skos:altLabel>Climate attribution</skos:altLabel>
    <skos:altLabel>Causal attribution</skos:altLabel>
    <skos:altLabel>Event attribution</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000053"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000104">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Lifestyle change in place</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Changes to daily routines, work patterns, or living arrangements made within a person's current location in response to changing conditions, without relocating.</skos:definition>
    <skos:altLabel>In-place adaptation</skos:altLabel>
    <skos:altLabel>Local adaptation</skos:altLabel>
    <skos:altLabel>Staying in place</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000114">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000585"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000583"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000586"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000584"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000587"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Institutional</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Actions taken by formal organisations and institutions — including governments, health systems, and international bodies — to build climate resilience and coordinate adaptation or mitigation efforts, spanning health system governance, research and education, emergency management, and international development.</skos:definition>
    <skos:scopeNote>Institutional interventions are expected to be expanded with narrower concepts in a future revision. Currently used as a top-level tag for formal organisational and system-level climate responses.</skos:scopeNote>
    <skos:altLabel>Institutional response</skos:altLabel>
    <skos:altLabel>Organisational measures</skos:altLabel>
    <skos:altLabel>System-level response</skos:altLabel>
    <skos:altLabel>Formal institutional action</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/governance-scale/DSNY000131">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>National (Governance scale)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/governance-scale"/>
    <skos:definition>Governance and policy implemented at the level of a single sovereign nation, including national legislation, strategic plans, and government-led programmes.</skos:definition>
    <skos:altLabel>Country-level</skos:altLabel>
    <skos:altLabel>Federal</skos:altLabel>
    <skos:altLabel>State-level governance</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000099">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Civic engagement</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Participation in collective and political processes aimed at influencing climate policy, community resilience planning, or social responses to climate hazards.</skos:definition>
    <skos:altLabel>Community participation</skos:altLabel>
    <skos:altLabel>Political engagement</skos:altLabel>
    <skos:altLabel>Climate activism</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000278">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Years of life lost (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>A measure of premature mortality calculated as the years of life lost due to death before a defined life expectancy threshold.</skos:definition>
    <skos:altLabel>YLL</skos:altLabel>
    <skos:altLabel>Life years lost</skos:altLabel>
    <skos:altLabel>Potential years of life lost</skos:altLabel>
    <skos:altLabel>PYLL</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000274"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000564">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Climate-resilient water / sanitation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Water, sanitation, and hygiene (WASH) infrastructure designed to remain functional under changing precipitation patterns, including flood-proof and drought-resilient water supply systems and sanitation systems adapted to climate variability.</skos:definition>
    <skos:altLabel>WASH</skos:altLabel>
    <skos:altLabel>Flood-proof water supply</skos:altLabel>
    <skos:altLabel>Drought-resilient water</skos:altLabel>
    <skos:altLabel>Climate-resilient sanitation</skos:altLabel>
    <skos:altLabel>Water and sanitation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000095"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000320">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Lower respiratory infections</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infections of the lower respiratory tract including the lungs and bronchi, such as pneumonia and bronchiolitis, representing a leading cause of morbidity and mortality.</skos:definition>
    <skos:scopeNote>GBD ref: 322</skos:scopeNote>
    <skos:altLabel>Pneumonia</skos:altLabel>
    <skos:altLabel>LRI</skos:altLabel>
    <skos:altLabel>Lower respiratory tract infection</skos:altLabel>
    <skos:altLabel>Bronchitis</skos:altLabel>
    <skos:altLabel>Bronchiolitis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000318"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age/DSNY000252">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Preschool child (2-5 years)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Children aged 2 to 5 years in the preschool developmental stage, characterised by rapid brain development, high activity levels, and reliance on caregivers for protection from environmental hazards.</skos:definition>
    <skos:altLabel>Preschool children</skos:altLabel>
    <skos:altLabel>Toddlers</skos:altLabel>
    <skos:altLabel>Early childhood</skos:altLabel>
    <skos:altLabel>Under 5s</skos:altLabel>
    <skos:altLabel>Young children</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000251"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>N.3 Health - Outcomes</dct:title>
    <dct:description>Diseases, injuries, and health conditions used to classify the health effects studied in research, organised according to the Global Burden of Disease (GBD) cause hierarchy.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000296"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000314"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000377"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000470"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000357">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Pertussis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A highly contagious bacterial respiratory infection caused by Bordetella pertussis, characterised by severe paroxysmal coughing and particularly dangerous in infants.</skos:definition>
    <skos:scopeNote>GBD ref: 339</skos:scopeNote>
    <skos:altLabel>Whooping cough</skos:altLabel>
    <skos:altLabel>Bordetella pertussis</skos:altLabel>
    <skos:altLabel>Whooping cough infection</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000353"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/fossil-fuels/DSNY000622">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Oil</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/fossil-fuels"/>
    <skos:definition>A liquid fossil fuel refined into petroleum products including petrol, diesel, and jet fuel, a major source of greenhouse gas emissions from transport and industry.</skos:definition>
    <skos:altLabel>Petroleum</skos:altLabel>
    <skos:altLabel>Crude oil</skos:altLabel>
    <skos:altLabel>Petrol</skos:altLabel>
    <skos:altLabel>diesel</skos:altLabel>
    <skos:altLabel>kerosene</skos:altLabel>
    <skos:altLabel>gasoline</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000345">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Food-borne trematodiases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Parasitic infections caused by trematode flatworms acquired through consumption of contaminated raw or undercooked fish, crustaceans, or aquatic plants.</skos:definition>
    <skos:scopeNote>GBD ref: 364</skos:scopeNote>
    <skos:altLabel>Liver flukes</skos:altLabel>
    <skos:altLabel>Clonorchiasis</skos:altLabel>
    <skos:altLabel>Opisthorchiasis</skos:altLabel>
    <skos:altLabel>Fascioliasis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000417">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Parkinson's disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A progressive neurodegenerative disease characterised by tremor, rigidity, bradykinesia, and postural instability, caused by loss of dopaminergic neurons in the substantia nigra.</skos:definition>
    <skos:scopeNote>GBD ref: 544</skos:scopeNote>
    <skos:altLabel>PD</skos:altLabel>
    <skos:altLabel>Parkinsonism</skos:altLabel>
    <skos:altLabel>Parkinson's</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000415"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000412">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Gallbladder and biliary diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Conditions affecting the gallbladder and bile ducts, including cholelithiasis, cholecystitis, and biliary obstruction.</skos:definition>
    <skos:scopeNote>GBD ref: 534</skos:scopeNote>
    <skos:altLabel>Gallstones</skos:altLabel>
    <skos:altLabel>Cholecystitis</skos:altLabel>
    <skos:altLabel>Biliary disease</skos:altLabel>
    <skos:altLabel>Cholelithiasis</skos:altLabel>
    <skos:altLabel>Bile duct disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000479">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Animal contact</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injuries caused by contact with animals, including bites, stings, and envenomation from snakes, insects, marine animals, and other wildlife.</skos:definition>
    <skos:scopeNote>GBD ref: 709</skos:scopeNote>
    <skos:altLabel>Animal bite</skos:altLabel>
    <skos:altLabel>Snake bite</skos:altLabel>
    <skos:altLabel>Venomous animal</skos:altLabel>
    <skos:altLabel>Insect sting</skos:altLabel>
    <skos:altLabel>Dog bite</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000472"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/reference-type/DSNY000628">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Grey literature</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/reference-type"/>
    <skos:definition>Reports published outside the classic editorial route, predominantly by intergovernmental organizations, supra-national organizations, NGOs, governments.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000339">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Onchocerciasis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A parasitic disease caused by Onchocerca volvulus, transmitted by blackflies near fast-flowing rivers, causing skin disease and progressive visual impairment leading to blindness.</skos:definition>
    <skos:scopeNote>GBD ref: 355</skos:scopeNote>
    <skos:altLabel>River blindness</skos:altLabel>
    <skos:altLabel>Onchocerca volvulus</skos:altLabel>
    <skos:altLabel>Blackfly disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000374">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Vitamin A deficiency</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deficiency of vitamin A resulting in night blindness, increased susceptibility to infection, and xerophthalmia, predominantly affecting children and pregnant women.</skos:definition>
    <skos:scopeNote>GBD ref: 389</skos:scopeNote>
    <skos:altLabel>Vitamin A deficiency disorder</skos:altLabel>
    <skos:altLabel>VAD</skos:altLabel>
    <skos:altLabel>Night blindness</skos:altLabel>
    <skos:altLabel>Xerophthalmia</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000370"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000420">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Motor neuron disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A progressive neurodegenerative disease causing degeneration of upper and lower motor neurons, leading to progressive paralysis and respiratory failure.</skos:definition>
    <skos:scopeNote>GBD ref: 554</skos:scopeNote>
    <skos:altLabel>MND</skos:altLabel>
    <skos:altLabel>ALS</skos:altLabel>
    <skos:altLabel>Amyotrophic lateral sclerosis</skos:altLabel>
    <skos:altLabel>Lou Gehrig's disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000415"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000550">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Other health-related modelling / simulation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Health modelling and simulation approaches not classified under IAM, CGE, or microsimulation, including epidemiological models, disease transmission models, and burden of disease projections.</skos:definition>
    <skos:altLabel>Other health modelling</skos:altLabel>
    <skos:altLabel>Epidemiological modelling</skos:altLabel>
    <skos:altLabel>Disease model</skos:altLabel>
    <skos:altLabel>Burden of disease model</skos:altLabel>
    <skos:altLabel>Transmission model</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000545"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000448">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Scabies</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A highly contagious skin infestation caused by the mite Sarcoptes scabiei, causing intense pruritus and a characteristic rash, with crusted scabies occurring in immunocompromised individuals.</skos:definition>
    <skos:scopeNote>GBD ref: 658</skos:scopeNote>
    <skos:altLabel>Sarcoptes scabiei</skos:altLabel>
    <skos:altLabel>Scabies infestation</skos:altLabel>
    <skos:altLabel>Mange</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000092">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Regulatory / legislative policy</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Legally binding rules, standards, and enforcement mechanisms that mandate emissions reductions, land use changes, or other climate-related behaviours by governments, industries, or individuals. E.g. emissions standards, environmental health regulations, fossil fuel bans.</skos:definition>
    <skos:altLabel>Climate regulation</skos:altLabel>
    <skos:altLabel>Standards</skos:altLabel>
    <skos:altLabel>Legal instruments</skos:altLabel>
    <skos:altLabel>Legislative instruments</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age/DSNY000257">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Middle aged (45-64 years)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Adults aged 45 to 64 years, a life stage associated with the onset of chronic non-communicable diseases and changing physiological risk profiles.</skos:definition>
    <skos:altLabel>Middle age</skos:altLabel>
    <skos:altLabel>Middle-aged adults</skos:altLabel>
    <skos:altLabel>45 to 64 year olds</skos:altLabel>
    <skos:altLabel>Mid-life</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000255"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/governance-scale/DSNY000132">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Sub-national - local / municipal (Governance scale)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/governance-scale"/>
    <skos:definition>Governance at the local or municipal level, including city councils and district authorities responsible for planning, service delivery, and local policy implementation.</skos:definition>
    <skos:altLabel>Local</skos:altLabel>
    <skos:altLabel>Municipal</skos:altLabel>
    <skos:altLabel>City-level</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000348">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Zika virus</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A mosquito-borne viral infection caused by Zika virus, typically mild in adults but associated with congenital microcephaly and Guillain-Barré syndrome.</skos:definition>
    <skos:scopeNote>GBD ref: 935</skos:scopeNote>
    <skos:altLabel>Zika</skos:altLabel>
    <skos:altLabel>Zika virus infection</skos:altLabel>
    <skos:altLabel>ZIKV</skos:altLabel>
    <skos:altLabel>Aedes-borne Zika</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000289">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Emergency department visit (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The rate or number of attendances at emergency departments for acute assessment and treatment, used as an indicator of urgent health need.</skos:definition>
    <skos:altLabel>ED visit</skos:altLabel>
    <skos:altLabel>A&amp;E attendance</skos:altLabel>
    <skos:altLabel>Emergency visit</skos:altLabel>
    <skos:altLabel>Emergency care attendance</skos:altLabel>
    <skos:altLabel>Accident and emergency</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000287"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000521">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>(Uncontrolled) interrupted time series</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A time series analysis of outcome data at multiple time points before and after an intervention or exposure in a single group, without a control series to account for concurrent trends.</skos:definition>
    <skos:altLabel>Uncontrolled ITS</skos:altLabel>
    <skos:altLabel>Single-group interrupted time series</skos:altLabel>
    <skos:altLabel>ITS (uncontrolled)</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000519"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000331">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Malaria</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A parasitic disease transmitted by Anopheles mosquitoes, caused by Plasmodium species, producing fever, anaemia, and potentially fatal cerebral complications.</skos:definition>
    <skos:scopeNote>GBD ref: 345</skos:scopeNote>
    <skos:altLabel>Plasmodium</skos:altLabel>
    <skos:altLabel>Malaria fever</skos:altLabel>
    <skos:altLabel>Falciparum malaria</skos:altLabel>
    <skos:altLabel>Tropical malaria</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000152">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Temperate</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Regions with moderate climates experiencing distinct seasons, where climate change is altering seasonal patterns, increasing extreme weather frequency, and affecting biodiversity.</skos:definition>
    <skos:altLabel>Temperate zone</skos:altLabel>
    <skos:altLabel>Temperate climate</skos:altLabel>
    <skos:altLabel>Mid-latitude</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000328">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Invasive Non-typhoidal Salmonella (iNTS)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Severe systemic infection caused by non-typhoidal Salmonella serovars invading the bloodstream, predominantly affecting young children and immunocompromised individuals in low-income settings.</skos:definition>
    <skos:scopeNote>GBD ref: 959</skos:scopeNote>
    <skos:altLabel>iNTS</skos:altLabel>
    <skos:altLabel>Non-typhoidal Salmonella</skos:altLabel>
    <skos:altLabel>Invasive salmonellosis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000324"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-gender-sex/DSNY000244">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>All genders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-gender-sex"/>
    <skos:definition>Studies or data that include individuals of all gender identities or both sexes without stratification, or where findings apply across the full gender spectrum.</skos:definition>
    <skos:altLabel>All sexes</skos:altLabel>
    <skos:altLabel>Both sexes</skos:altLabel>
    <skos:altLabel>Mixed gender</skos:altLabel>
    <skos:altLabel>Total population</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000504">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Subtropical</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Regions located between the tropics and temperate zones, characterised by warm temperatures year-round, variable rainfall, and a mix of humid and dry subtropical climates.</skos:definition>
    <skos:altLabel>Subtropical region</skos:altLabel>
    <skos:altLabel>Subtropical zone</skos:altLabel>
    <skos:altLabel>Subtropical climate</skos:altLabel>
    <skos:altLabel>Near-tropical region</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-gender-sex/DSNY000245">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Diverse</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-gender-sex"/>
    <skos:definition>Individuals whose gender identity or expression differs from the sex assigned at birth, including transgender, non-binary, and other gender-diverse people.</skos:definition>
    <skos:altLabel>Gender diverse</skos:altLabel>
    <skos:altLabel>Non-binary</skos:altLabel>
    <skos:altLabel>Transgender</skos:altLabel>
    <skos:altLabel>Gender minority</skos:altLabel>
    <skos:altLabel>LGBTQ+</skos:altLabel>
    <skos:altLabel>Gender non-conforming</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000554">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Mixed-methods review</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A systematic review that integrates findings from both quantitative and qualitative primary studies, using mixed-methods synthesis approaches to address questions that neither approach could answer alone.</skos:definition>
    <skos:altLabel>Mixed-methods systematic review</skos:altLabel>
    <skos:altLabel>Convergent review</skos:altLabel>
    <skos:altLabel>Integrated review</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000201"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000454">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Urticaria</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>An allergic or immune-mediated reaction presenting as transient raised itchy wheals on the skin, often accompanied by angioedema of deeper tissues.</skos:definition>
    <skos:scopeNote>GBD ref: 664</skos:scopeNote>
    <skos:altLabel>Hives</skos:altLabel>
    <skos:altLabel>Allergic urticaria</skos:altLabel>
    <skos:altLabel>Angioedema</skos:altLabel>
    <skos:altLabel>Nettle rash</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000553">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Realist review</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A theory-driven review methodology that explores how and why interventions work in particular contexts and for whom, generating or testing explanatory theories rather than aggregating effect estimates.</skos:definition>
    <skos:altLabel>Realist synthesis</skos:altLabel>
    <skos:altLabel>Realist evaluation review</skos:altLabel>
    <skos:altLabel>Theory-driven review</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000201"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements/DSNY000510">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Peri-urban settlements</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Areas at the urban-rural interface characterised by mixed land use, rapid demographic and physical change, and often partial or transitional access to urban services. The term is used variably across research traditions to describe either the rural-urban fringe of a growing city or areas that are administratively rural but functionally urban.</skos:definition>
    <skos:altLabel>Peri-urban areas</skos:altLabel>
    <skos:altLabel>Urban-rural fringe</skos:altLabel>
    <skos:altLabel>Urban fringe</skos:altLabel>
    <skos:altLabel>Urban periphery</skos:altLabel>
    <skos:altLabel>Rural-urban interface</skos:altLabel>
    <skos:altLabel>Suburban fringe</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000335">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Schistosomiasis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A parasitic disease caused by Schistosoma flatworms, transmitted through contact with contaminated freshwater, causing chronic inflammation of the bladder, liver, and intestines.</skos:definition>
    <skos:scopeNote>GBD ref: 351</skos:scopeNote>
    <skos:altLabel>Bilharzia</skos:altLabel>
    <skos:altLabel>Snail fever</skos:altLabel>
    <skos:altLabel>Trematode infection</skos:altLabel>
    <skos:altLabel>Schistosoma</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000125">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Transportation (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector covering road, rail, air, and maritime transport systems, including infrastructure, vehicles, and logistics operations.</skos:definition>
    <skos:altLabel>Transport</skos:altLabel>
    <skos:altLabel>Mobility</skos:altLabel>
    <skos:altLabel>Logistics</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000293">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000294"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000295"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Exposure quantification (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>Metrics that quantify the magnitude of an exposure or the proportion of outcomes attributable to that exposure in a defined population.</skos:definition>
    <skos:altLabel>Exposure measurement</skos:altLabel>
    <skos:altLabel>Exposure assessment</skos:altLabel>
    <skos:altLabel>Risk quantification</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-location/DSNY000630">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Africa (example)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-location"/>
    <skos:definition>Africa is the world's second-largest continent by area and population, comprising 54 sovereign countries on a single landmass connected to Asia via the Sinai Peninsula, bordered by the Mediterranean Sea, Atlantic Ocean, Indian Ocean, and Red Sea.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000368">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Neonatal preterm birth</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Birth occurring before 37 completed weeks of gestation, associated with increased risk of respiratory distress, infection, neurodevelopmental impairment, and neonatal death.</skos:definition>
    <skos:scopeNote>GBD ref: 381</skos:scopeNote>
    <skos:altLabel>Premature birth</skos:altLabel>
    <skos:altLabel>Preterm delivery</skos:altLabel>
    <skos:altLabel>Prematurity</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000367"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000275">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>All-cause mortality (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The rate of death from any cause within a defined population over a specified period, regardless of the underlying cause.</skos:definition>
    <skos:altLabel>All-cause death rate</skos:altLabel>
    <skos:altLabel>Total mortality</skos:altLabel>
    <skos:altLabel>Crude mortality rate</skos:altLabel>
    <skos:altLabel>Overall mortality</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000274"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000522">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000523"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000524"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000525"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000526"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Observational / group comparison designs</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Observational study designs that compare health outcomes between two or more groups defined by exposure status, without random allocation.</skos:definition>
    <skos:altLabel>Comparative observational design</skos:altLabel>
    <skos:altLabel>Observational comparative study</skos:altLabel>
    <skos:altLabel>Analytic observational design</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000167"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000240">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Migrants (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>People who have moved within or across borders, voluntarily or under duress, and who may face elevated health risks due to displacement, poor living conditions, and restricted access to services.</skos:definition>
    <skos:altLabel>Migrants</skos:altLabel>
    <skos:altLabel>Refugees</skos:altLabel>
    <skos:altLabel>Asylum seekers</skos:altLabel>
    <skos:altLabel>Internally displaced persons</skos:altLabel>
    <skos:altLabel>IDP</skos:altLabel>
    <skos:altLabel>Immigrants</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/actors/DSNY000164">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Private sector (Actor)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/actors"/>
    <skos:definition>Commercial enterprises, industries, and business associations whose operations, investments, and innovations shape economic and environmental outcomes.</skos:definition>
    <skos:altLabel>Business</skos:altLabel>
    <skos:altLabel>Industry</skos:altLabel>
    <skos:altLabel>Corporations</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>C. Methods</dct:title>
    <dct:description>Research methods and study design concepts used to classify the methodological characteristics of primary research and evidence synthesis in the DESTINY evidence repository.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000167"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000198"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000237">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Indigenous peoples (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Populations with historical, cultural, and territorial ties to lands prior to colonisation, who often face compounded social, economic, and environmental vulnerabilities.</skos:definition>
    <skos:altLabel>Indigenous communities</skos:altLabel>
    <skos:altLabel>Aboriginal peoples</skos:altLabel>
    <skos:altLabel>First Nations</skos:altLabel>
    <skos:altLabel>Native peoples</skos:altLabel>
    <skos:altLabel>Tribal communities</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000302">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Diabetes and kidney diseases mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths attributable to diabetes mellitus and chronic kidney disease, which frequently co-occur and share common risk pathways.</skos:definition>
    <skos:altLabel>Diabetes mortality</skos:altLabel>
    <skos:altLabel>Kidney disease mortality</skos:altLabel>
    <skos:altLabel>Renal mortality</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000298"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000518">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Case series / descriptive multi-case study</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A descriptive report of characteristics and outcomes among a series of individuals sharing a common exposure or condition, without a control group.</skos:definition>
    <skos:altLabel>Case series</skos:altLabel>
    <skos:altLabel>Descriptive multi-case study</skos:altLabel>
    <skos:altLabel>Patient series</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000515"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000612">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Carbon dioxide (CO₂)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents"/>
    <skos:definition>The primary long-lived greenhouse gas produced by fossil fuel combustion, deforestation, and industrial processes, responsible for the majority of anthropogenic radiative forcing.</skos:definition>
    <skos:altLabel>CO2</skos:altLabel>
    <skos:altLabel>Carbon dioxide emissions</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000596">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>(Unspecified) changes in weather</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>General changes in weather patterns not attributed to a specific meteorological variable, used when studies refer to weather variability in broad terms.</skos:definition>
    <skos:altLabel>Weather variability</skos:altLabel>
    <skos:altLabel>Unspecified weather change</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000283">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Prevalence (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The proportion of a defined population living with a disease or condition at a specific point in time or during a defined period.</skos:definition>
    <skos:altLabel>Disease prevalence</skos:altLabel>
    <skos:altLabel>Prevalence rate</skos:altLabel>
    <skos:altLabel>Point prevalence</skos:altLabel>
    <skos:altLabel>Period prevalence</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000281"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000142">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Desert</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Arid landscapes receiving very low annual precipitation, characterised by sparse vegetation and high temperatures, making them particularly vulnerable to heat stress and water scarcity.</skos:definition>
    <skos:altLabel>Arid region</skos:altLabel>
    <skos:altLabel>Dryland</skos:altLabel>
    <skos:altLabel>Arid landscape</skos:altLabel>
