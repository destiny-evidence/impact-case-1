    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000202"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000554"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000552"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000203"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000553"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000204"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Systematic review</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A review that uses explicit, reproducible methods to systematically search, select, appraise, and synthesise evidence from primary studies on a defined research question.</skos:definition>
    <skos:altLabel>SR</skos:altLabel>
    <skos:altLabel>Systematic literature review</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000198"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/topic/DSNY000492">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Loss and damage</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/topic"/>
    <skos:definition>Negative consequences of climate change that cannot be avoided through mitigation or adaptation, including irreversible harm to lives, livelihoods, cultural heritage, ecosystems, and infrastructure.</skos:definition>
    <skos:altLabel>L&amp;D</skos:altLabel>
    <skos:altLabel>Irreversible impacts</skos:altLabel>
    <skos:altLabel>Unavoidable impacts</skos:altLabel>
    <skos:altLabel>Non-economic loss and damage</skos:altLabel>
    <skos:altLabel>NELD</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000053"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000123">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Information and communications technologies (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector covering telecommunications, digital infrastructure, and information technology, including hardware, software, and connectivity systems.</skos:definition>
    <skos:altLabel>ICT sector</skos:altLabel>
    <skos:altLabel>Digital sector</skos:altLabel>
    <skos:altLabel>Technology sector</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000385">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Rheumatic heart disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Cardiac valve damage resulting from repeated episodes of rheumatic fever caused by group A streptococcal throat infection, predominantly affecting children and young adults in low-income settings.</skos:definition>
    <skos:scopeNote>GBD ref: 492</skos:scopeNote>
    <skos:altLabel>RHD</skos:altLabel>
    <skos:altLabel>Rheumatic fever</skos:altLabel>
    <skos:altLabel>Rheumatic valvular disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000411">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Vascular intestinal disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Conditions arising from impaired blood supply to the intestinal wall, including mesenteric ischaemia and ischaemic colitis.</skos:definition>
    <skos:scopeNote>GBD ref: 533</skos:scopeNote>
    <skos:altLabel>Ischaemic colitis</skos:altLabel>
    <skos:altLabel>Mesenteric ischaemia</skos:altLabel>
    <skos:altLabel>Intestinal ischaemia</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000533">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Difference-in-differences</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A quasi-experimental method comparing the change in outcomes over time between a group exposed to an intervention and an unexposed control group, to estimate causal effects under the parallel trends assumption.</skos:definition>
    <skos:altLabel>DiD</skos:altLabel>
    <skos:altLabel>Diff-in-diff</skos:altLabel>
    <skos:altLabel>DD estimator</skos:altLabel>
    <skos:altLabel>Difference-in-difference</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000532"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000392">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Atrial fibrillation and flutter</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Cardiac arrhythmias characterised by rapid and irregular electrical activity in the atria, associated with stroke risk and heart failure.</skos:definition>
    <skos:scopeNote>GBD ref: 500</skos:scopeNote>
    <skos:altLabel>AF</skos:altLabel>
    <skos:altLabel>Atrial flutter</skos:altLabel>
    <skos:altLabel>Irregular heartbeat</skos:altLabel>
    <skos:altLabel>Arrhythmia</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements/DSNY000513">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Refugee / displaced settlements</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Settlements established to house populations forcibly displaced by conflict, persecution, or disaster, including formal refugee camps, informal displaced person settlements, and spontaneous settlements in host communities. Distinct from other informal settlements in their governance structures, legal frameworks, humanitarian actors, and policy context, and complementary to concepts of forced displacement and migration by capturing the physical and administrative character of where displaced people live rather than the movement itself.</skos:definition>
    <skos:altLabel>Refugee camps</skos:altLabel>
    <skos:altLabel>Displaced person settlements</skos:altLabel>
    <skos:altLabel>IDP camps</skos:altLabel>
    <skos:altLabel>Internally displaced settlements</skos:altLabel>
    <skos:altLabel>Humanitarian settlements</skos:altLabel>
    <skos:altLabel>Forced displacement settlements</skos:altLabel>
    <skos:altLabel>Asylum settlements</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000511"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000333">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Leishmaniasis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A parasitic disease caused by Leishmania species, transmitted by sandflies, presenting as cutaneous, mucocutaneous, or visceral forms.</skos:definition>
    <skos:scopeNote>GBD ref: 347</skos:scopeNote>
    <skos:altLabel>Kala-azar</skos:altLabel>
    <skos:altLabel>Cutaneous leishmaniasis</skos:altLabel>
    <skos:altLabel>Visceral leishmaniasis</skos:altLabel>
    <skos:altLabel>Leishmania</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
