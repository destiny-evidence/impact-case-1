    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000309"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000310"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000307"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Infectious diseases mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths caused by infectious and parasitic diseases, including respiratory, enteric, vector-borne, and other infections.</skos:definition>
    <skos:altLabel>Infectious mortality</skos:altLabel>
    <skos:altLabel>Infection-related death</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000305"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000440">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000442"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000441"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Kidney dysfunction</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Impaired kidney function assessed by reduced glomerular filtration rate or markers of renal damage, encompassing both chronic and acute kidney conditions.</skos:definition>
