  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000586">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>International development / aid</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>International funding, technical assistance, and development programmes directed at lower-income countries to support economic development, institutional capacity, and service delivery.</skos:definition>
    <skos:altLabel>International development</skos:altLabel>
    <skos:altLabel>Foreign aid</skos:altLabel>
    <skos:altLabel>Development assistance</skos:altLabel>
    <skos:altLabel>Official development assistance</skos:altLabel>
    <skos:altLabel>ODA</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000114"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000271">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Migration / forced displacement (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Involuntary or forced movement of populations away from their homes due to environmental, conflict, or economic pressures, with associated health and social consequences.</skos:definition>
    <skos:altLabel>Forced displacement</skos:altLabel>
    <skos:altLabel>Population displacement</skos:altLabel>
    <skos:altLabel>Refugee exposure</skos:altLabel>
    <skos:altLabel>Internal displacement</skos:altLabel>
    <skos:altLabel>Climate migration</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000267"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000332">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Chagas disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A vector-borne parasitic disease caused by Trypanosoma cruzi, transmitted by triatomine bugs and endemic to Latin America, with chronic cardiac and digestive complications.</skos:definition>
    <skos:scopeNote>GBD ref: 346</skos:scopeNote>
    <skos:altLabel>American trypanosomiasis</skos:altLabel>
    <skos:altLabel>Trypanosoma cruzi</skos:altLabel>
    <skos:altLabel>Chagas</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000431">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Conduct disorder</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A disruptive behavioural disorder characterised by repetitive and persistent patterns of antisocial behaviour, aggression, or violation of social norms.</skos:definition>
    <skos:scopeNote>GBD ref: 579</skos:scopeNote>
    <skos:altLabel>Behavioural disorder</skos:altLabel>
    <skos:altLabel>Oppositional defiant disorder</skos:altLabel>
    <skos:altLabel>ODD</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000423"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000430">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Attention-deficit/hyperactivity disorder</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A neurodevelopmental disorder characterised by persistent inattention, hyperactivity, and impulsivity that impairs functioning across multiple settings.</skos:definition>
    <skos:scopeNote>GBD ref: 578</skos:scopeNote>
    <skos:altLabel>ADHD</skos:altLabel>
    <skos:altLabel>Attention deficit disorder</skos:altLabel>
    <skos:altLabel>ADD</skos:altLabel>
    <skos:altLabel>Hyperactivity disorder</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000423"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000618">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Tropospheric ozone (O₃)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents"/>
    <skos:definition>A short-lived climate pollutant and air quality hazard formed by photochemical reactions between nitrogen oxides and volatile organic compounds, harmful to respiratory health.</skos:definition>
    <skos:altLabel>Ground-level ozone</skos:altLabel>
    <skos:altLabel>O3</skos:altLabel>
    <skos:altLabel>Ozone pollution</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000441">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Chronic kidney disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Irreversible, progressive loss of kidney function over months to years, classified by stages of declining GFR and associated with cardiovascular risk and need for renal replacement therapy.</skos:definition>
    <skos:scopeNote>GBD ref: 589</skos:scopeNote>
    <skos:altLabel>CKD</skos:altLabel>
    <skos:altLabel>Chronic renal failure</skos:altLabel>
    <skos:altLabel>End-stage renal disease</skos:altLabel>
    <skos:altLabel>ESRD</skos:altLabel>
    <skos:altLabel>Renal failure</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000440"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000317">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Sexually transmitted infections excluding HIV</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infections transmitted primarily through sexual contact, excluding HIV, including syphilis, gonorrhoea, chlamydia, and other sexually transmitted pathogens.</skos:definition>
    <skos:scopeNote>GBD ref: 393</skos:scopeNote>
    <skos:altLabel>STIs</skos:altLabel>
    <skos:altLabel>STDs</skos:altLabel>
    <skos:altLabel>Sexually transmitted infections</skos:altLabel>
    <skos:altLabel>Gonorrhoea</skos:altLabel>
    <skos:altLabel>Syphilis</skos:altLabel>
    <skos:altLabel>Chlamydia</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000315"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/actors/DSNY000163">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Governments (Actor)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/actors"/>
    <skos:definition>National, regional, and local government bodies responsible for setting policy, enacting legislation, and implementing programmes within their jurisdictions.</skos:definition>
    <skos:altLabel>State</skos:altLabel>
    <skos:altLabel>Public authorities</skos:altLabel>
    <skos:altLabel>Governments</skos:altLabel>
