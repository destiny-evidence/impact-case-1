  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000117">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Education (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector encompassing formal and informal education systems, including schools, universities, and vocational institutions.</skos:definition>
    <skos:altLabel>Schools</skos:altLabel>
    <skos:altLabel>Academic institutions</skos:altLabel>
    <skos:altLabel>Learning sector</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000467">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Endocrine, metabolic, blood, and immune disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A heterogeneous group of conditions affecting endocrine glands, metabolic processes, and immune function, including thyroid disease, adrenal disorders, and autoimmune conditions. Exception is diabetes, which is captured under "Diabetes and kidney diseases" and more specifically under "Diabetes mellitus".</skos:definition>
    <skos:scopeNote>GBD ref: 619</skos:scopeNote>
    <skos:altLabel>Thyroid disease</skos:altLabel>
    <skos:altLabel>Immune disease</skos:altLabel>
    <skos:altLabel>Metabolic disorder</skos:altLabel>
    <skos:altLabel>Endocrine disease</skos:altLabel>
    <skos:altLabel>Autoimmune disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000462"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000318">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000323"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000320"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000322"/>
