    <skos:prefLabel>Ebola</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A severe and often fatal viral haemorrhagic fever caused by Ebola virus, characterised by fever, bleeding, and multi-organ failure.</skos:definition>
    <skos:scopeNote>GBD ref: 843</skos:scopeNote>
    <skos:altLabel>Ebola virus disease</skos:altLabel>
    <skos:altLabel>EVD</skos:altLabel>
    <skos:altLabel>Ebola haemorrhagic fever</skos:altLabel>
    <skos:altLabel>Viral haemorrhagic fever</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age/DSNY000254">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Adolescent (13-18 years)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Individuals aged 13 to 18 years undergoing puberty and adolescent development, with distinct biological vulnerabilities and behavioural risk profiles compared to younger children and adults.</skos:definition>
    <skos:altLabel>Teenagers</skos:altLabel>
    <skos:altLabel>Young people</skos:altLabel>
    <skos:altLabel>Adolescence</skos:altLabel>
    <skos:altLabel>Youth</skos:altLabel>
    <skos:altLabel>Teens</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000436">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Alcohol use disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A chronic disorder characterised by compulsive alcohol consumption, loss of control over drinking, and continued use despite physical and social harm.</skos:definition>
    <skos:scopeNote>GBD ref: 560</skos:scopeNote>
    <skos:altLabel>Alcoholism</skos:altLabel>
    <skos:altLabel>Alcohol dependence</skos:altLabel>
    <skos:altLabel>Alcohol abuse</skos:altLabel>
    <skos:altLabel>Harmful alcohol use</skos:altLabel>
    <skos:altLabel>AUD</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000435"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000532">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000533"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000537"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000538"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000534"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000539"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000535"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000536"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Non-randomised</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>An experimental or quasi-experimental study in which participants are allocated to intervention and comparison groups through a process other than randomisation, using statistical methods to control for confounding.</skos:definition>
    <skos:altLabel>Non-randomised study</skos:altLabel>
    <skos:altLabel>Non-randomised controlled study</skos:altLabel>
    <skos:altLabel>Observational quasi-experiment</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000529"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000551">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other study design</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Primary research study designs not captured by the specific categories of descriptive, observational, experimental, qualitative, or modelling designs.</skos:definition>
    <skos:altLabel>Other design</skos:altLabel>
    <skos:altLabel>Other primary study design</skos:altLabel>
    <skos:altLabel>Unclassified study design</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000167"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000150">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Rainforest</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Dense tropical forests characterised by high biodiversity and rainfall, playing a critical role in global carbon cycling and increasingly threatened by deforestation and drought.</skos:definition>
    <skos:altLabel>Tropical forest</skos:altLabel>
    <skos:altLabel>Jungle</skos:altLabel>
    <skos:altLabel>Amazon</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000301">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Chronic respiratory diseases mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths attributable to chronic conditions of the respiratory tract, including chronic obstructive pulmonary disease and asthma.</skos:definition>
    <skos:altLabel>Respiratory disease mortality</skos:altLabel>
    <skos:altLabel>COPD mortality</skos:altLabel>
    <skos:altLabel>Asthma mortality</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000298"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000398">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Chronic obstructive pulmonary disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A progressive, non-reversible obstructive lung disease characterised by persistent airflow limitation, associated with tobacco smoke, indoor and outdoor air pollution, and occupational exposures.</skos:definition>
    <skos:scopeNote>GBD ref: 509</skos:scopeNote>
    <skos:altLabel>COPD</skos:altLabel>
    <skos:altLabel>Emphysema</skos:altLabel>
    <skos:altLabel>Chronic bronchitis</skos:altLabel>
    <skos:altLabel>Obstructive airways disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000397"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/fossil-fuels/DSNY000620">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Coal</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/fossil-fuels"/>
    <skos:definition>A solid fossil fuel formed from ancient plant matter, the most carbon-intensive energy source and a major contributor to greenhouse gas emissions and air pollution.</skos:definition>
    <skos:altLabel>Hard coal</skos:altLabel>
    <skos:altLabel>Brown coal</skos:altLabel>
    <skos:altLabel>Lignite</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000110"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000111"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000109"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000108"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000578"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Mitigation behaviours</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Voluntary or encouraged changes in individual and household behaviour that reduce greenhouse gas emissions across key consumption domains.</skos:definition>
    <skos:altLabel>Mitigation behaviours</skos:altLabel>
    <skos:altLabel>Low-carbon behaviours</skos:altLabel>
    <skos:altLabel>Emission-reducing behaviours</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000097"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000093">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000095"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000096"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000094"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Technology / infrastructure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Physical systems, equipment, and built infrastructure deployed to address environmental, social, or economic challenges, including systems designed to reduce emissions, improve resilience, or support service delivery.</skos:definition>
    <skos:altLabel>Climate technology</skos:altLabel>
    <skos:altLabel>Infrastructure solutions</skos:altLabel>
    <skos:altLabel>Technical measures</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000234">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Disabled (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Individuals with physical, sensory, cognitive, or mental impairments that limit daily functioning and may increase exposure to harm and reduce capacity to respond to environmental or social stressors.</skos:definition>
    <skos:altLabel>People with disabilities</skos:altLabel>
    <skos:altLabel>Disability</skos:altLabel>
    <skos:altLabel>Physically disabled</skos:altLabel>
    <skos:altLabel>Functionally impaired</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-gender-sex/DSNY000247">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Male</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-gender-sex"/>
    <skos:definition>Individuals identified as male by biological sex or gender identity, used to stratify health data or describe sex-specific biological and social health determinants.</skos:definition>
    <skos:altLabel>Men</skos:altLabel>
    <skos:altLabel>Boys</skos:altLabel>
    <skos:altLabel>Male sex</skos:altLabel>
    <skos:altLabel>Males</skos:altLabel>
    <skos:altLabel>Men and boys</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000429">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Autism spectrum disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A neurodevelopmental condition characterised by persistent difficulties in social communication and interaction alongside restricted, repetitive patterns of behaviour.</skos:definition>
    <skos:scopeNote>GBD ref: 575</skos:scopeNote>
    <skos:altLabel>ASD</skos:altLabel>
    <skos:altLabel>Autism</skos:altLabel>
    <skos:altLabel>Asperger syndrome</skos:altLabel>
    <skos:altLabel>Autistic spectrum disorder</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000423"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000453">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Pruritus</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A chronic or recurrent sensation of itching without a primary skin lesion, often associated with systemic disease, dry skin, or neuropathic conditions.</skos:definition>
    <skos:scopeNote>GBD ref: 663</skos:scopeNote>
    <skos:altLabel>Itch</skos:altLabel>
    <skos:altLabel>Itching</skos:altLabel>
    <skos:altLabel>Chronic pruritus</skos:altLabel>
    <skos:altLabel>Generalised itch</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000473">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Falls</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injuries resulting from a person falling from one level to another or on the same level, including fractures, head injuries, and soft tissue trauma.</skos:definition>
    <skos:scopeNote>GBD ref: 697</skos:scopeNote>
    <skos:altLabel>Fall injury</skos:altLabel>
    <skos:altLabel>Accidental fall</skos:altLabel>
    <skos:altLabel>Slip and fall</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000472"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000561">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Waste management / circular economy</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Sanitation and waste management systems that reduce methane emissions and disease vectors, including circular economy approaches that minimise waste generation and improve resource recovery.</skos:definition>
    <skos:altLabel>Waste management</skos:altLabel>
    <skos:altLabel>Circular economy</skos:altLabel>
    <skos:altLabel>Sanitation systems</skos:altLabel>
    <skos:altLabel>Methane capture</skos:altLabel>
    <skos:altLabel>Waste reduction</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000094"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000270">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Loss of place attachment / cultural identity (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Psychological and social harm arising from disruption to a sense of belonging, cultural heritage, and connection to land or community — particularly relevant to indigenous and displaced populations.</skos:definition>
    <skos:altLabel>Cultural identity loss</skos:altLabel>
    <skos:altLabel>Place attachment</skos:altLabel>
    <skos:altLabel>Solastalgia</skos:altLabel>
    <skos:altLabel>Cultural disruption</skos:altLabel>
    <skos:altLabel>Loss of homeland</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000267"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000461">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Musculoskeletal disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Diseases of bones, joints, muscles, and connective tissue, including osteoarthritis, rheumatoid arthritis, osteoporosis, and low back and neck pain.</skos:definition>
    <skos:scopeNote>GBD ref: 626</skos:scopeNote>
    <skos:altLabel>Arthritis</skos:altLabel>
    <skos:altLabel>Bone and joint disease</skos:altLabel>
    <skos:altLabel>Rheumatic disease</skos:altLabel>
    <skos:altLabel>Osteoarthritis</skos:altLabel>
    <skos:altLabel>Osteoporosis</skos:altLabel>
    <skos:altLabel>Back pain</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000377"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000379">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Tracheal, bronchus, and lung cancer</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Malignant tumours arising in the trachea, bronchi, or lung parenchyma, strongly associated with tobacco smoking and air pollution exposure.</skos:definition>
    <skos:scopeNote>GBD ref: 426</skos:scopeNote>
    <skos:altLabel>Lung cancer</skos:altLabel>
    <skos:altLabel>Bronchial cancer</skos:altLabel>
    <skos:altLabel>NSCLC</skos:altLabel>
    <skos:altLabel>Small cell lung cancer</skos:altLabel>
    <skos:altLabel>Tracheal cancer</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000378"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000548">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Microsimulation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A modelling approach simulating the behaviour and outcomes of individual units — people, households, or firms — over time to estimate aggregate population-level effects of policies or exposures.</skos:definition>
    <skos:altLabel>Individual-level simulation</skos:altLabel>
    <skos:altLabel>Agent-based microsimulation</skos:altLabel>
    <skos:altLabel>Micro-level simulation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000545"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000334">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>African trypanosomiasis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A vector-borne parasitic disease caused by Trypanosoma brucei, transmitted by tsetse flies, causing progressive neurological deterioration if untreated.</skos:definition>
    <skos:scopeNote>GBD ref: 350</skos:scopeNote>
    <skos:altLabel>Sleeping sickness</skos:altLabel>
    <skos:altLabel>HAT</skos:altLabel>
    <skos:altLabel>Human African trypanosomiasis</skos:altLabel>
    <skos:altLabel>Trypanosoma brucei</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000526">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>(Controlled) interrupted time series</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A time series analysis comparing outcome trends before and after an intervention or exposure in both an intervention group and a concurrent control group, strengthening causal inference over uncontrolled ITS.</skos:definition>
    <skos:altLabel>Controlled ITS</skos:altLabel>
    <skos:altLabel>ITS (controlled)</skos:altLabel>
    <skos:altLabel>Controlled interrupted time series</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000522"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000359">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Measles</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A highly contagious viral infection caused by measles morbillivirus, preventable by vaccination and causing fever, rash, and serious complications including pneumonia and encephalitis.</skos:definition>
    <skos:scopeNote>GBD ref: 341</skos:scopeNote>
    <skos:altLabel>Rubeola</skos:altLabel>
    <skos:altLabel>Morbillivirus</skos:altLabel>
    <skos:altLabel>Measles virus</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000353"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements/DSNY000512">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Slums / favelas</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Dense informal urban settlements characterised by substandard housing, insecure tenure, limited access to clean water and sanitation, overcrowding, and social marginalisation, known by varied local names including favelas, bidonvilles, katchi abadis, and shanty towns.</skos:definition>
    <skos:altLabel>Slums</skos:altLabel>
    <skos:altLabel>Favelas</skos:altLabel>
    <skos:altLabel>Shanty towns</skos:altLabel>
    <skos:altLabel>Bidonvilles</skos:altLabel>
    <skos:altLabel>Shack settlements</skos:altLabel>
    <skos:altLabel>Katchi abadis</skos:altLabel>
    <skos:altLabel>Bustees</skos:altLabel>
    <skos:altLabel>Gecekondus</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000511"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000560">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Sustainable food systems</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Low-emission agricultural technologies and food production systems, including plant-based food production, sustainable land management, and infrastructure for reducing food loss and waste.</skos:definition>
    <skos:altLabel>Sustainable agriculture</skos:altLabel>
    <skos:altLabel>Plant-based food systems</skos:altLabel>
    <skos:altLabel>Low-emission food production</skos:altLabel>
    <skos:altLabel>Food waste reduction</skos:altLabel>
    <skos:altLabel>Sustainable diets infrastructure</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000094"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000535">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Regression discontinuity</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A quasi-experimental design exploiting a threshold in a continuous assignment variable to estimate causal effects for units just above and below the cutoff, where assignment is effectively random.</skos:definition>
    <skos:altLabel>RD design</skos:altLabel>
    <skos:altLabel>Regression discontinuity design</skos:altLabel>
    <skos:altLabel>RDD</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000532"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/extreme-weather-events/DSNY000609">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Storms</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/extreme-weather-events"/>
    <skos:definition>Intense meteorological events including tropical cyclones, hurricanes, typhoons, and severe thunderstorms, causing wind damage, flooding, and displacement.</skos:definition>
    <skos:altLabel>Cyclones</skos:altLabel>
    <skos:altLabel>Hurricanes</skos:altLabel>
    <skos:altLabel>Typhoons</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000263">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Food supply and safety (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Disruptions or changes to the availability, accessibility, and safety of food, including impacts on nutrition, foodborne pathogen risk, and agricultural productivity.</skos:definition>
    <skos:scopeNote>As atmospheric levels of CO2 increase, the nutritional value (protein and essential minerals) of vital food crops is impacted. Warmer temperatures and more extreme weather can also impair food safety (as climate-sensitive pathogens cause foodborne illness and chemical contamination) and distribution (e.g. by disrupting transportation). Food security (crop yields) can be affected by droughts and other extreme weather events, especially when related to essential crops (e.g. staple foods: cereals, grains, roots/tubers, legumes).

Examples of health impacts: undernutrition, salmonella food poisoning and other foodborne diseases, mycotoxin effects, diarrhoea (E.coli), diarrhoea (V. cholerae).
</skos:scopeNote>
    <skos:altLabel>Food security</skos:altLabel>
    <skos:altLabel>Food safety</skos:altLabel>
    <skos:altLabel>Nutritional availability</skos:altLabel>
    <skos:altLabel>Food system disruption</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000304">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Other non-communicable diseases mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths attributable to non-communicable diseases not classified under the major NCD categories of cardiovascular, respiratory, neoplastic, or metabolic disease.</skos:definition>
    <skos:altLabel>Other NCD mortality</skos:altLabel>
    <skos:altLabel>Other non-communicable mortality</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000298"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000559">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Energy-efficiency</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Technologies and infrastructure that reduce energy consumption, including energy-efficient appliances, green buildings, housing insulation, and retrofits that reduce heating and cooling energy demand.</skos:definition>
    <skos:altLabel>Energy efficiency</skos:altLabel>
    <skos:altLabel>Green buildings</skos:altLabel>
    <skos:altLabel>Building insulation</skos:altLabel>
    <skos:altLabel>Housing retrofit</skos:altLabel>
    <skos:altLabel>Energy-efficient infrastructure</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000094"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000326">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cholera</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>An acute diarrhoeal illness caused by the bacterium Vibrio cholerae, typically transmitted through contaminated water and capable of causing rapid dehydration and death.</skos:definition>
    <skos:scopeNote>REI ref: 173</skos:scopeNote>
    <skos:altLabel>Vibrio cholerae</skos:altLabel>
    <skos:altLabel>Epidemic cholera</skos:altLabel>
    <skos:altLabel>Acute watery diarrhoea</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000325"/>
  </rdf:Description>
