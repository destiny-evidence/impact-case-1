  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000480">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Foreign body</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injury caused by a foreign object entering the body through ingestion, aspiration, or direct penetration of a body cavity or tissue.</skos:definition>
    <skos:scopeNote>GBD ref: 712</skos:scopeNote>
    <skos:altLabel>Foreign object</skos:altLabel>
    <skos:altLabel>Aspiration</skos:altLabel>
    <skos:altLabel>Choking</skos:altLabel>
    <skos:altLabel>Ingestion of foreign body</skos:altLabel>
