    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>A component of the Global Burden of Disease framework measuring the years of healthy life lost due to living with a non-fatal disease or disability, weighted by severity.</skos:definition>
