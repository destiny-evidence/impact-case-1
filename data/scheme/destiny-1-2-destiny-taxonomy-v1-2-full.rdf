    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000489"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000486"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Self-harm and interpersonal violence</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Intentional injuries caused by violence directed at oneself or others, including self-harm, assault, sexual violence, and conflict-related injuries.</skos:definition>
