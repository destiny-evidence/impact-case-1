  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000563">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other mitigation technologies / infrastructure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Mitigation technologies and infrastructure not classified under the specific categories of clean energy, transport, energy efficiency, food systems, waste management, or carbon capture.</skos:definition>
    <skos:altLabel>Other mitigation technology</skos:altLabel>
    <skos:altLabel>Other low-carbon technology</skos:altLabel>
    <skos:altLabel>Other decarbonisation infrastructure</skos:altLabel>
