  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000470">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>N.3.4 Injuries</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Physical harm to the body resulting from external causes, including unintentional injuries, self-harm, interpersonal violence, and conflict.</skos:definition>
