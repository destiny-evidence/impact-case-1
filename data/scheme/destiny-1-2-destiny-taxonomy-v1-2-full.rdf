    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000276"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000277"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000279"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000280"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000278"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Death (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>Metrics quantifying fatal health outcomes, including overall and cause-specific death rates across populations.</skos:definition>
    <skos:altLabel>Mortality</skos:altLabel>
    <skos:altLabel>Fatal outcomes</skos:altLabel>
    <skos:altLabel>Death outcomes</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000146">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Island</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Land masses surrounded by water, particularly small island developing states, which face existential threats from sea level rise, coastal erosion, and increased storm intensity.</skos:definition>
    <skos:altLabel>Small island</skos:altLabel>
    <skos:altLabel>Island state</skos:altLabel>
    <skos:altLabel>Archipelago</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000366">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Maternal abortion and miscarriage</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>The spontaneous or induced termination of pregnancy before viability, including miscarriage, unsafe abortion, and related complications.</skos:definition>
    <skos:scopeNote>GBD ref: 995</skos:scopeNote>
    <skos:altLabel>Miscarriage</skos:altLabel>
    <skos:altLabel>Abortion</skos:altLabel>
    <skos:altLabel>Pregnancy loss</skos:altLabel>
    <skos:altLabel>Spontaneous abortion</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000365"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age/DSNY000259">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Aged (65-78 years)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Older adults aged 65 to 78 years, often retaining significant functional capacity but with increasing chronic disease burden and growing vulnerability to environmental stressors.</skos:definition>
    <skos:altLabel>Younger elderly</skos:altLabel>
    <skos:altLabel>Young old</skos:altLabel>
    <skos:altLabel>65 to 78 year olds</skos:altLabel>
    <skos:altLabel>Early older age</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000258"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000562">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Carbon capture</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Engineered systems that capture CO₂ from point sources or directly from the atmosphere and store it permanently, including carbon capture and storage (CCS) and direct air capture technologies.</skos:definition>
    <skos:altLabel>CCS</skos:altLabel>
    <skos:altLabel>Carbon capture and storage</skos:altLabel>
    <skos:altLabel>Carbon removal</skos:altLabel>
    <skos:altLabel>Direct air capture</skos:altLabel>
    <skos:altLabel>BECCS</skos:altLabel>
    <skos:altLabel>Engineered carbon removal</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000094"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements/DSNY000511">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Informal settlements</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Residential areas characterised by lack of secure land tenure, inadequate infrastructure, poor access to basic services such as water, sanitation, and healthcare, and overcrowding. This category is intentionally broad, encompassing the diverse forms of unplanned or unauthorised settlement that develop on the periphery of formal cities, without relying on contested administrative labels that vary by country.</skos:definition>
    <skos:altLabel>Unplanned settlements</skos:altLabel>
    <skos:altLabel>Unauthorised settlements</skos:altLabel>
    <skos:altLabel>Squatter settlements</skos:altLabel>
    <skos:altLabel>Unregulated settlements</skos:altLabel>
    <skos:altLabel>Urban informality</skos:altLabel>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000513"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000512"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000514"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000109">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Behaviour related to households</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Actions taken at the household level to reduce energy consumption and associated emissions, including reducing heating and cooling use, improving insulation, and adopting lower-emission energy sources.</skos:definition>
    <skos:altLabel>Home energy behaviour</skos:altLabel>
    <skos:altLabel>Residential energy use</skos:altLabel>
    <skos:altLabel>Housing consumption behaviour</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000141">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Rural</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Sparsely populated areas outside urban centres, often reliant on agriculture and natural resources, and facing distinct climate risks including drought, flooding, and reduced service access.</skos:definition>
    <skos:altLabel>Countryside</skos:altLabel>
    <skos:altLabel>Non-urban</skos:altLabel>
    <skos:altLabel>Agricultural land</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000375">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Dietary iron deficiency</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Insufficient dietary iron intake leading to iron deficiency anaemia, impairing oxygen transport, cognitive development, and immune function.</skos:definition>
    <skos:scopeNote>GBD ref: 390</skos:scopeNote>
    <skos:altLabel>Iron deficiency anaemia</skos:altLabel>
    <skos:altLabel>IDA</skos:altLabel>
    <skos:altLabel>Iron deficiency</skos:altLabel>
    <skos:altLabel>Anaemia</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000370"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/extreme-weather-events/DSNY000607">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Extreme heat</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/extreme-weather-events"/>
    <skos:definition>Periods of abnormally high temperatures, including heatwaves, that pose direct health risks such as heat exhaustion, heat stroke, and excess mortality.</skos:definition>
    <skos:altLabel>Heatwaves</skos:altLabel>
    <skos:altLabel>Heat events</skos:altLabel>
    <skos:altLabel>High temperature extremes</skos:altLabel>
    <skos:altLabel>Heat waves</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000566">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Digital / data-based technology / infrastructure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Digital tools and data infrastructure supporting climate-health surveillance and response, including remote sensing, climate-health surveillance platforms, vector surveillance systems, and early warning and forecasting systems for climate-sensitive health risks.</skos:definition>
    <skos:altLabel>Early warning systems</skos:altLabel>
    <skos:altLabel>Remote sensing</skos:altLabel>
    <skos:altLabel>Climate surveillance</skos:altLabel>
    <skos:altLabel>Vector surveillance</skos:altLabel>
    <skos:altLabel>Climate-health data systems</skos:altLabel>
    <skos:altLabel>Health forecasting</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000095"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000346">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Leprosy</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A chronic bacterial infection caused by Mycobacterium leprae, affecting the skin, peripheral nerves, and mucous membranes, and historically associated with significant stigma.</skos:definition>
    <skos:scopeNote>GBD ref: 405</skos:scopeNote>
    <skos:altLabel>Hansen's disease</skos:altLabel>
    <skos:altLabel>Mycobacterium leprae</skos:altLabel>
    <skos:altLabel>Leprosy disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000120">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Healthcare (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector providing medical care, public health services, and health infrastructure, including hospitals, primary care, and preventive health services.</skos:definition>
    <skos:altLabel>Health sector</skos:altLabel>
    <skos:altLabel>Medical services</skos:altLabel>
    <skos:altLabel>Health systems</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000457">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000459"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000458"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000460"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Sense organ diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Diseases affecting the organs of vision and hearing, including conditions causing visual impairment, blindness, and hearing loss.</skos:definition>
    <skos:scopeNote>GBD ref: 669</skos:scopeNote>
    <skos:altLabel>Eye and ear diseases</skos:altLabel>
    <skos:altLabel>Sensory diseases</skos:altLabel>
    <skos:altLabel>Visual and hearing disorders</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000377"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000614">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Fluorinated gases / hydrofluorocarbons / perfluorocarbons / sulfur hexafluoride / nitrogen trifluoride</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents"/>
    <skos:definition>A group of potent synthetic greenhouse gases used in industrial applications, refrigeration, and electronics manufacturing, with very high global warming potentials and long atmospheric lifetimes.</skos:definition>
    <skos:altLabel>F-gases</skos:altLabel>
    <skos:altLabel>HFCs</skos:altLabel>
    <skos:altLabel>Synthetic greenhouse gases</skos:altLabel>
    <skos:altLabel>PFCs</skos:altLabel>
    <skos:altLabel>SF6</skos:altLabel>
    <skos:altLabel>NF3</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/reference-type/DSNY000627">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Article (academic journal)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/reference-type"/>
    <skos:definition>A peer-reviewed research output published in an academic journal, including full research articles, letters to the editor, commentaries, and opinion pieces.</skos:definition>
    <skos:scopeNote>Full publication, letter, comment, opinion, published in a scientific journal. Protocols, even though published as a journal article, are not classified into this concept, but under "Planned research".</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000352">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Zz_Other neglected tropical diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Neglected tropical diseases not classified under specific GBD sub-categories, including other parasitic and bacterial infections endemic to tropical regions.</skos:definition>
    <skos:scopeNote>GBD ref: 365</skos:scopeNote>
    <skos:altLabel>Other NTDs</skos:altLabel>
    <skos:altLabel>Other tropical diseases</skos:altLabel>
    <skos:altLabel>Unclassified tropical diseases</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000527">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Experimental / single-group designs</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Experimental study designs in which an intervention is applied to a single group without a concurrent control group, limiting but not eliminating causal inference.</skos:definition>
    <skos:altLabel>Single-arm experimental design</skos:altLabel>
    <skos:altLabel>Uncontrolled experimental design</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000167"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000528"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000285">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Disability-adjusted life years (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>A summary measure of population health combining years of life lost to premature death (YLL) and years lived with disability (YLD), representing the total burden of disease.</skos:definition>
    <skos:altLabel>DALY</skos:altLabel>
    <skos:altLabel>DALYs</skos:altLabel>
    <skos:altLabel>Disability-adjusted life year</skos:altLabel>
    <skos:altLabel>Burden of disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000281"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000584">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Research / knowledge systems / education</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Research infrastructure, knowledge translation systems, and educational programmes that build understanding of risks and promote evidence-informed decision-making and behaviour change at individual or community level.</skos:definition>
    <skos:altLabel>Knowledge translation</skos:altLabel>
    <skos:altLabel>Research infrastructure</skos:altLabel>
    <skos:altLabel>Public education</skos:altLabel>
    <skos:altLabel>Capacity building</skos:altLabel>
    <skos:altLabel>Information dissemination</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000114"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000489">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Police conflict and executions</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths and injuries resulting from the use of force by law enforcement or state actors, including fatal police encounters and state-sanctioned executions.</skos:definition>
    <skos:scopeNote>GBD ref: 854</skos:scopeNote>
