  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/governance-scale/DSNY000230">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Sub-national - regional (Governance scale)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/governance-scale"/>
    <skos:definition>Governance at the level of regions or provinces within a single country, such as states, counties, or devolved administrations with defined policy responsibilities.</skos:definition>
    <skos:altLabel>Province</skos:altLabel>
    <skos:altLabel>Devolved region</skos:altLabel>
    <skos:altLabel>Administrative region</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000549">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Other climate-related modelling / simulation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Climate or environmental modelling and simulation approaches not classified under IAM, CGE, or microsimulation, including downscaled climate models, exposure models, and environmental simulation tools.</skos:definition>
    <skos:altLabel>Other climate modelling</skos:altLabel>
    <skos:altLabel>Climate simulation</skos:altLabel>
    <skos:altLabel>Environmental modelling</skos:altLabel>
    <skos:altLabel>Downscaled climate model</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000545"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000396">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other cardiovascular and circulatory diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Cardiovascular and circulatory diseases not elsewhere classified in the GBD framework, including peripheral vascular conditions and miscellaneous cardiac disorders.</skos:definition>
    <skos:scopeNote>GBD ref: 507</skos:scopeNote>
    <skos:altLabel>Other heart disease</skos:altLabel>
    <skos:altLabel>Other circulatory disease</skos:altLabel>
    <skos:altLabel>Other CVD</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000105">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Migration</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Movement of individuals or communities away from areas made uninhabitable or highly hazardous by climate change, including both voluntary relocation and forced displacement.</skos:definition>
    <skos:scopeNote>Refers to migration as a deliberate adaptive behaviour in response to climate hazards — the act of relocating as a coping or protective strategy. Distinct from 'Migrants' in the Population scheme, which classifies people who have migrated as a potentially vulnerable population group.</skos:scopeNote>
    <skos:altLabel>Climate migration</skos:altLabel>
    <skos:altLabel>Relocation</skos:altLabel>
    <skos:altLabel>Displacement</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000154">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Wetland / peatland</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Low-lying ecosystems saturated with water, including marshes, swamps, and peatlands, which serve as important carbon stores and biodiversity habitats, threatened by drainage and climate change.</skos:definition>
    <skos:altLabel>Marsh</skos:altLabel>
    <skos:altLabel>Swamp</skos:altLabel>
    <skos:altLabel>Bog</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000261">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Heat stress (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Physiological strain placed on the body by elevated ambient temperature and humidity, impairing thermoregulation and increasing the risk of heat-related illness.</skos:definition>
    <skos:scopeNote>As the planet warms, heat waves are becoming more frequent and lasting longer — placing people at increased risk for heat-related illnesses such as heat stroke. Heat-related illness can be seen at temperatures much lower than those characteristic of a heat wave. Health impacts: heat-related illness and death.
</skos:scopeNote>
    <skos:altLabel>Thermal stress</skos:altLabel>
    <skos:altLabel>Heat exposure</skos:altLabel>
    <skos:altLabel>Extreme heat</skos:altLabel>
    <skos:altLabel>Heatwave exposure</skos:altLabel>
    <skos:altLabel>Thermal load</skos:altLabel>
    <skos:altLabel>Thermal comfort</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000287">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000289"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000291"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000288"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000292"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000290"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Healthcare utilisation (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>Metrics quantifying the use of healthcare services, including primary, secondary, and emergency care, as indicators of health system demand and population health need.</skos:definition>
    <skos:altLabel>Health service use</skos:altLabel>
    <skos:altLabel>Healthcare use</skos:altLabel>
    <skos:altLabel>Health services utilisation</skos:altLabel>
    <skos:altLabel>Medical care use</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000572">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>High-emission agricultural infrastructure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Agricultural systems with high greenhouse gas footprints, including intensive livestock operations, synthetic fertiliser supply chains, and irrigation systems with large energy demands.</skos:definition>
    <skos:altLabel>Intensive livestock</skos:altLabel>
    <skos:altLabel>Synthetic fertilisers</skos:altLabel>
    <skos:altLabel>High-emission farming</skos:altLabel>
    <skos:altLabel>Irrigation infrastructure</skos:altLabel>
    <skos:altLabel>Industrial agriculture</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000096"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000089">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Fiscal / incentive policy</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Market-based and fiscal mechanisms such as carbon taxes, emissions trading schemes, and subsidies used to incentivise emissions reductions or climate adaptation investments.
</skos:definition>
    <skos:altLabel>Carbon pricing</skos:altLabel>
    <skos:altLabel>Economic incentives</skos:altLabel>
    <skos:altLabel>Financial instruments</skos:altLabel>
    <skos:altLabel>Economic instruments</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000438">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000443"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000439"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000440"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Diabetes and kidney diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A GBD grouping encompassing diabetes mellitus and kidney diseases, which share common metabolic risk factors and frequently co-occur.</skos:definition>
    <skos:scopeNote>GBD ref: 974</skos:scopeNote>
    <skos:altLabel>Diabetes and renal disease</skos:altLabel>
    <skos:altLabel>Metabolic and kidney disease</skos:altLabel>
