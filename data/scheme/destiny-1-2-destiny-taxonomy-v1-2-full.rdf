    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Study designs using qualitative data collection and analysis, or combining qualitative and quantitative approaches, to explore meanings, experiences, and contextual factors.</skos:definition>
    <skos:altLabel>Qualitative research</skos:altLabel>
    <skos:altLabel>Qualitative design</skos:altLabel>
