    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>N.3.2 Communicable, maternal, neonatal, and nutritional diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>The broad category of diseases caused by infectious agents or related to maternal, neonatal, and nutritional conditions, as defined in the GBD cause hierarchy.</skos:definition>
    <skos:scopeNote>GBD ref: 295</skos:scopeNote>
    <skos:altLabel>CMNN diseases</skos:altLabel>
    <skos:altLabel>Communicable diseases</skos:altLabel>
    <skos:altLabel>Infectious and nutritional diseases</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/topic/DSNY000053">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000054"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000493"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000492"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Impact</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/topic"/>
    <skos:definition>The effects of climate change on natural and human systems, including consequences for health, ecosystems, economies, and societies resulting from climate variability and change.</skos:definition>
    <skos:altLabel>Climate impact</skos:altLabel>
    <skos:altLabel>Climate effects</skos:altLabel>
    <skos:altLabel>Climate consequences</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000517">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cross-sectional / single-round survey</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A study design that collects data from a population at a single point in time, describing the prevalence of exposures and outcomes without follow-up.</skos:definition>
    <skos:altLabel>Cross-sectional study</skos:altLabel>
    <skos:altLabel>Prevalence study</skos:altLabel>
    <skos:altLabel>Survey study</skos:altLabel>
    <skos:altLabel>Single-round survey</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000515"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000501">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Delta / floodplain</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Low-lying landforms formed by sediment deposition at river mouths or along river corridors, characterised by high agricultural productivity and biodiversity but acute vulnerability to flooding, sea-level rise, and storm surge.</skos:definition>
    <skos:altLabel>River delta</skos:altLabel>
    <skos:altLabel>Floodplain</skos:altLabel>
    <skos:altLabel>Alluvial plain</skos:altLabel>
    <skos:altLabel>Deltaic region</skos:altLabel>
    <skos:altLabel>Flood zone</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000296">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000305"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000298"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000297"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>N.3.1 Mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>The occurrence of death as a health outcome, classified by cause, age group, and population to characterise the fatal burden of disease.</skos:definition>
    <skos:altLabel>Death</skos:altLabel>
    <skos:altLabel>Fatal outcomes</skos:altLabel>
    <skos:altLabel>Mortality outcomes</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000103">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Learning</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Acquiring knowledge and skills that enable individuals and communities to understand risks, make informed decisions, and adapt their behaviours and livelihoods accordingly.</skos:definition>
    <skos:altLabel>Skill acquisition</skos:altLabel>
    <skos:altLabel>Knowledge building</skos:altLabel>
    <skos:altLabel>Capacity building</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000407">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Appendicitis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Acute inflammation of the appendix, presenting with right iliac fossa pain and requiring surgical intervention to prevent perforation and peritonitis.</skos:definition>
    <skos:scopeNote>GBD ref: 529</skos:scopeNote>
    <skos:altLabel>Acute appendicitis</skos:altLabel>
    <skos:altLabel>Appendix inflammation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/actors">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>H. Actors</dct:title>
    <dct:description>The types of organisations and individuals involved in climate change action, governance, research, and implementation.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/actors/DSNY000165"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/actors/DSNY000163"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/actors/DSNY000166"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/actors/DSNY000164"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/actors/DSNY000162"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements/DSNY000506">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Towns</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Formal urban settlements with a population of fewer than 100,000 inhabitants, typically characterised by local administrative functions, mixed economies, and partial urban service provision.</skos:definition>
    <skos:altLabel>Small towns</skos:altLabel>
    <skos:altLabel>Market towns</skos:altLabel>
    <skos:altLabel>Urban towns</skos:altLabel>
    <skos:altLabel>Small urban centres</skos:altLabel>
    <skos:altLabel>Under 100,000</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000505"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000406">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Upper digestive system diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Diseases affecting the oesophagus, stomach, and duodenum, including peptic ulcer disease, gastro-oesophageal reflux disease, and gastritis.</skos:definition>
    <skos:scopeNote>GBD ref: 992</skos:scopeNote>
    <skos:altLabel>Peptic ulcer disease</skos:altLabel>
    <skos:altLabel>GORD</skos:altLabel>
    <skos:altLabel>Gastro-oesophageal reflux</skos:altLabel>
    <skos:altLabel>Gastric ulcer</skos:altLabel>
    <skos:altLabel>Oesophageal disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000500">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Peri-urban</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>The transitional zone at the interface between urban and rural areas, characterised by mixed land use, rapid development, and populations that may lack full access to urban services while facing environmental pressures from adjacent cities.</skos:definition>
    <skos:altLabel>Peri-urban area</skos:altLabel>
    <skos:altLabel>Urban fringe</skos:altLabel>
    <skos:altLabel>Urban periphery</skos:altLabel>
    <skos:altLabel>Suburban fringe</skos:altLabel>
    <skos:altLabel>City outskirts</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000405">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cirrhosis and other chronic liver diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Progressive scarring and fibrosis of the liver resulting from chronic injury, including viral hepatitis, alcohol use, and non-alcoholic fatty liver disease, ultimately causing liver failure.</skos:definition>
    <skos:scopeNote>GBD ref: 521</skos:scopeNote>
    <skos:altLabel>Liver cirrhosis</skos:altLabel>
    <skos:altLabel>Chronic liver disease</skos:altLabel>
    <skos:altLabel>Hepatic fibrosis</skos:altLabel>
    <skos:altLabel>Liver disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000356">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Diphtheria</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A vaccine-preventable bacterial infection caused by Corynebacterium diphtheriae, producing a toxin that causes a characteristic pharyngeal membrane and life-threatening airway obstruction and cardiac complications.</skos:definition>
    <skos:scopeNote>GBD ref: 338</skos:scopeNote>
    <skos:altLabel>Corynebacterium diphtheriae</skos:altLabel>
    <skos:altLabel>Diphtheria infection</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000353"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000343">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Rabies</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A fatal viral encephalitis caused by lyssavirus, transmitted through the bite of infected animals, almost universally fatal once clinical symptoms develop.</skos:definition>
    <skos:scopeNote>GBD ref: 359</skos:scopeNote>
    <skos:altLabel>Rabies virus</skos:altLabel>
    <skos:altLabel>Hydrophobia</skos:altLabel>
    <skos:altLabel>Lyssavirus</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000495">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Farmland</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Land used for agricultural production including arable crops, pasture, and mixed farming systems, representing a key interface between environmental conditions and food security.</skos:definition>
    <skos:altLabel>Agricultural land</skos:altLabel>
    <skos:altLabel>Cropland</skos:altLabel>
    <skos:altLabel>Arable land</skos:altLabel>
    <skos:altLabel>Pasture</skos:altLabel>
    <skos:altLabel>Agricultural area</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000371">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Childhood stunting and wasting</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Growth faltering in children due to chronic undernutrition (stunting: low height-for-age) or acute undernutrition (wasting: low weight-for-height), with serious consequences for development and survival.</skos:definition>
    <skos:scopeNote>REI ref: 240/241</skos:scopeNote>
    <skos:altLabel>Child stunting</skos:altLabel>
    <skos:altLabel>Child wasting</skos:altLabel>
    <skos:altLabel>Stunting</skos:altLabel>
    <skos:altLabel>Wasting</skos:altLabel>
    <skos:altLabel>Acute malnutrition</skos:altLabel>
    <skos:altLabel>Chronic malnutrition</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000370"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000122">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Industry / trade / services (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector encompassing manufacturing, retail, wholesale trade, and commercial services.</skos:definition>
    <skos:altLabel>Commerce</skos:altLabel>
    <skos:altLabel>Manufacturing</skos:altLabel>
    <skos:altLabel>Trade</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000353">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000361"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000356"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000355"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000362"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000359"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000354"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000357"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000358"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000360"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000363"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other infectious diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infectious diseases not classified under respiratory, enteric, or vector-borne categories, including bacterial, viral, and prion conditions of diverse transmission routes.</skos:definition>
    <skos:scopeNote>GBD ref: 961</skos:scopeNote>
    <skos:altLabel>Other infections</skos:altLabel>
    <skos:altLabel>Miscellaneous infections</skos:altLabel>
    <skos:altLabel>Other infectious diseases</skos:altLabel>
