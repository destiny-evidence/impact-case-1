  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000224">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Military (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The military sector is the part of a country’s economy and government responsible for producing, organizing, and maintaining armed forces and defense capabilities, including personnel, equipment, operations, and infrastrucutre.
</skos:definition>
