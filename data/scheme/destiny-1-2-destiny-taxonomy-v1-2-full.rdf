  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000540">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Randomisation unclear</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>An experimental or quasi-experimental study in which the method of allocation to groups is not clearly reported, precluding classification as randomised or non-randomised.</skos:definition>
    <skos:altLabel>Unclear randomisation</skos:altLabel>
    <skos:altLabel>Allocation method unclear</skos:altLabel>
    <skos:altLabel>Randomisation not reported</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000529"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000148">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Ocean / coastal</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Areas where land meets the sea, including coastlines, estuaries, and marine environments, highly exposed to sea level rise, storm surges, and ocean warming.</skos:definition>
    <skos:altLabel>Coast</skos:altLabel>
    <skos:altLabel>Shoreline</skos:altLabel>
    <skos:altLabel>Marine and coastal</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000615">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Methane (CH₄)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents"/>
    <skos:definition>A potent short-lived greenhouse gas emitted from livestock, rice cultivation, landfills, and fossil fuel extraction, with a global warming potential far exceeding that of CO₂ over 20 years.</skos:definition>
    <skos:altLabel>CH4</skos:altLabel>
    <skos:altLabel>Methane emissions</skos:altLabel>
    <skos:altLabel>Natural gas emissions</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000282">
