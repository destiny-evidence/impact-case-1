  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000433">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Post-traumatic stress disorder (PTSD)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A trauma- and stressor-related disorder developing after exposure to actual or threatened death, serious injury, or sexual violence, characterised by intrusive symptoms, avoidance, and hyperarousal.</skos:definition>
    <skos:altLabel>PTSD</skos:altLabel>
    <skos:altLabel>Trauma-related disorder</skos:altLabel>
    <skos:altLabel>Post-traumatic disorder</skos:altLabel>
