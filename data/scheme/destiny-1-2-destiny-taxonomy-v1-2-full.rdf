    <skos:altLabel>OR</skos:altLabel>
    <skos:altLabel>Odds ratio</skos:altLabel>
    <skos:altLabel>Relative risk</skos:altLabel>
    <skos:altLabel>Risk ratio</skos:altLabel>
    <skos:altLabel>Hazard ratio</skos:altLabel>
    <skos:altLabel>HR</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000293"/>
