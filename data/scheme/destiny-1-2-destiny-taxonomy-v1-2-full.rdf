    <skos:prefLabel>Incidence (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The rate at which new cases of a disease or condition occur in a defined population during a specified time period.</skos:definition>
    <skos:altLabel>New cases</skos:altLabel>
    <skos:altLabel>Disease incidence</skos:altLabel>
    <skos:altLabel>Incidence rate</skos:altLabel>
    <skos:altLabel>Attack rate</skos:altLabel>
    <skos:altLabel>Case rate</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000281"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000598">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Changes in humidity</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>Shifts in atmospheric moisture levels that affect thermal comfort, respiratory health, and the prevalence of moisture-related diseases.</skos:definition>
    <skos:altLabel>Humidity change</skos:altLabel>
    <skos:altLabel>Atmospheric moisture change</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000520">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Before-after / pre-post study</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A study that compares outcomes measured in the same group before and after an exposure or intervention, without a concurrent control group.</skos:definition>
    <skos:altLabel>Pre-post study</skos:altLabel>
    <skos:altLabel>Before-after study</skos:altLabel>
    <skos:altLabel>Pre-post comparison</skos:altLabel>
    <skos:altLabel>Pre-post design</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000519"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000126">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Water / sanitation / waste management (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector responsible for water supply, sewage treatment, and solid waste management.</skos:definition>
