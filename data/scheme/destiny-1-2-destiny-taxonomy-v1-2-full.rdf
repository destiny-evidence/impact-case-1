  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000536">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Synthetic control</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A quasi-experimental method constructing a weighted combination of untreated units to serve as a counterfactual for a treated unit, used when only a small number of aggregate units are available.</skos:definition>
    <skos:altLabel>Synthetic control method</skos:altLabel>
    <skos:altLabel>Synthetic comparison group</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000532"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>G. Sectors</dct:title>
    <dct:description>Economic and social sectors relevant to climate change research, mitigation, adaptation, and health impact assessment.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/sectors/DSNY000115"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/sectors/DSNY000116"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/sectors/DSNY000117"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/sectors/DSNY000118"/>
