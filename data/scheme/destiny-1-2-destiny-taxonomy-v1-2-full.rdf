    <skos:altLabel>BCC</skos:altLabel>
    <skos:altLabel>SCC</skos:altLabel>
    <skos:altLabel>Keratinocyte cancer</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000378"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000515">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000516"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000518"/>
