    <skos:prefLabel>Transport injuries</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injuries sustained in road traffic crashes involving motor vehicles, motorcycles, cyclists, and pedestrians.</skos:definition>
    <skos:scopeNote>GBD ref: 688</skos:scopeNote>
    <skos:altLabel>Road traffic injuries</skos:altLabel>
    <skos:altLabel>RTI</skos:altLabel>
    <skos:altLabel>Road traffic accidents</skos:altLabel>
    <skos:altLabel>Motor vehicle accidents</skos:altLabel>
    <skos:altLabel>MVA</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000470"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000365">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000366"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Maternal disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Medical conditions and complications directly related to pregnancy and childbirth, including haemorrhage, hypertensive disorders, obstructed labour, and sepsis.</skos:definition>
    <skos:scopeNote>GBD ref: 366</skos:scopeNote>
    <skos:altLabel>Obstetric complications</skos:altLabel>
    <skos:altLabel>Pregnancy complications</skos:altLabel>
    <skos:altLabel>Maternal conditions</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000364"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000337">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cystic echinococcosis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A zoonotic parasitic disease caused by the larval stage of Echinococcus granulosus tapeworm, producing fluid-filled cysts predominantly in the liver and lungs.</skos:definition>
    <skos:scopeNote>GBD ref: 353</skos:scopeNote>
    <skos:altLabel>Hydatid disease</skos:altLabel>
    <skos:altLabel>Echinococcus granulosus</skos:altLabel>
    <skos:altLabel>Hydatid cyst</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/topic/DSNY000051">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000491"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Mitigation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/topic"/>
    <skos:definition>Actions and strategies aimed at reducing or preventing greenhouse gas emissions in order to limit the magnitude of future climate change and its associated health and environmental impacts.</skos:definition>
    <skos:altLabel>Climate mitigation</skos:altLabel>
    <skos:altLabel>Emissions reduction</skos:altLabel>
    <skos:altLabel>GHG reduction</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000268">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Housing quality / overcrowding (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Exposure to substandard, unsafe, or overcrowded living conditions that increase susceptibility to infectious disease, injury, and mental ill-health.</skos:definition>
    <skos:altLabel>Housing conditions</skos:altLabel>
    <skos:altLabel>Overcrowding</skos:altLabel>
    <skos:altLabel>Substandard housing</skos:altLabel>
    <skos:altLabel>Housing quality</skos:altLabel>
    <skos:altLabel>Household crowding</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000267"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000569">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Other adaptation technologies / infrastructure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Adaptation technologies and infrastructure not classified under the specific categories of water and sanitation, built environment, digital systems, food security, or coastal and flood defence.</skos:definition>
    <skos:altLabel>Other adaptation infrastructure</skos:altLabel>
    <skos:altLabel>Other climate-resilient technology</skos:altLabel>
    <skos:altLabel>Other adaptive infrastructure</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000095"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000144">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Freshwater</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Inland water bodies including rivers, lakes, and streams, whose temperature, flow, and quality are sensitive to climate variability with consequences for drinking water and aquatic health.</skos:definition>
    <skos:altLabel>Rivers and lakes</skos:altLabel>
    <skos:altLabel>Inland water</skos:altLabel>
    <skos:altLabel>Freshwater ecosystems</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/country-income/DSNY000136">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Low</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/country-income"/>
    <skos:definition>Countries classified by the World Bank as having the lowest gross national income per capita, typically facing the greatest climate vulnerability and least adaptive capacity.</skos:definition>
    <skos:altLabel>LIC</skos:altLabel>
    <skos:altLabel>Low-income countries</skos:altLabel>
    <skos:altLabel>Least developed countries</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000088">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>International / multilateral agreements</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Formal binding or non-binding agreements between nations or organisations to coordinate action on climate change, including treaties, protocols, and multilateral accords, e.g. UNFCCC mechanisms, Paris Agreement, WHO frameworks.
</skos:definition>
    <skos:altLabel>Treaties</skos:altLabel>
    <skos:altLabel>International agreements</skos:altLabel>
    <skos:altLabel>Climate accords</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age/DSNY000256">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Adult (19-44 years)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Adults aged 19 to 44 years, typically characterised by peak physical capacity, reproductive activity, and workforce participation.</skos:definition>
    <skos:altLabel>Young adults</skos:altLabel>
    <skos:altLabel>Early adulthood</skos:altLabel>
    <skos:altLabel>Working age</skos:altLabel>
    <skos:altLabel>19 to 44 year olds</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000255"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000277">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Excess / premature mortality (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>Deaths occurring earlier than expected relative to a baseline or reference population, or in excess of background mortality rates during a defined period or event.</skos:definition>
    <skos:altLabel>Premature mortality</skos:altLabel>
    <skos:altLabel>Excess deaths</skos:altLabel>
    <skos:altLabel>Avoidable mortality</skos:altLabel>
    <skos:altLabel>Preventable deaths</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000274"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000200">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Umbrella review / overview of reviews</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A synthesis that systematically compiles and summarises findings from multiple systematic reviews on a related topic, providing a high-level overview of the evidence base.</skos:definition>
    <skos:altLabel>Overview of reviews</skos:altLabel>
    <skos:altLabel>Review of reviews</skos:altLabel>
    <skos:altLabel>Meta-review</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000198"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>N.2 Health - Metrics</dct:title>
    <dct:description>Quantitative and qualitative measures used to assess and compare health status, disease burden, and healthcare use across populations and studies.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000274"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000281"/>
