    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Systemic bacterial infections caused by Salmonella Typhi and Salmonella Paratyphi, transmitted via contaminated food and water.</skos:definition>
    <skos:scopeNote>GBD ref: 958</skos:scopeNote>
    <skos:altLabel>Typhoid fever</skos:altLabel>
    <skos:altLabel>Paratyphoid fever</skos:altLabel>
