    <skos:prefLabel>Child (2-12 years)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Children aged 2 to 12 years, spanning early childhood through to pre-adolescence, during which physical, cognitive, and social development are particularly sensitive to environmental conditions.</skos:definition>
    <skos:altLabel>Children</skos:altLabel>
    <skos:altLabel>School-age children</skos:altLabel>
    <skos:altLabel>Paediatric</skos:altLabel>
    <skos:altLabel>Kids</skos:altLabel>
    <skos:altLabel>Child age group</skos:altLabel>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000253"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000252"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000314">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000324"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000315"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000364"/>
