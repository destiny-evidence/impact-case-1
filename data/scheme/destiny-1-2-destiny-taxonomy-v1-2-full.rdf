  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/fossil-fuels/DSNY000621">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Natural gas</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/fossil-fuels"/>
    <skos:definition>A fossil fuel composed primarily of methane, used for heating, electricity generation, and industrial processes, with lower CO₂ emissions than coal but significant methane leakage risks.</skos:definition>
    <skos:altLabel>Gas</skos:altLabel>
    <skos:altLabel>Methane gas</skos:altLabel>
    <skos:altLabel>LNG</skos:altLabel>
    <skos:altLabel>CNG</skos:altLabel>
    <skos:altLabel>fuel gas</skos:altLabel>
    <skos:altLabel>fracking gas</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000143">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Forest</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Land covered predominantly by trees and associated flora, providing critical ecosystem services including carbon sequestration, biodiversity habitat, and water regulation, all threatened by climate change.</skos:definition>
    <skos:altLabel>Woodland</skos:altLabel>
    <skos:altLabel>Boreal forest</skos:altLabel>
    <skos:altLabel>Temperate forest</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000466">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Hemoglobinopathies and hemolytic anemias</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Inherited disorders of haemoglobin structure or synthesis, including sickle cell disease and thalassaemia, causing haemolytic anaemia and multi-organ complications.</skos:definition>
    <skos:scopeNote>GBD ref: 613</skos:scopeNote>
    <skos:altLabel>Sickle cell disease</skos:altLabel>
    <skos:altLabel>Thalassaemia</skos:altLabel>
    <skos:altLabel>Haemolytic anaemia</skos:altLabel>
    <skos:altLabel>Blood disorder</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000462"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000341">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Dengue</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A mosquito-borne viral infection caused by dengue virus serotypes, transmitted by Aedes mosquitoes, producing fever, severe headache, and in severe cases haemorrhagic complications.</skos:definition>
    <skos:scopeNote>GBD ref: 357</skos:scopeNote>
    <skos:altLabel>Dengue fever</skos:altLabel>
    <skos:altLabel>Dengue haemorrhagic fever</skos:altLabel>
    <skos:altLabel>DHF</skos:altLabel>
    <skos:altLabel>Aedes-borne dengue</skos:altLabel>
    <skos:altLabel>Break-bone fever</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000288">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Hospital admission (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The rate or number of patients admitted to hospital as inpatients for treatment, observation, or care related to a specific condition.</skos:definition>
    <skos:altLabel>Hospitalisation</skos:altLabel>
    <skos:altLabel>Inpatient admission</skos:altLabel>
    <skos:altLabel>Hospital stay</skos:altLabel>
    <skos:altLabel>Inpatient care</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000287"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000264">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Water quality and quantity (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Changes in the availability, quality, and safety of freshwater and other water sources, including flooding, drought, and contamination affecting drinking water and sanitation.</skos:definition>
    <skos:scopeNote>Climate change may compromise water quality through several pathways, such as favouring the growth of organisms that cause waterborne gastrointestinal illness and boosting the growth of harmful algae, Cyanobacteria, Escherichia coli and other bacterial strains, and viruses. Clean water may not even be available owing to drought or contamination after extreme weather, storm surges and floodings. Potential health impacts include: campylobacter infection, cholera, cryptosporidiosis, harmful algal blooms, leptospirosis, norovirus infection, typhoid fever, rotavirus infection, diarrhoea (E.coli), melioidosis, hepatitis E, dysentery.
</skos:scopeNote>
    <skos:altLabel>Water security</skos:altLabel>
    <skos:altLabel>Water availability</skos:altLabel>
    <skos:altLabel>Water contamination</skos:altLabel>
    <skos:altLabel>Drinking water quality</skos:altLabel>
    <skos:altLabel>Flood water exposure</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age/DSNY000249">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Infant (1-23 months)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Children aged 1 to 23 months, a developmental period of rapid growth, nutritional dependency, and heightened susceptibility to infectious disease and environmental exposures.</skos:definition>
    <skos:altLabel>Infants</skos:altLabel>
    <skos:altLabel>Babies</skos:altLabel>
    <skos:altLabel>Under 2s</skos:altLabel>
    <skos:altLabel>Infant age group</skos:altLabel>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000250"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000428">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Eating disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Mental disorders characterised by abnormal eating behaviours and distorted body image, including anorexia nervosa, bulimia nervosa, and binge eating disorder.</skos:definition>
    <skos:scopeNote>GBD ref: 572</skos:scopeNote>
    <skos:altLabel>Anorexia nervosa</skos:altLabel>
    <skos:altLabel>Bulimia nervosa</skos:altLabel>
    <skos:altLabel>Anorexia</skos:altLabel>
    <skos:altLabel>Bulimia</skos:altLabel>
    <skos:altLabel>Binge eating disorder</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000423"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000413">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Pancreatitis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Acute or chronic inflammation of the pancreas, causing abdominal pain and disrupting digestive enzyme and insulin secretion.</skos:definition>
    <skos:scopeNote>GBD ref: 535</skos:scopeNote>
    <skos:altLabel>Acute pancreatitis</skos:altLabel>
    <skos:altLabel>Chronic pancreatitis</skos:altLabel>
    <skos:altLabel>Pancreatic inflammation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000286">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Health-related quality of life (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>Self-reported or assessed measures of physical, mental, and social functioning and wellbeing as affected by a health condition or its treatment.</skos:definition>
    <skos:altLabel>HRQoL</skos:altLabel>
    <skos:altLabel>Quality of life</skos:altLabel>
    <skos:altLabel>Health status</skos:altLabel>
    <skos:altLabel>Patient-reported outcomes</skos:altLabel>
    <skos:altLabel>Wellbeing</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000281"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000323">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>COVID-19</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Respiratory illness caused by the SARS-CoV-2 coronavirus, ranging from mild infection to severe pneumonia, acute respiratory distress, and multi-organ failure.</skos:definition>
    <skos:scopeNote>GBD ref: 1048</skos:scopeNote>
    <skos:altLabel>SARS-CoV-2</skos:altLabel>
    <skos:altLabel>Coronavirus disease</skos:altLabel>
    <skos:altLabel>COVID</skos:altLabel>
    <skos:altLabel>Coronavirus</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000318"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000208">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Health technology assessment (HTA)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A comprehensive policy-relevant evaluation of a health technology that typically includes clinical effectiveness, cost-effectiveness, and broader social and ethical considerations.</skos:definition>
    <skos:scopeNote>A broader evaluation of a health technology (drug, device, or intervention) used for policy and decision-making. Typically includes: clinical effectiveness (often via a systematic review), cost-effectiveness (economic modelling), ethical, legal, and social implications, and organisational impact.</skos:scopeNote>
    <skos:altLabel>Health technology assessment</skos:altLabel>
    <skos:altLabel>HTA</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000198"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000410">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Inflammatory bowel disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Chronic immune-mediated inflammatory conditions of the gastrointestinal tract, including Crohn's disease and ulcerative colitis, characterised by relapsing intestinal inflammation.</skos:definition>
    <skos:scopeNote>GBD ref: 532</skos:scopeNote>
    <skos:altLabel>IBD</skos:altLabel>
    <skos:altLabel>Crohn's disease</skos:altLabel>
    <skos:altLabel>Ulcerative colitis</skos:altLabel>
    <skos:altLabel>Colitis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000581">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Forest / land management</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Sustainable management and restoration of forests and land, including wildfire prevention, reforestation, agroforestry, peatland restoration for biodiversity and carbon sequestration, regenerative agriculture for soil health and food security, and ecological approaches to reducing disease vector habitat.</skos:definition>
    <skos:altLabel>Reforestation</skos:altLabel>
    <skos:altLabel>Agroforestry</skos:altLabel>
    <skos:altLabel>Wildfire management</skos:altLabel>
    <skos:altLabel>Peatland restoration</skos:altLabel>
    <skos:altLabel>Regenerative agriculture</skos:altLabel>
    <skos:altLabel>Nature-based vector control</skos:altLabel>
    <skos:altLabel>Land restoration</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000113"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000383">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other neoplasms</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Non-malignant tumours that do not invade surrounding tissue or metastasise but may cause local symptoms through mass effect.</skos:definition>
    <skos:scopeNote>GBD ref: 490</skos:scopeNote>
    <skos:altLabel>Benign tumours</skos:altLabel>
    <skos:altLabel>Non-malignant neoplasms</skos:altLabel>
    <skos:altLabel>Benign neoplasms</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000378"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000108">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Behaviour related to mobility</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Behavioural changes in how individuals travel and commute, such as switching to public transport, cycling, walking, or reducing vehicle use, to reduce transport-related emissions.</skos:definition>
    <skos:altLabel>Transport behaviour</skos:altLabel>
    <skos:altLabel>Travel choices</skos:altLabel>
    <skos:altLabel>Mobility behaviour</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000516">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Case report / case study</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A detailed account of a single individual's or unit's exposure, condition, and outcome, used to generate hypotheses or describe novel or rare phenomena.</skos:definition>
    <skos:altLabel>Case report</skos:altLabel>
    <skos:altLabel>Case study</skos:altLabel>
    <skos:altLabel>Single case report</skos:altLabel>
    <skos:altLabel>Clinical case report</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000515"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000280">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Maternal mortality (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The death of a woman during pregnancy, childbirth, or within 42 days of delivery from causes related to or aggravated by the pregnancy or its management.</skos:definition>
    <skos:altLabel>Maternal death rate</skos:altLabel>
    <skos:altLabel>Maternal mortality ratio</skos:altLabel>
    <skos:altLabel>MMR</skos:altLabel>
    <skos:altLabel>Pregnancy-related death</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000274"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000402">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Interstitial lung disease and pulmonary sarcoidosis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A heterogeneous group of diffuse parenchymal lung diseases characterised by inflammation and fibrosis of the lung interstitium, leading to progressive breathlessness and impaired gas exchange.</skos:definition>
    <skos:scopeNote>GBD ref: 516</skos:scopeNote>
    <skos:altLabel>ILD</skos:altLabel>
    <skos:altLabel>Pulmonary fibrosis</skos:altLabel>
    <skos:altLabel>Sarcoidosis</skos:altLabel>
    <skos:altLabel>Interstitial pneumonia</skos:altLabel>
    <skos:altLabel>Fibrosing lung disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000397"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000601">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Changes in season length</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>Shifts in the duration of seasons, including earlier spring onset and extended summers, with consequences for agriculture, vector biology, and human health.</skos:definition>
    <skos:altLabel>Seasonal shift</skos:altLabel>
    <skos:altLabel>Season length change</skos:altLabel>
    <skos:altLabel>Phenological change</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000291">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Healthcare access disruption (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>Interruptions to the availability or accessibility of healthcare services, resulting in delayed, reduced, or foregone care for affected populations.</skos:definition>
    <skos:altLabel>Access disruption</skos:altLabel>
    <skos:altLabel>Healthcare disruption</skos:altLabel>
    <skos:altLabel>Health system disruption</skos:altLabel>
    <skos:altLabel>Service disruption</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000287"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000305">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Communicable, maternal, neonatal, and nutritional mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths attributable to communicable diseases, maternal conditions, neonatal disorders, and nutritional deficiencies.</skos:definition>
    <skos:altLabel>CMNN mortality</skos:altLabel>
    <skos:altLabel>Communicable disease mortality</skos:altLabel>
    <skos:altLabel>Infectious disease mortality</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000296"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000306"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000312"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000311"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000313"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000265">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Extreme weather events (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Acute exposure to extreme meteorological events — including floods, storms, cyclones, droughts, and wildfires — that cause direct physical harm or injury.</skos:definition>
    <skos:scopeNote>Extreme weather, including increasingly intense storms leading to coastal flooding with rising sea levels, can result in a wide range of health effects. These may include death or injuries, worsening of existing medical illnesses, spread of waterborne diseases, and adverse effects on mental health. Extreme events can also lead to wide-ranging negative consequences for health care delivery (disruption).</skos:scopeNote>
    <skos:altLabel>Natural disasters</skos:altLabel>
    <skos:altLabel>Extreme weather</skos:altLabel>
    <skos:altLabel>Floods</skos:altLabel>
    <skos:altLabel>Storms</skos:altLabel>
    <skos:altLabel>Cyclones</skos:altLabel>
    <skos:altLabel>Droughts</skos:altLabel>
    <skos:altLabel>Wildfires</skos:altLabel>
    <skos:altLabel>Hurricanes</skos:altLabel>
    <skos:altLabel>Weather extremes</skos:altLabel>
    <skos:altLabel>Hydrometeorological disasters</skos:altLabel>
    <skos:altLabel>Typhoons</skos:altLabel>
    <skos:altLabel>Tropical storms</skos:altLabel>
    <skos:altLabel>Flooding</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000545">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000547"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000546"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000548"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000549"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000550"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Modelling / simulation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Study designs using mathematical, statistical, or computational models to simulate real-world systems, project future outcomes, or estimate impacts under defined scenarios.</skos:definition>
    <skos:altLabel>Simulation study</skos:altLabel>
    <skos:altLabel>Modelling study</skos:altLabel>
    <skos:altLabel>Computational modelling</skos:altLabel>
    <skos:altLabel>Mathematical modelling</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000167"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000523">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Case-control / retrospective matched comparison</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A study that retrospectively compares individuals with a health outcome (cases) to those without (controls) to identify differences in prior exposure, often using matching to reduce confounding.</skos:definition>
    <skos:altLabel>Case-control study</skos:altLabel>
    <skos:altLabel>Retrospective matched comparison</skos:altLabel>
    <skos:altLabel>Matched case-control</skos:altLabel>
    <skos:altLabel>Matched sample design</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000522"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000426">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Bipolar disorder</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A mood disorder characterised by episodes of mania or hypomania alternating with depression, causing significant disruption to functioning and quality of life.</skos:definition>
    <skos:scopeNote>GBD ref: 570</skos:scopeNote>
    <skos:altLabel>Manic depression</skos:altLabel>
    <skos:altLabel>Bipolar affective disorder</skos:altLabel>
    <skos:altLabel>BPAD</skos:altLabel>
    <skos:altLabel>Manic-depressive illness</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000423"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000281">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000285"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000286"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000282"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000283"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000284"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Disease burden / quality of life (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>Measures quantifying the non-fatal impact of disease on individuals and populations, including disease frequency, duration, and effect on functional status and wellbeing.</skos:definition>
    <skos:altLabel>Disease burden metrics</skos:altLabel>
    <skos:altLabel>Quality of life measures</skos:altLabel>
    <skos:altLabel>Morbidity metrics</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000475">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Fire, heat, and hot substances</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injuries to the skin and deeper tissues caused by flames, hot surfaces, scalding liquids, or contact with hot substances.</skos:definition>
    <skos:scopeNote>GBD ref: 699</skos:scopeNote>
    <skos:altLabel>Burn injury</skos:altLabel>
    <skos:altLabel>Scalds</skos:altLabel>
    <skos:altLabel>Thermal injury</skos:altLabel>
    <skos:altLabel>Fire-related injury</skos:altLabel>
    <skos:altLabel>Heat injury</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000472"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/reference-type/DSNY000625">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Planned research/protocols</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/reference-type"/>
    <skos:definition>A registered or published research protocol or trials registry record describing a study that is planned or underway but has not yet reported results. </skos:definition>
    <skos:scopeNote>Trials registry record, protocol (published in a scientific journal as journal article or as another reference type).</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000464">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Urinary diseases and male infertility</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Conditions affecting the urinary tract and male reproductive system, including urinary tract infections, kidney stones, and causes of male infertility.</skos:definition>
    <skos:scopeNote>GBD ref: 594</skos:scopeNote>
    <skos:altLabel>Urinary tract disease</skos:altLabel>
    <skos:altLabel>Kidney stones</skos:altLabel>
    <skos:altLabel>Male infertility</skos:altLabel>
    <skos:altLabel>Urological disease</skos:altLabel>
    <skos:altLabel>UTI</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000462"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>A.3 Population - Vulnerability</dct:title>
    <dct:description>Vulnerable population groups relevant to climate and health research, including those with chronic conditions, disabilities, and socioeconomic disadvantages. Vulnerability is the risk of a specific population to be adversely affected. It covers factors affecting susceptibility to harm and lack of capacity to cope and adapt. It describes the social, cultural, economic, and demographic factors that mediate how hazards will manifest as impacts (e.g. gender, education, poverty, disability, age). </dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000233"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000234"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000235"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000236"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000237"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000238"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000239"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000240"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000241"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000242"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000243"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000446">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Psoriasis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A chronic immune-mediated inflammatory skin disease characterised by scaly erythematous plaques, with systemic associations including psoriatic arthritis.</skos:definition>
    <skos:scopeNote>GBD ref: 655</skos:scopeNote>
    <skos:altLabel>Plaque psoriasis</skos:altLabel>
    <skos:altLabel>Psoriasis vulgaris</skos:altLabel>
    <skos:altLabel>Skin psoriasis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000488">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Conflict and terrorism</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injuries and deaths resulting from organised collective violence, including war, armed conflict, and terrorist attacks.</skos:definition>
    <skos:scopeNote>GBD ref: 945</skos:scopeNote>
    <skos:altLabel>War injury</skos:altLabel>
    <skos:altLabel>Terrorist attack</skos:altLabel>
    <skos:altLabel>Armed conflict injury</skos:altLabel>
    <skos:altLabel>War trauma</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000485"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000519">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000520"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000521"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Observational / single-group designs</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Observational study designs that track outcomes over time in a single group without a concurrent comparison group, relying on temporal patterns to infer associations.</skos:definition>
    <skos:altLabel>Single-group observational study</skos:altLabel>
    <skos:altLabel>Uncontrolled observational design</skos:altLabel>
    <skos:altLabel>Observational single-group study</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000167"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000319">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Tuberculosis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A chronic bacterial infection caused by Mycobacterium tuberculosis, primarily affecting the lungs but capable of affecting any organ system.</skos:definition>
    <skos:scopeNote>GBD ref: 297</skos:scopeNote>
    <skos:altLabel>TB</skos:altLabel>
    <skos:altLabel>Pulmonary tuberculosis</skos:altLabel>
    <skos:altLabel>Mycobacterium tuberculosis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000318"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000602">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Changes in temperature</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>Long-term shifts in average or extreme temperature conditions, including warming trends, that affect human health, ecosystems, and society.</skos:definition>
    <skos:altLabel>Temperature change</skos:altLabel>
    <skos:altLabel>Warming</skos:altLabel>
    <skos:altLabel>Temperature shift</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-forcing-agents">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>E.3 Climate factors - Climate forcing agents</dct:title>
    <dct:description>Substances and processes that alter the Earth's energy balance by trapping heat or affecting atmospheric chemistry, including greenhouse gases, aerosols, and ozone-depleting substances.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000612"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000614"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000615"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000616"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000617"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000613"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000618"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000611"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000534">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Instrumental variables</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A quasi-experimental method using a variable that affects exposure but not the outcome directly (an instrument) to estimate causal effects in the presence of unmeasured confounding.</skos:definition>
    <skos:altLabel>IV analysis</skos:altLabel>
    <skos:altLabel>Instrumental variable analysis</skos:altLabel>
    <skos:altLabel>IV method</skos:altLabel>
    <skos:altLabel>Two-stage least squares</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000532"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/governance-scale/DSNY000229">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>International - multi-country (Governance scale)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/governance-scale"/>
    <skos:definition>Governance arrangements and interventions involving a defined group of countries acting together across national boundaries, such as bilateral partnerships or plurilateral coalitions, without necessarily sharing a geographic region or formal institutional structure.</skos:definition>
    <skos:scopeNote>Refers to a defined group of countries acting together, such as a bilateral partnership or plurilateral coalition, without necessarily sharing a geographic region or formal institutional structure. Distinct from 'International, Regional', which refers to geographically or institutionally defined regional blocs.</skos:scopeNote>
    <skos:altLabel>Multinational</skos:altLabel>
    <skos:altLabel>Cross-national</skos:altLabel>
    <skos:altLabel>Plurilateral</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-gender-sex/DSNY000246">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Female</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-gender-sex"/>
    <skos:definition>Individuals identified as female by biological sex or gender identity, used to stratify health data or describe sex-specific biological and social health determinants.</skos:definition>
    <skos:altLabel>Women</skos:altLabel>
    <skos:altLabel>Girls</skos:altLabel>
    <skos:altLabel>Female sex</skos:altLabel>
    <skos:altLabel>Females</skos:altLabel>
    <skos:altLabel>Women and girls</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000096">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000573"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000570"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000572"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000574"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000571"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000575"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000576"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Emitting technologies / infrastructure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Technologies and infrastructure that generate significant greenhouse gas emissions, whose phase-out or retrofitting is central to climate mitigation strategies. Covers so-called brown technologies.</skos:definition>
    <skos:scopeNote>Technologies and infrastructure that contribute to greenhouse gas emissions and/or directly harm health.</skos:scopeNote>
    <skos:altLabel>Emission-intensive technology</skos:altLabel>
    <skos:altLabel>Polluting infrastructure</skos:altLabel>
    <skos:altLabel>Carbon-intensive technology</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000093"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000292">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Length of hospital stay (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The duration of an inpatient hospital episode, used as a measure of disease severity, healthcare resource use, and patient recovery.</skos:definition>
    <skos:altLabel>Hospital length of stay</skos:altLabel>
    <skos:altLabel>LOS</skos:altLabel>
    <skos:altLabel>Inpatient duration</skos:altLabel>
    <skos:altLabel>Bed days</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000287"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/reference-type/DSNY000626">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Preprint/working paper</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/reference-type"/>
    <skos:definition>A research manuscript that has been made publicly available prior to formal peer review and journal publication, such as those posted on medRxiv or SSRN.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000102">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Household protection</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Actions taken at the household level to reduce exposure to hazards or improve living conditions, such as installing insulation, flood barriers, ventilation, or emergency preparedness measures.</skos:definition>
    <skos:altLabel>Home protection</skos:altLabel>
    <skos:altLabel>Household adaptation</skos:altLabel>
    <skos:altLabel>Domestic preparedness</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000145">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Grassland / savanna</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Open landscapes dominated by grasses and low vegetation, sensitive to changes in precipitation and temperature, and at increased risk of drought and wildfire under climate change. Includes savanna (dominant in sub-Saharan Africa).</skos:definition>
    <skos:altLabel>Savanna</skos:altLabel>
    <skos:altLabel>Prairie</skos:altLabel>
    <skos:altLabel>Meadow</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000547">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Computable general equilibrium (CGE) model</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A macroeconomic modelling approach representing interactions across sectors of an economy to estimate the economy-wide effects of policy changes, including those with health implications.</skos:definition>
    <skos:altLabel>CGE model</skos:altLabel>
    <skos:altLabel>CGE</skos:altLabel>
    <skos:altLabel>General equilibrium model</skos:altLabel>
    <skos:altLabel>Economy-wide model</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000545"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000499">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Arid / semi-arid</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Regions characterised by low and variable rainfall, high evapotranspiration, and limited soil moisture, encompassing deserts, steppes, and dry shrublands where water scarcity is a primary constraint.</skos:definition>
    <skos:altLabel>Dryland</skos:altLabel>
    <skos:altLabel>Arid region</skos:altLabel>
    <skos:altLabel>Semi-arid region</skos:altLabel>
    <skos:altLabel>Dry region</skos:altLabel>
    <skos:altLabel>Steppe</skos:altLabel>
    <skos:altLabel>Shrubland</skos:altLabel>
  </rdf:Description>
