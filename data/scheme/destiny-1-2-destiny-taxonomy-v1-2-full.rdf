  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000541">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000542"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000543"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000544"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
