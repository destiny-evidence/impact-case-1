  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000238">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Infants / children (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Young children and infants whose immature physiological systems, developmental dependency, and limited autonomy increase their susceptibility to environmental exposures and health harms.</skos:definition>
    <skos:altLabel>Young children</skos:altLabel>
    <skos:altLabel>Infants</skos:altLabel>
    <skos:altLabel>Neonates</skos:altLabel>
    <skos:altLabel>Babies</skos:altLabel>
    <skos:altLabel>Paediatric population</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000568">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Coastal / flood defence</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Physical infrastructure protecting coastal and flood-prone communities from climate-related inundation, including sea walls, improved drainage systems, and managed retreat programmes that reduce population exposure.</skos:definition>
    <skos:altLabel>Sea walls</skos:altLabel>
    <skos:altLabel>Flood defences</skos:altLabel>
    <skos:altLabel>Coastal protection</skos:altLabel>
    <skos:altLabel>Managed retreat</skos:altLabel>
    <skos:altLabel>Drainage systems</skos:altLabel>
    <skos:altLabel>Flood barriers</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000095"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000474">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Drowning</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Respiratory impairment resulting from submersion or immersion in liquid, including fatal drowning and non-fatal near-drowning events.</skos:definition>
    <skos:scopeNote>GBD ref: 698</skos:scopeNote>
    <skos:altLabel>Drowning injury</skos:altLabel>
    <skos:altLabel>Submersion injury</skos:altLabel>
