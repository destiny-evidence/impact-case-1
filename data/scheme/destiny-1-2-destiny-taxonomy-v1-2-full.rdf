    <skos:altLabel>Sanitation</skos:altLabel>
    <skos:altLabel>Waste management</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000322">
