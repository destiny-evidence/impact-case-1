    <skos:prefLabel>Million-cities</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Formal urban settlements with a population of between 1,000,000 and 10,000,000 inhabitants, characterised by complex governance structures, significant economic output, and high population density.</skos:definition>
    <skos:altLabel>Large cities</skos:altLabel>
    <skos:altLabel>Major cities</skos:altLabel>
    <skos:altLabel>Metropolitan cities</skos:altLabel>
    <skos:altLabel>1 million to 10 million</skos:altLabel>
    <skos:altLabel>Large urban centres</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000505"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000284">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
