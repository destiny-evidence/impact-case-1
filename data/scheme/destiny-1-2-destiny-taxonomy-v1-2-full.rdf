  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000147">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Mountain</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>Elevated terrain characterised by steep slopes and cooler temperatures, where glacier retreat, altered precipitation patterns, and biodiversity shifts are prominent climate change impacts.</skos:definition>
    <skos:altLabel>Highland</skos:altLabel>
    <skos:altLabel>Alpine</skos:altLabel>
    <skos:altLabel>Upland</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000370">
