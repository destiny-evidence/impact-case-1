    <skos:definition>Disorders characterised by compulsive use of psychoactive substances despite adverse consequences, including alcohol and drug use disorders.</skos:definition>
    <skos:scopeNote>GBD ref: 973</skos:scopeNote>
    <skos:altLabel>Addiction</skos:altLabel>
    <skos:altLabel>Substance abuse</skos:altLabel>
    <skos:altLabel>Drug and alcohol disorders</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000377"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/country-income">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>L. Country income [automation planned]</dct:title>
    <dct:description>World Bank income classification categories used to stratify countries by economic development level in climate and health research. Will be automated in V2 of repository (classification based on the location extracted, then mapped against the World Bank classification of country incomes).</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/country-income/DSNY000139"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/country-income/DSNY000136"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/country-income/DSNY000137"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/country-income/DSNY000138"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000303">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Injury-related mortality (drowning, fires, disasters, suicide, violence)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths resulting from injuries including drowning, fires, natural disasters, suicide, and interpersonal violence.</skos:definition>
    <skos:altLabel>Injury mortality</skos:altLabel>
    <skos:altLabel>Trauma death</skos:altLabel>
    <skos:altLabel>Disaster mortality</skos:altLabel>
