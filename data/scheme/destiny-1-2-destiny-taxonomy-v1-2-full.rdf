  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements/DSNY000509">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Megacities</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Formal urban settlements with a population exceeding 10,000,000 inhabitants, presenting unique challenges for governance, infrastructure, environmental management, and health system capacity.</skos:definition>
    <skos:altLabel>Mega-cities</skos:altLabel>
    <skos:altLabel>Hypercities</skos:altLabel>
    <skos:altLabel>Global cities</skos:altLabel>
    <skos:altLabel>Over 10 million</skos:altLabel>
    <skos:altLabel>Very large cities</skos:altLabel>
