  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000546">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Integrated assessment model (IAM) / health impact projection</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A modelling approach linking climate, economic, and social systems to project future health impacts under different emissions or policy scenarios, often at national or global scale.</skos:definition>
    <skos:altLabel>IAM</skos:altLabel>
    <skos:altLabel>Integrated assessment model</skos:altLabel>
    <skos:altLabel>Health impact projection model</skos:altLabel>
    <skos:altLabel>Climate-health projection model</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000545"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000243">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Women (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Women as a population group who may face heightened vulnerability due to biological factors, gender-based inequalities in resource access, and higher exposure to specific social and economic risks.</skos:definition>
    <skos:altLabel>Females</skos:altLabel>
    <skos:altLabel>Women's vulnerability</skos:altLabel>
    <skos:altLabel>Gender inequality</skos:altLabel>
    <skos:altLabel>Female population</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000437">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Drug use disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Disorders characterised by compulsive use of illicit or prescription drugs, including opioids, stimulants, and cannabis, with significant harm to health and functioning.</skos:definition>
    <skos:scopeNote>GBD ref: 561</skos:scopeNote>
    <skos:altLabel>Drug addiction</skos:altLabel>
    <skos:altLabel>Substance use disorder</skos:altLabel>
    <skos:altLabel>Drug dependence</skos:altLabel>
    <skos:altLabel>Opioid use disorder</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000435"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000354">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Meningitis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Inflammation of the meninges caused by bacterial, viral, or fungal pathogens, presenting with fever, headache, and neck stiffness and potentially fatal if untreated.</skos:definition>
    <skos:scopeNote>GBD ref: 332</skos:scopeNote>
    <skos:altLabel>Bacterial meningitis</skos:altLabel>
    <skos:altLabel>Viral meningitis</skos:altLabel>
    <skos:altLabel>Meningococcal disease</skos:altLabel>
    <skos:altLabel>Meningococcal meningitis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000353"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000539">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Matched comparison / propensity score matching</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A method pairing treated and untreated units on observed characteristics or estimated propensity scores to construct a balanced comparison group and reduce confounding bias.</skos:definition>
    <skos:altLabel>Propensity score matching</skos:altLabel>
    <skos:altLabel>PSM</skos:altLabel>
    <skos:altLabel>Matched analysis</skos:altLabel>
    <skos:altLabel>Propensity score analysis</skos:altLabel>
    <skos:altLabel>Coarsened exact matching</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000532"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/actors/DSNY000162">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Supranational and international organizations (Actor)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/actors"/>
    <skos:definition>Supranational bodies including United Nations agencies, multilateral development banks, and intergovernmental organisations that coordinate policy, financing, and action across nations.</skos:definition>
    <skos:altLabel>Multilateral organisations</skos:altLabel>
    <skos:altLabel>UN agencies</skos:altLabel>
    <skos:altLabel>Intergovernmental bodies</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000336">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cysticercosis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infection by the larval stage of the pork tapeworm Taenia solium, which can invade the brain causing neurocysticercosis, a leading cause of acquired epilepsy.</skos:definition>
    <skos:scopeNote>GBD ref: 352</skos:scopeNote>
    <skos:altLabel>Tapeworm</skos:altLabel>
    <skos:altLabel>Neurocysticercosis</skos:altLabel>
    <skos:altLabel>Taenia solium</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000207">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Guideline (clinical or public health)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A systematically developed statement providing recommendations to guide clinical or public health practice, typically based on a synthesis of the available evidence. Often with systematic methods, but sometimes also based on expert consensus.</skos:definition>
    <skos:altLabel>Clinical guideline</skos:altLabel>
    <skos:altLabel>Public health guideline</skos:altLabel>
    <skos:altLabel>Evidence-based guideline</skos:altLabel>
    <skos:altLabel>Health guideline</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000198"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000205">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Evidence map / evidence gap map</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A systematic mapping exercise that visually represents the distribution of evidence across a framework of interventions and outcomes, highlighting areas where evidence is absent or weak.</skos:definition>
    <skos:altLabel>Evidence gap map</skos:altLabel>
    <skos:altLabel>Gap map</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000201"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000206">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Narrative review</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A non-systematic review that summarises and interprets the literature on a topic based on the author's expertise and judgement, without exhaustive or reproducible search methods.</skos:definition>
    <skos:altLabel>Literature review</skos:altLabel>
    <skos:altLabel>Non-systematic review</skos:altLabel>
    <skos:altLabel>Traditional review</skos:altLabel>
    <skos:altLabel>Review</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000198"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000577">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Other behaviour related to adaptation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Adaptation behaviours not classified under the specific categories of civic engagement, psychological coping, household protection, learning, lifestyle change in place, migration, or self-protection.</skos:definition>
    <skos:altLabel>Other adaptive behaviour</skos:altLabel>
    <skos:altLabel>Other coping behaviour</skos:altLabel>
    <skos:altLabel>Other protective behaviour</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000239">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Low-income (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Individuals and households with insufficient financial resources to meet basic needs, facing compounded vulnerability through reduced access to healthcare, nutrition, safe housing, and adaptive capacity.</skos:definition>
    <skos:altLabel>Low income</skos:altLabel>
    <skos:altLabel>Poverty</skos:altLabel>
    <skos:altLabel>Socioeconomic deprivation</skos:altLabel>
    <skos:altLabel>Economically disadvantaged</skos:altLabel>
    <skos:altLabel>Deprived communities</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000531">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Quasi-randomised / natural experiment</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A study in which allocation to intervention and control conditions occurs through a process that approximates randomisation but is not under the investigator's full control, such as policy roll-out or natural variation.</skos:definition>
    <skos:altLabel>Natural experiment</skos:altLabel>
    <skos:altLabel>Quasi-randomised trial</skos:altLabel>
    <skos:altLabel>Quasi-experimental study</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000529"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000624">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Nicotine dependence</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Can you provide a short defintion of nicotine dependence?
12:15

Nicotine dependence is a chronic, relapsing condition characterized by compulsive use of nicotine-containing products (most commonly cigarettes), accompanied by tolerance, a withdrawal syndrome on cessation or reduction, and continued use despite the awareness of harmful consequences.</skos:definition>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000435"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000530">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Randomised / RCT</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>An experimental study in which participants are randomly allocated to intervention or control groups, considered the gold standard for evaluating causal effects of interventions.</skos:definition>
    <skos:altLabel>RCT</skos:altLabel>
    <skos:altLabel>Randomised controlled trial</skos:altLabel>
    <skos:altLabel>Field experiment</skos:altLabel>
    <skos:altLabel>Parallel RCT</skos:altLabel>
    <skos:altLabel>Crossover RCT</skos:altLabel>
    <skos:altLabel>Cluster RCT</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000529"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000321">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Upper respiratory infections</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infections of the upper respiratory tract including the nose, throat, sinuses, and larynx, typically caused by viruses.</skos:definition>
    <skos:scopeNote>GBD ref: 328</skos:scopeNote>
    <skos:altLabel>URI</skos:altLabel>
    <skos:altLabel>Upper respiratory tract infection</skos:altLabel>
    <skos:altLabel>Common cold</skos:altLabel>
    <skos:altLabel>Pharyngitis</skos:altLabel>
    <skos:altLabel>Sinusitis</skos:altLabel>
    <skos:altLabel>Rhinitis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000318"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/topic/DSNY000493">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Future impact</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/topic"/>
    <skos:definition>Projected effects on human health, ecosystems, and societies arising from anticipated changes in climate over coming decades, typically derived from climate modelling and scenario analysis.</skos:definition>
    <skos:altLabel>Projected impact</skos:altLabel>
    <skos:altLabel>Future climate impact</skos:altLabel>
    <skos:altLabel>Projected climate effects</skos:altLabel>
    <skos:altLabel>Climate projections</skos:altLabel>
    <skos:altLabel>Future risk</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000053"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/topic/DSNY000490">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Maladaptation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/topic"/>
    <skos:definition>Adaptation actions that inadvertently increase vulnerability or exposure to harm, reduce adaptive capacity, or create new risks for human or natural systems, often as an unintended consequence of well-intentioned interventions.</skos:definition>
    <skos:altLabel>Mal-adaptation</skos:altLabel>
    <skos:altLabel>Adaptive failure</skos:altLabel>
    <skos:altLabel>Counterproductive adaptation</skos:altLabel>
    <skos:altLabel>Failed adaptation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/topic/DSNY000052"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000273">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Ultraviolet / solar radiation (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Exposure to ultraviolet radiation from solar sources, associated with skin cancer risk, vitamin D synthesis, and immune modulation.</skos:definition>
    <skos:scopeNote>Solar radiation increases with reduced cloud cover resulting from climate change. Exposure to ultraviolet (UV) radiation can cause sunburn, skin damage, eye damage and skin cancer. UV exposure is also related to the depletion of the ozone-layer, which is influenced by climate forcing agents.</skos:scopeNote>
    <skos:altLabel>UV radiation</skos:altLabel>
    <skos:altLabel>Solar radiation</skos:altLabel>
    <skos:altLabel>UV exposure</skos:altLabel>
    <skos:altLabel>Ultraviolet light</skos:altLabel>
    <skos:altLabel>Sun exposure</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age/DSNY000258">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000259"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000260"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Aged (65 years and older)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Individuals aged 65 years and older, a broad group encompassing younger-old and oldest-old adults with increasing prevalence of chronic disease, frailty, and functional decline.</skos:definition>
    <skos:altLabel>Older adults</skos:altLabel>
    <skos:altLabel>Elderly</skos:altLabel>
    <skos:altLabel>Senior citizens</skos:altLabel>
