  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/extreme-weather-events/DSNY000605">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Droughts</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/extreme-weather-events"/>
    <skos:definition>Prolonged periods of abnormally low rainfall leading to water scarcity, crop failure, and increased risk of wildfires, with significant health and livelihood consequences.</skos:definition>
    <skos:altLabel>Drought conditions</skos:altLabel>
    <skos:altLabel>Water scarcity</skos:altLabel>
    <skos:altLabel>Arid conditions</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000529">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Experimental / group comparison designs</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Experimental study designs that compare outcomes between an intervention group and one or more control or comparison groups, with or without randomisation.</skos:definition>
    <skos:altLabel>Controlled experimental design</skos:altLabel>
    <skos:altLabel>Comparative experimental design</skos:altLabel>
    <skos:altLabel>Group comparison experiment</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000167"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000532"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000531"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000540"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000530"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000613">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Particulate matter (PM10) / fine particulate matter (PM2.5) / black/organic carbon / sulfate/nitrate aerosols</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents"/>
    <skos:definition>Airborne particles of 10 or 2.5 micrometres or less in diameter. Fine particulate matter can include components such as black carbon and sulfate aerosols, that affect both climate and human health through respiratory and cardiovascular pathways.</skos:definition>
    <skos:altLabel>PM2.5</skos:altLabel>
    <skos:altLabel>Fine particles</skos:altLabel>
    <skos:altLabel>Particulate air pollution</skos:altLabel>
    <skos:altLabel>PM10</skos:altLabel>
    <skos:altLabel>Black carbon</skos:altLabel>
    <skos:altLabel>Aerosols</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000468">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Oral disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Conditions affecting the teeth, gums, and oral mucosa, including dental caries, periodontal disease, edentulism, and oral infections.</skos:definition>
    <skos:scopeNote>GBD ref: 680</skos:scopeNote>
    <skos:altLabel>Dental disease</skos:altLabel>
    <skos:altLabel>Oral health</skos:altLabel>
    <skos:altLabel>Tooth decay</skos:altLabel>
    <skos:altLabel>Periodontal disease</skos:altLabel>
    <skos:altLabel>Dental caries</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000462"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000460">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Other sense organ diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Sense organ diseases not classified under blindness and vision loss or hearing loss, including other ocular and otological conditions.</skos:definition>
    <skos:scopeNote>GBD ref: 679</skos:scopeNote>
    <skos:altLabel>Other eye diseases</skos:altLabel>
    <skos:altLabel>Other ear diseases</skos:altLabel>
    <skos:altLabel>Other sensory conditions</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000457"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000482">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Environmental heat and cold exposure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injuries resulting from exposure to extreme environmental temperatures, including heat stroke, heat exhaustion, hypothermia, and frostbite.</skos:definition>
    <skos:scopeNote>GBD ref: 842</skos:scopeNote>
    <skos:altLabel>Heat injury</skos:altLabel>
    <skos:altLabel>Cold injury</skos:altLabel>
    <skos:altLabel>Hypothermia</skos:altLabel>
    <skos:altLabel>Heat stroke</skos:altLabel>
    <skos:altLabel>Frostbite</skos:altLabel>
    <skos:altLabel>Hyperthermia</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000472"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000408">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Paralytic ileus and intestinal obstruction</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Mechanical or functional obstruction of the intestine causing failure of intestinal transit, presenting with pain, distension, and vomiting.</skos:definition>
    <skos:scopeNote>GBD ref: 530</skos:scopeNote>
    <skos:altLabel>Bowel obstruction</skos:altLabel>
    <skos:altLabel>Intestinal obstruction</skos:altLabel>
    <skos:altLabel>Ileus</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000579">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Urban green-blue infrastructure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Parks, street trees, green corridors, and urban water bodies that reduce heat island effects, support mental health, and increase urban resilience through ecosystem services.</skos:definition>
    <skos:altLabel>Urban green infrastructure</skos:altLabel>
    <skos:altLabel>Blue-green infrastructure</skos:altLabel>
    <skos:altLabel>Urban parks</skos:altLabel>
    <skos:altLabel>Street trees</skos:altLabel>
    <skos:altLabel>Urban cooling</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000113"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000360">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Varicella and herpes zoster</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infection caused by varicella-zoster virus, producing chickenpox on primary infection and reactivating as herpes zoster (shingles) in older or immunocompromised individuals.</skos:definition>
    <skos:scopeNote>GBD ref: 342</skos:scopeNote>
    <skos:altLabel>Chickenpox</skos:altLabel>
    <skos:altLabel>Shingles</skos:altLabel>
    <skos:altLabel>VZV</skos:altLabel>
    <skos:altLabel>Varicella zoster virus</skos:altLabel>
    <skos:altLabel>Herpes zoster</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000353"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000459">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Age-related and other hearing loss</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Partial or complete loss of hearing attributable to ageing, noise exposure, ototoxic medications, or other causes, affecting communication and quality of life.</skos:definition>
    <skos:scopeNote>GBD ref: 674</skos:scopeNote>
    <skos:altLabel>Hearing loss</skos:altLabel>
    <skos:altLabel>Deafness</skos:altLabel>
    <skos:altLabel>Age-related hearing loss</skos:altLabel>
    <skos:altLabel>Presbycusis</skos:altLabel>
    <skos:altLabel>Noise-induced hearing loss</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000457"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000377">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000397"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000438"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000423"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000461"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000378"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000415"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000457"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000435"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000462"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>N.3.3 Non-communicable diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Chronic, non-infectious diseases of long duration including cardiovascular, respiratory, metabolic, neurological, and neoplastic conditions.</skos:definition>
    <skos:scopeNote>GBD ref: 409</skos:scopeNote>
    <skos:altLabel>NCDs</skos:altLabel>
    <skos:altLabel>Chronic diseases</skos:altLabel>
    <skos:altLabel>Non-infectious diseases</skos:altLabel>
    <skos:altLabel>Chronic conditions</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000372">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Protein-energy malnutrition</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Severe deficiency of protein and energy intake, manifesting as marasmus (energy deficiency) or kwashiorkor (protein deficiency), predominantly affecting young children in food-insecure settings.</skos:definition>
    <skos:scopeNote>GBD ref: 387</skos:scopeNote>
    <skos:altLabel>Kwashiorkor</skos:altLabel>
    <skos:altLabel>Marasmus</skos:altLabel>
    <skos:altLabel>PEM</skos:altLabel>
    <skos:altLabel>Undernutrition</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000370"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000599">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Changes in precipitation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>Alterations in the amount, timing, or intensity of rainfall and snowfall, affecting water availability, flood risk, and drought conditions.</skos:definition>
    <skos:altLabel>Rainfall change</skos:altLabel>
    <skos:altLabel>Precipitation variability</skos:altLabel>
    <skos:altLabel>Changes in rainfall</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000344">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Intestinal nematode infections</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Parasitic worm infections transmitted through soil contaminated with faecal matter, including ascariasis, hookworm, and trichuriasis, causing malnutrition and developmental impairment.</skos:definition>
    <skos:scopeNote>GBD ref: 360</skos:scopeNote>
    <skos:altLabel>Roundworm</skos:altLabel>
    <skos:altLabel>Hookworm</skos:altLabel>
    <skos:altLabel>Whipworm</skos:altLabel>
    <skos:altLabel>Soil-transmitted helminths</skos:altLabel>
    <skos:altLabel>STH</skos:altLabel>
    <skos:altLabel>Ascariasis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/governance-scale">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>I. Governance scale</dct:title>
    <dct:description>The spatial and administrative levels at which climate governance, policy, and interventions are implemented, from global to household scale.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/governance-scale/DSNY000127"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/governance-scale/DSNY000229"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/governance-scale/DSNY000128"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/governance-scale/DSNY000131"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/governance-scale/DSNY000132"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/governance-scale/DSNY000230"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/governance-scale/DSNY000135"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000373">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Iodine deficiency</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Conditions resulting from insufficient dietary iodine, including goitre, hypothyroidism, and cretinism, with adverse effects on thyroid function and neurodevelopment.</skos:definition>
    <skos:scopeNote>GBD ref: 388</skos:scopeNote>
    <skos:altLabel>Iodine deficiency disorder</skos:altLabel>
    <skos:altLabel>Goitre</skos:altLabel>
    <skos:altLabel>Cretinism</skos:altLabel>
    <skos:altLabel>Hypothyroidism from iodine deficiency</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000370"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000421">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Headache disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Chronic neurological disorders characterised by recurrent headache, including migraine, tension-type headache, and cluster headache, causing significant disability.</skos:definition>
    <skos:scopeNote>GBD ref: 972</skos:scopeNote>
    <skos:altLabel>Migraine</skos:altLabel>
    <skos:altLabel>Tension headache</skos:altLabel>
    <skos:altLabel>Cluster headache</skos:altLabel>
    <skos:altLabel>Headache</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000415"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000427">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Anxiety disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A group of mental disorders characterised by excessive fear or worry disproportionate to circumstances, including generalised anxiety disorder, panic disorder, and phobias.</skos:definition>
    <skos:scopeNote>GBD ref: 571</skos:scopeNote>
    <skos:altLabel>Generalised anxiety disorder</skos:altLabel>
    <skos:altLabel>GAD</skos:altLabel>
    <skos:altLabel>Panic disorder</skos:altLabel>
    <skos:altLabel>Phobias</skos:altLabel>
    <skos:altLabel>Social anxiety disorder</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000423"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000528">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Single arm trial / single arm experiment</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>An experimental study in which all participants receive the intervention and outcomes are compared to a pre-specified target or historical baseline, without a concurrent control arm.</skos:definition>
    <skos:altLabel>Single-arm trial</skos:altLabel>
    <skos:altLabel>Single-arm study</skos:altLabel>
    <skos:altLabel>Uncontrolled trial</skos:altLabel>
    <skos:altLabel>Open-label single-arm trial</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000527"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000575">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Waste infrastructure with high emissions</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Waste disposal systems including landfills and open burning that generate methane and toxic air pollutants, contributing to both climate forcing and direct health harm.</skos:definition>
    <skos:altLabel>Landfill</skos:altLabel>
    <skos:altLabel>Open burning</skos:altLabel>
    <skos:altLabel>Waste incineration</skos:altLabel>
    <skos:altLabel>High-emission waste</skos:altLabel>
    <skos:altLabel>Landfill methane</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000096"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-metrics/DSNY000276">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cause-specific mortality (Metric)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-metrics"/>
    <skos:definition>The rate of death attributable to a specific disease, condition, or cause within a defined population.</skos:definition>
    <skos:altLabel>Disease-specific mortality</skos:altLabel>
    <skos:altLabel>Cause-specific death rate</skos:altLabel>
    <skos:altLabel>Condition-specific mortality</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-metrics/DSNY000274"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000496">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Boreal forest / taiga</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>The world's largest terrestrial biome, spanning high-latitude northern regions and characterised by coniferous forest, cold winters, and short growing seasons, playing a major role in global carbon storage.</skos:definition>
    <skos:altLabel>Taiga</skos:altLabel>
    <skos:altLabel>Boreal forest</skos:altLabel>
    <skos:altLabel>Northern forest</skos:altLabel>
    <skos:altLabel>Coniferous forest</skos:altLabel>
    <skos:altLabel>Subarctic forest</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000307">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Respiratory infections mortality (including tuberculosis)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths caused by infections of the respiratory tract, including tuberculosis, pneumonia, and other lower and upper respiratory infections.</skos:definition>
    <skos:altLabel>Respiratory infection mortality</skos:altLabel>
    <skos:altLabel>TB mortality</skos:altLabel>
    <skos:altLabel>Pneumonia mortality</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000306"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000483">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Exposure to forces of nature</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Injuries directly caused by natural forces including earthquakes, floods, storms, landslides, and volcanic eruptions.</skos:definition>
    <skos:scopeNote>GBD ref: 729</skos:scopeNote>
    <skos:altLabel>Natural disaster injury</skos:altLabel>
    <skos:altLabel>Flood injury</skos:altLabel>
    <skos:altLabel>Earthquake injury</skos:altLabel>
    <skos:altLabel>Storm injury</skos:altLabel>
    <skos:altLabel>Hurricane injury</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000472"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000401">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Allergic rhinitis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Allergic inflammation of the nasal mucosa triggered by inhaled allergens including pollen, dust mites, and moulds, causing sneezing, nasal congestion, and rhinorrhoea.</skos:definition>
    <skos:altLabel>Hay fever</skos:altLabel>
    <skos:altLabel>Seasonal allergic rhinitis</skos:altLabel>
    <skos:altLabel>Perennial rhinitis</skos:altLabel>
    <skos:altLabel>Pollinosis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000397"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000167">
