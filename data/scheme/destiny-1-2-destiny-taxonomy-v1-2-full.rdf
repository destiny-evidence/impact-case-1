    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A spectrum of visual impairment ranging from reduced vision to complete blindness, caused by refractive errors, cataracts, glaucoma, macular degeneration, and infectious causes including trachoma.</skos:definition>
    <skos:scopeNote>GBD ref: 981</skos:scopeNote>
    <skos:altLabel>Visual impairment</skos:altLabel>
