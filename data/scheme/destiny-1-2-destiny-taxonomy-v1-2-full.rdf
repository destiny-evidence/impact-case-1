  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000580">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Coastal / marine protection</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Conservation and restoration of coastal and marine ecosystems including mangroves, coral reefs, and wetlands, providing storm surge protection, food security, flood buffering, and wellbeing co-benefits.</skos:definition>
    <skos:altLabel>Mangrove restoration</skos:altLabel>
    <skos:altLabel>Coastal wetlands</skos:altLabel>
    <skos:altLabel>Coral reef protection</skos:altLabel>
    <skos:altLabel>Marine ecosystem restoration</skos:altLabel>
    <skos:altLabel>Coastal nature-based solutions</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000113"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/governance-scale/DSNY000135">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Household / individual (Governance scale)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/governance-scale"/>
    <skos:definition>The smallest unit of governance scale, referring to decisions and actions taken by individual people or households.</skos:definition>
    <skos:altLabel>Individual level</skos:altLabel>
    <skos:altLabel>Domestic level</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000393">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Aortic aneurysm</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Pathological dilation of the aortic wall with risk of rupture, most commonly involving the abdominal aorta and associated with hypertension and atherosclerosis.</skos:definition>
    <skos:scopeNote>GBD ref: 501</skos:scopeNote>
    <skos:altLabel>Aortic dissection</skos:altLabel>
    <skos:altLabel>Abdominal aortic aneurysm</skos:altLabel>
    <skos:altLabel>AAA</skos:altLabel>
    <skos:altLabel>Thoracic aortic aneurysm</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000416">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Alzheimer's disease and other dementias</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Progressive neurodegenerative diseases characterised by cognitive decline, including Alzheimer's disease and other dementias causing loss of memory, reasoning, and functional independence.</skos:definition>
