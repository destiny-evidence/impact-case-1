  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-forcing-agents/DSNY000616">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Nitrous oxide (N₂O)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-forcing-agents"/>
    <skos:definition>A greenhouse gas and ozone-depleting substance emitted primarily from agricultural soils, livestock, and nitrogen fertilisers, with a high global warming potential.</skos:definition>
    <skos:altLabel>N2O</skos:altLabel>
    <skos:altLabel>Nitrous oxide emissions</skos:altLabel>
    <skos:altLabel>Agricultural greenhouse gas</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000355">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Encephalitis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Inflammation of the brain parenchyma caused by viral, bacterial, or autoimmune processes, presenting with altered consciousness, seizures, and focal neurological signs.</skos:definition>
    <skos:scopeNote>GBD ref: 337</skos:scopeNote>
    <skos:altLabel>Brain inflammation</skos:altLabel>
    <skos:altLabel>Viral encephalitis</skos:altLabel>
    <skos:altLabel>Mosquito-borne encephalitis</skos:altLabel>
    <skos:altLabel>West Nile encephalitis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000353"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000455">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Decubitus ulcer</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Localised skin and underlying tissue injury resulting from prolonged pressure or shear forces, typically over bony prominences in immobile patients.</skos:definition>
    <skos:scopeNote>GBD ref: 665</skos:scopeNote>
    <skos:altLabel>Pressure ulcer</skos:altLabel>
    <skos:altLabel>Pressure sore</skos:altLabel>
    <skos:altLabel>Bed sore</skos:altLabel>
    <skos:altLabel>Pressure injury</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000486">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Self-harm</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Intentional injury directed at oneself, including suicidal behaviour and non-suicidal self-injury, across a spectrum from ideation to fatal self-inflicted harm.</skos:definition>
    <skos:scopeNote>GBD ref: 718</skos:scopeNote>
    <skos:altLabel>Suicide</skos:altLabel>
    <skos:altLabel>Self-injury</skos:altLabel>
    <skos:altLabel>Deliberate self-harm</skos:altLabel>
    <skos:altLabel>DSH</skos:altLabel>
    <skos:altLabel>Suicidal behaviour</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000485"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000592">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cultural identity</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Culturally grounded practices, knowledge systems, and identities that support individual and community wellbeing, including indigenous-led approaches and the preservation of connections to land and heritage.</skos:definition>
    <skos:altLabel>Indigenous knowledge</skos:altLabel>
    <skos:altLabel>Indigenous-led response</skos:altLabel>
    <skos:altLabel>Cultural resilience</skos:altLabel>
    <skos:altLabel>Traditional ecological knowledge</skos:altLabel>
    <skos:altLabel>Connection to land</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000588"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-vulnerability/DSNY000236">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Frail elderly (Vulnerability)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-vulnerability"/>
    <skos:definition>Older adults with reduced physiological reserve and resilience, characterised by weakness, fatigue, and vulnerability to adverse health outcomes following minor stressors.</skos:definition>
    <skos:altLabel>Frail elderly</skos:altLabel>
    <skos:altLabel>Frail older adults</skos:altLabel>
    <skos:altLabel>Frailty</skos:altLabel>
    <skos:altLabel>Elderly frailty</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000204">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Scoping review</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A systematic review that maps the extent, range, and nature of evidence on a broad topic without synthesising findings, used to identify gaps and inform future research priorities.</skos:definition>
    <skos:altLabel>Evidence map</skos:altLabel>
    <skos:altLabel>Systematic map</skos:altLabel>
    <skos:altLabel>Scoping study</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000201"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000300">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Neoplasms mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths attributable to malignant and benign neoplasms across all anatomical sites.</skos:definition>
    <skos:altLabel>Cancer mortality</skos:altLabel>
    <skos:altLabel>Cancer death</skos:altLabel>
    <skos:altLabel>Tumour-related mortality</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000298"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000456">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other skin and subcutaneous diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Skin and subcutaneous diseases not classified under the specific GBD sub-categories, including rare, unspecified, or miscellaneous dermatological conditions.</skos:definition>
    <skos:scopeNote>GBD ref: 668</skos:scopeNote>
    <skos:altLabel>Other skin conditions</skos:altLabel>
    <skos:altLabel>Other dermatological diseases</skos:altLabel>
    <skos:altLabel>Other cutaneous diseases</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000434">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other mental disorders</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Mental disorders not classified under the major GBD mental health sub-categories, including other anxiety, dissociative, somatic, and unspecified psychiatric conditions.</skos:definition>
    <skos:scopeNote>GBD ref: 585</skos:scopeNote>
    <skos:altLabel>Other psychiatric disorders</skos:altLabel>
    <skos:altLabel>Other psychological conditions</skos:altLabel>
    <skos:altLabel>Other mental health conditions</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000423"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>J. Human settlements</dct:title>
    <dct:description>Types of human settlement used to classify the residential and community contexts in which populations live, ranging from formal planned urban areas to informal and displaced settlements.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000505"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000511"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000510"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000498">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Riparian</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>The transitional zone between terrestrial and aquatic environments along the banks of rivers, streams, and other watercourses, characterised by distinctive vegetation and sensitivity to flooding and drought.</skos:definition>
    <skos:altLabel>Riparian zone</skos:altLabel>
    <skos:altLabel>Riverbank</skos:altLabel>
    <skos:altLabel>Streamside habitat</skos:altLabel>
    <skos:altLabel>Floodbank</skos:altLabel>
    <skos:altLabel>Riverine habitat</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000567">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Food security technology</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Technologies that maintain food availability and safety under a changing climate, including drought-resistant crop varieties and cold chain systems that preserve food safety under warming conditions.</skos:definition>
    <skos:altLabel>Drought-resistant crops</skos:altLabel>
    <skos:altLabel>Cold chain systems</skos:altLabel>
    <skos:altLabel>Climate-resilient food production</skos:altLabel>
    <skos:altLabel>Food safety infrastructure</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000095"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000388">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Hypertensive heart disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Structural and functional cardiac disease caused by chronic elevation of blood pressure, leading to left ventricular hypertrophy and heart failure.</skos:definition>
    <skos:scopeNote>GBD ref: 498</skos:scopeNote>
    <skos:altLabel>High blood pressure heart disease</skos:altLabel>
    <skos:altLabel>Hypertensive cardiomyopathy</skos:altLabel>
    <skos:altLabel>Hypertensive heart failure</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000565">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Adaptive built environment</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Built environment designs and retrofits that reduce heat exposure and improve thermal comfort, including cool roofs, reflective surfaces, passive cooling design, and heat-resilient housing construction.</skos:definition>
    <skos:altLabel>Cool roofs</skos:altLabel>
    <skos:altLabel>Passive cooling</skos:altLabel>
    <skos:altLabel>Heat-resilient housing</skos:altLabel>
    <skos:altLabel>Reflective surfaces</skos:altLabel>
    <skos:altLabel>Green building design</skos:altLabel>
    <skos:altLabel>Urban cooling design</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000095"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000603">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Changes in wind speed</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>Alterations in wind patterns and velocity that can affect air quality, energy systems, and the spread of airborne pathogens and pollutants.</skos:definition>
    <skos:altLabel>Wind pattern change</skos:altLabel>
    <skos:altLabel>Wind variability</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000313">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Nutrition-related mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths attributable to nutritional deficiencies and undernutrition, including protein-energy malnutrition and micronutrient deficiency disorders.</skos:definition>
    <skos:altLabel>Malnutrition mortality</skos:altLabel>
    <skos:altLabel>Undernutrition death</skos:altLabel>
    <skos:altLabel>Nutrition-related death</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000305"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000576">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other emitting technologies / infrastructure</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Emitting technologies and infrastructure not classified under the specific categories of energy, transport, agriculture, built environment, industrial, or waste systems.</skos:definition>
    <skos:altLabel>Other emitting infrastructure</skos:altLabel>
    <skos:altLabel>Other polluting technology</skos:altLabel>
    <skos:altLabel>Other carbon-intensive infrastructure</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000096"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000309">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Neglected tropical diseases and malaria mortality</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Deaths caused by neglected tropical diseases and malaria, disproportionately affecting populations in low-income tropical settings.</skos:definition>
    <skos:altLabel>NTD mortality</skos:altLabel>
    <skos:altLabel>Malaria death</skos:altLabel>
    <skos:altLabel>Tropical disease mortality</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000306"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000202">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Full systematic review</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A systematic review conducted with comprehensive search strategies and full methodological rigour, without time or resource constraints that would limit its scope.</skos:definition>
    <skos:altLabel>Comprehensive systematic review</skos:altLabel>
    <skos:altLabel>Full SR</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000201"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000362">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Lyme disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A tick-borne bacterial infection caused by Borrelia burgdorferi, presenting with a characteristic expanding rash and potentially causing cardiac, neurological, and joint complications if untreated.</skos:definition>
    <skos:altLabel>Borrelia burgdorferi</skos:altLabel>
    <skos:altLabel>Tick-borne disease</skos:altLabel>
    <skos:altLabel>Lyme borreliosis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000353"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000324">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000325"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000328"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000327"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000329"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Enteric infections</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infections of the gastrointestinal tract transmitted via contaminated food or water, including diarrhoeal diseases, typhoid, and cholera.</skos:definition>
    <skos:scopeNote>GBD ref: 957</skos:scopeNote>
    <skos:altLabel>Gastrointestinal infections</skos:altLabel>
    <skos:altLabel>Gut infections</skos:altLabel>
    <skos:altLabel>Waterborne infections</skos:altLabel>
    <skos:altLabel>Foodborne infections</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000314"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000556">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Health-in-all-policies</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>A governance approach that systematically integrates health considerations into climate policy and climate considerations into health policy, recognising that health outcomes are shaped by decisions made across multiple sectors including energy, transport, food, and land use.</skos:definition>
    <skos:altLabel>Health in all policies</skos:altLabel>
    <skos:altLabel>HiAP</skos:altLabel>
    <skos:altLabel>Cross-sectoral health policy</skos:altLabel>
    <skos:altLabel>Health-climate policy integration</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000595">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>(Unspecified) climate change</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability"/>
    <skos:definition>Climate change where the specific driver or mechanism is not identified or distinguished, used when studies refer to climate change in general terms.</skos:definition>
    <skos:altLabel>General climate change</skos:altLabel>
    <skos:altLabel>Unspecified climate change</skos:altLabel>
    <skos:altLabel>Global warming</skos:altLabel>
    <skos:altLabel>Climate emergency</skos:altLabel>
    <skos:altLabel>Climate crisis</skos:altLabel>
    <skos:altLabel>Global heating</skos:altLabel>
    <skos:altLabel>Earth warming</skos:altLabel>
    <skos:altLabel>Atmospheric warming</skos:altLabel>
    <skos:altLabel>Planetary warming</skos:altLabel>
    <skos:altLabel>Climate breakdown</skos:altLabel>
    <skos:altLabel>Climate disruption</skos:altLabel>
    <skos:altLabel>Rising global temperatures</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000587">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other institution-based interventions</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Institutional interventions not classified under health system governance, research and education, emergency management, or international development and aid.</skos:definition>
    <skos:altLabel>Other institutional response</skos:altLabel>
    <skos:altLabel>Other organisational measure</skos:altLabel>
    <skos:altLabel>Other system-level intervention</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000114"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements/DSNY000507">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cities</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Formal urban settlements with a population of between 100,000 and 1,000,000 inhabitants, with established administrative systems, diverse economies, and relatively comprehensive urban infrastructure.</skos:definition>
    <skos:altLabel>Medium cities</skos:altLabel>
    <skos:altLabel>Urban centres</skos:altLabel>
    <skos:altLabel>Mid-sized cities</skos:altLabel>
    <skos:altLabel>100,000 to 1 million</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000505"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000327">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
