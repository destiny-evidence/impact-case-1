  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000451">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Acne vulgaris</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A chronic inflammatory disease of the pilosebaceous unit characterised by comedones, papules, pustules, and nodules, predominantly affecting the face and trunk.</skos:definition>
    <skos:scopeNote>GBD ref: 661</skos:scopeNote>
    <skos:altLabel>Acne</skos:altLabel>
    <skos:altLabel>Acne vulgaris skin condition</skos:altLabel>
    <skos:altLabel>Pimples</skos:altLabel>
    <skos:altLabel>Spots</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000269">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Loss of livelihood / income (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Economic disruption resulting in the loss of employment, income, or livelihoods, with downstream effects on food security, mental health, and access to healthcare.</skos:definition>
    <skos:altLabel>Income loss</skos:altLabel>
    <skos:altLabel>Livelihood disruption</skos:altLabel>
    <skos:altLabel>Economic hardship</skos:altLabel>
    <skos:altLabel>Unemployment</skos:altLabel>
    <skos:altLabel>Financial loss</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000267"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000390">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cardiomyopathy and myocarditis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Diseases of the heart muscle including cardiomyopathy and inflammation of the myocardium, leading to impaired cardiac function and heart failure.</skos:definition>
    <skos:scopeNote>GBD ref: 499</skos:scopeNote>
    <skos:altLabel>Myocarditis</skos:altLabel>
    <skos:altLabel>Dilated cardiomyopathy</skos:altLabel>
    <skos:altLabel>Heart muscle disease</skos:altLabel>
    <skos:altLabel>Cardiomyopathy</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000445">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Dermatitis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Inflammatory skin conditions characterised by erythema, pruritus, and scaling, including atopic dermatitis and contact dermatitis.</skos:definition>
    <skos:scopeNote>GBD ref: 654</skos:scopeNote>
    <skos:altLabel>Eczema</skos:altLabel>
    <skos:altLabel>Atopic dermatitis</skos:altLabel>
    <skos:altLabel>Contact dermatitis</skos:altLabel>
    <skos:altLabel>Skin inflammation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000349">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Guinea worm disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A parasitic infection caused by Dracunculus medinensis, acquired by drinking water containing infected copepods, resulting in a slowly emerging worm through the skin.</skos:definition>
    <skos:scopeNote>GBD ref: 936</skos:scopeNote>
    <skos:altLabel>Dracunculiasis</skos:altLabel>
    <skos:altLabel>Guinea worm</skos:altLabel>
    <skos:altLabel>Dracunculus medinensis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000414">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other digestive diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Digestive diseases not classified under the specific GBD sub-categories of liver, upper GI, appendix, hernia, IBD, vascular, gallbladder, or pancreatic disease.</skos:definition>
    <skos:scopeNote>GBD ref: 1161</skos:scopeNote>
    <skos:altLabel>Other GI diseases</skos:altLabel>
    <skos:altLabel>Other bowel diseases</skos:altLabel>
    <skos:altLabel>Other gastrointestinal conditions</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000404"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000340">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Trachoma</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A chronic bacterial eye infection caused by Chlamydia trachomatis, the leading infectious cause of preventable blindness worldwide.</skos:definition>
    <skos:scopeNote>GBD ref: 356</skos:scopeNote>
    <skos:altLabel>Chlamydial conjunctivitis</skos:altLabel>
    <skos:altLabel>Chlamydia trachomatis</skos:altLabel>
    <skos:altLabel>Blinding trachoma</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000389">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Non-rheumatic valvular heart disease</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Dysfunction of one or more heart valves not attributable to rheumatic disease, including aortic stenosis, mitral regurgitation, and degenerative valve conditions.</skos:definition>
    <skos:scopeNote>GBD ref: 504</skos:scopeNote>
    <skos:altLabel>Valvular heart disease</skos:altLabel>
    <skos:altLabel>Heart valve disease</skos:altLabel>
    <skos:altLabel>Aortic stenosis</skos:altLabel>
    <skos:altLabel>Mitral regurgitation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000384"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age/DSNY000253">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Child (6-12 years)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/population-age"/>
    <skos:definition>Children aged 6 to 12 years in middle childhood, a period of continued physical growth, cognitive development, and increasing social independence.</skos:definition>
    <skos:altLabel>Primary school age</skos:altLabel>
    <skos:altLabel>School children</skos:altLabel>
    <skos:altLabel>Middle childhood</skos:altLabel>
    <skos:altLabel>6 to 12 year olds</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000251"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000555">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other evidence synthesis type</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>Evidence synthesis types not captured by the specific categories of systematic review, umbrella review, narrative review, guideline, or health technology assessment.</skos:definition>
    <skos:altLabel>Other synthesis type</skos:altLabel>
    <skos:altLabel>Other review type</skos:altLabel>
    <skos:altLabel>Unclassified evidence synthesis</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000198"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000419">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Multiple sclerosis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A chronic autoimmune demyelinating disease of the central nervous system, characterised by relapsing or progressive neurological deficits affecting motor, sensory, and cognitive function.</skos:definition>
    <skos:scopeNote>GBD ref: 546</skos:scopeNote>
    <skos:altLabel>MS</skos:altLabel>
    <skos:altLabel>Demyelinating disease</skos:altLabel>
    <skos:altLabel>Multiple sclerosis disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000415"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000338">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Lymphatic filariasis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A mosquito-transmitted parasitic disease caused by filarial worms, leading to lymphatic damage, lymphoedema, and disfiguring swelling of the limbs and genitals.</skos:definition>
    <skos:scopeNote>GBD ref: 354</skos:scopeNote>
    <skos:altLabel>LF</skos:altLabel>
    <skos:altLabel>Elephantiasis</skos:altLabel>
    <skos:altLabel>Wuchereria bancrofti</skos:altLabel>
    <skos:altLabel>Filarial disease</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000330"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-exposure/DSNY000272">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Violence / conflict (Exposure)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-exposure"/>
    <skos:definition>Exposure to interpersonal or collective violence, including armed conflict, gender-based violence, and civil unrest, as a determinant of physical and mental health outcomes.</skos:definition>
    <skos:altLabel>Conflict exposure</skos:altLabel>
    <skos:altLabel>Armed conflict</skos:altLabel>
    <skos:altLabel>Gender-based violence</skos:altLabel>
    <skos:altLabel>Civil unrest</skos:altLabel>
    <skos:altLabel>Political violence</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-exposure/DSNY000267"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000380">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Malignant skin melanoma</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A malignant tumour arising from melanocytes in the skin, strongly associated with ultraviolet radiation exposure and with high metastatic potential.</skos:definition>
    <skos:scopeNote>GBD ref: 459</skos:scopeNote>
    <skos:altLabel>Melanoma</skos:altLabel>
    <skos:altLabel>Skin melanoma</skos:altLabel>
    <skos:altLabel>Cutaneous melanoma</skos:altLabel>
    <skos:altLabel>Malignant melanoma</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000378"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000452">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Alopecia areata</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>An autoimmune condition causing patchy non-scarring hair loss on the scalp or other hair-bearing areas, which may progress to total hair loss.</skos:definition>
    <skos:scopeNote>GBD ref: 662</skos:scopeNote>
    <skos:altLabel>Hair loss</skos:altLabel>
    <skos:altLabel>Alopecia</skos:altLabel>
    <skos:altLabel>Alopecia areata hair loss</skos:altLabel>
    <skos:altLabel>Patchy hair loss</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000444"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/methods/DSNY000538">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Fixed effects / panel regression</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/methods"/>
    <skos:definition>A regression approach using repeated observations on the same units over time to control for time-invariant unobserved confounding, including standard fixed effects, panel regression, and adjusted cohort analysis.</skos:definition>
    <skos:altLabel>Fixed effects model</skos:altLabel>
    <skos:altLabel>Panel regression</skos:altLabel>
    <skos:altLabel>Adjusted cohort analysis</skos:altLabel>
    <skos:altLabel>Within-estimator</skos:altLabel>
    <skos:altLabel>Two-way fixed effects</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/methods/DSNY000532"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000578">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Other behaviour related to mitigation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Mitigation behaviours not classified under the specific categories of mobility, household, food and diet, or goods and consumption.</skos:definition>
    <skos:altLabel>Other low-carbon behaviour</skos:altLabel>
    <skos:altLabel>Other emission-reducing behaviour</skos:altLabel>
    <skos:altLabel>Other mitigation action</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000107"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/governance-scale/DSNY000128">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>International - regional (Governance scale)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/governance-scale"/>
    <skos:definition>Governance operating at a regional geographic scale spanning multiple countries within a formally defined geographic or institutional bloc, such as the European Union or the African Union.</skos:definition>
    <skos:scopeNote>Refers to governance within a formally defined geographic or institutional regional bloc spanning multiple countries, such as the European Union or the African Union. Distinct from 'Several countries', which refers to looser multi-country groupings without a formal regional structure.</skos:scopeNote>
    <skos:altLabel>World region</skos:altLabel>
    <skos:altLabel>Regional bloc</skos:altLabel>
    <skos:altLabel>Regional body</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/human-settlements/DSNY000505">
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000507"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000509"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000508"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/human-settlements/DSNY000506"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Formal urban settlements</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/human-settlements"/>
    <skos:definition>Planned, officially recognised urban areas with functioning administrative systems, legal land tenure, and access to infrastructure and services, categorised by population size following Revi et al. (2025).</skos:definition>
    <skos:altLabel>Planned urban areas</skos:altLabel>
    <skos:altLabel>Formal cities</skos:altLabel>
    <skos:altLabel>Official urban settlements</skos:altLabel>
    <skos:altLabel>Recognised urban areas</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000582">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other ecosystem-based interventions</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Ecosystem-based interventions not classified under urban green-blue infrastructure, coastal and marine protection, or forest and land management.</skos:definition>
    <skos:altLabel>Other nature-based solutions</skos:altLabel>
    <skos:altLabel>Other green infrastructure</skos:altLabel>
    <skos:altLabel>Other ecosystem intervention</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000113"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/fossil-fuels">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>E.4 Climate factors - Fossil fuels</dct:title>
    <dct:description>Carbon-based energy sources formed from ancient organic matter, whose combustion is the dominant source of anthropogenic greenhouse gas emissions and a major driver of air pollution and associated health burdens.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/fossil-fuels/DSNY000620"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/fossil-fuels/DSNY000621"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/fossil-fuels/DSNY000622"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/fossil-fuels/DSNY000619"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000583">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Health system governance</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Institutional actions to design and strengthen health systems for climate resilience, including decentralisation, workforce and capacity building in climate-sensitive disease, updating clinical guidelines for climate risks, and ensuring flood, heat, and storm resilience of health facilities and supply chains.</skos:definition>
    <skos:altLabel>Climate-resilient health systems</skos:altLabel>
    <skos:altLabel>Health workforce capacity</skos:altLabel>
    <skos:altLabel>Hospital resilience</skos:altLabel>
    <skos:altLabel>Health system adaptation</skos:altLabel>
    <skos:altLabel>Supply chain resilience</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000114"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000090">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>National / subnational policy</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Institutional frameworks, strategies, and targets that guide governments and organisations in planning and implementing climate action, including national determined contributions, national adaptation plans and climate plans (e.g. land use policy, city-level climate health strategies, spatial planning, urban heat island reduction, flood plain management), surveillance and early-warning policy (mandated disease surveillance, heat alert systems), climate-change related public health information and education.</skos:definition>
    <skos:altLabel>Climate governance</skos:altLabel>
    <skos:altLabel>Strategic planning</skos:altLabel>
    <skos:altLabel>Climate targets</skos:altLabel>
    <skos:altLabel>National determined contributions</skos:altLabel>
    <skos:altLabel>National adaptation plans</skos:altLabel>
    <skos:altLabel>Land use policy</skos:altLabel>
    <skos:altLabel>Urban planning policy</skos:altLabel>
    <skos:altLabel>Heat health action plans</skos:altLabel>
    <skos:altLabel>Disease surveillance</skos:altLabel>
    <skos:altLabel>Health health warning systems</skos:altLabel>
    <skos:altLabel>Early warning systems</skos:altLabel>
    <skos:altLabel>public health education</skos:altLabel>
    <skos:altLabel>public health information</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000087"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/climate-drivers-variability">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>E.1 Climate factors - Climate drivers / variability</dct:title>
    <dct:description>Gradual and long-term changes in climatic conditions, including temperature, precipitation, humidity, sea level, and other physical variables that shape baseline environmental exposures relevant to health and ecological systems. Climate variability is influenced by multiple climate drivers.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000597"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000598"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000599"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000600"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000601"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000602"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000603"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000623"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000596"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/climate-drivers-variability/DSNY000595"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000462">
