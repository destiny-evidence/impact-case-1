    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000392"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000390"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000395"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000388"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000386"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000394"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000389"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000391"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000385"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000387"/>
    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000396"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Cardiovascular diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Diseases of the heart and blood vessels, including ischemic heart disease, stroke, heart failure, and other circulatory conditions.</skos:definition>
    <skos:scopeNote>GBD ref: 491</skos:scopeNote>
    <skos:altLabel>CVD</skos:altLabel>
