  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000424">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Schizophrenia</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A severe chronic mental disorder characterised by positive symptoms (hallucinations, delusions), negative symptoms (blunted affect, social withdrawal), and cognitive impairment.</skos:definition>
    <skos:scopeNote>GBD ref: 559</skos:scopeNote>
    <skos:altLabel>Psychosis</skos:altLabel>
    <skos:altLabel>Schizophrenia spectrum</skos:altLabel>
