  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000439">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Diabetes mellitus</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A group of metabolic diseases characterised by chronic hyperglycaemia resulting from defects in insulin secretion, insulin action, or both, with long-term damage to multiple organ systems.</skos:definition>
    <skos:scopeNote>GBD ref: 587</skos:scopeNote>
    <skos:altLabel>Diabetes</skos:altLabel>
    <skos:altLabel>DM</skos:altLabel>
    <skos:altLabel>Type 1 diabetes</skos:altLabel>
    <skos:altLabel>Type 2 diabetes</skos:altLabel>
    <skos:altLabel>Hyperglycaemia</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000438"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000381">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Non-melanoma skin cancer</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Malignant tumours arising from keratinocytes in the skin, including basal cell carcinoma and squamous cell carcinoma, associated with cumulative UV radiation exposure.</skos:definition>
