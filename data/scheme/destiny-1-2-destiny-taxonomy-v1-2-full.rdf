  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000418">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Idiopathic epilepsy</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A neurological disorder characterised by recurrent unprovoked seizures due to abnormal electrical activity in the brain, not attributable to an identified structural or metabolic cause.</skos:definition>
    <skos:scopeNote>GBD ref: 545</skos:scopeNote>
    <skos:altLabel>Epilepsy</skos:altLabel>
    <skos:altLabel>Seizure disorder</skos:altLabel>
    <skos:altLabel>Convulsions</skos:altLabel>
    <skos:altLabel>Seizures</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000415"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000557">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Clean energy systems</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Technologies and infrastructure for producing and distributing energy from low- or zero-carbon sources, including renewable energy systems, household energy access, cookstove replacement reducing indoor air pollution and emissions, and smart grid optimisation.</skos:definition>
    <skos:altLabel>Renewable energy</skos:altLabel>
    <skos:altLabel>Renewable energy transition</skos:altLabel>
    <skos:altLabel>Clean energy access</skos:altLabel>
    <skos:altLabel>Cookstove replacement</skos:altLabel>
    <skos:altLabel>Smart grid</skos:altLabel>
    <skos:altLabel>Household energy access</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000094"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000106">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Self-protection</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Individual actions taken to protect personal health from climate hazards, such as using sunscreen, staying hydrated during heat events, or wearing respiratory protection during wildfires.</skos:definition>
    <skos:altLabel>Personal protection</skos:altLabel>
    <skos:altLabel>Individual protection</skos:altLabel>
    <skos:altLabel>Self-care adaptation</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/geographic-feature/DSNY000494">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Tundra</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/geographic-feature"/>
    <skos:definition>A treeless biome found at high latitudes and elevations, characterised by permafrost, low vegetation, and extreme cold, with particular sensitivity to warming temperatures and permafrost thaw.</skos:definition>
    <skos:altLabel>Arctic tundra</skos:altLabel>
    <skos:altLabel>Alpine tundra</skos:altLabel>
    <skos:altLabel>Permafrost landscape</skos:altLabel>
    <skos:altLabel>High-latitude tundra</skos:altLabel>
  </rdf:Description>
