    <skos:prefLabel>Respiratory infections and tuberculosis</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Acute and chronic infections of the respiratory tract, including tuberculosis, pneumonia, and upper respiratory infections.</skos:definition>
    <skos:scopeNote>GBD ref: 956</skos:scopeNote>
    <skos:altLabel>Respiratory infections</skos:altLabel>
    <skos:altLabel>Lung infections</skos:altLabel>
