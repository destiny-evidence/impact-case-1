  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000358">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Tetanus</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>A bacterial infection caused by Clostridium tetani toxin, producing painful muscle spasms and rigidity, with neonatal tetanus a particular risk in low-income settings.</skos:definition>
    <skos:scopeNote>GBD ref: 340</skos:scopeNote>
    <skos:altLabel>Clostridium tetani</skos:altLabel>
