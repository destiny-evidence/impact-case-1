  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000589">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Community-based adaptation</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/interventions-measures-responses"/>
    <skos:definition>Locally designed and led responses to climate-health risks, drawing on community knowledge and priorities to develop contextually appropriate adaptation strategies.</skos:definition>
    <skos:altLabel>Local adaptation</skos:altLabel>
    <skos:altLabel>Community-led adaptation</skos:altLabel>
    <skos:altLabel>Locally led climate action</skos:altLabel>
