  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/sectors/DSNY000118">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Energy/Extractives (Sector)</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/sectors"/>
    <skos:definition>The sector covering electricity generation, fuel production, and resource extraction, including both fossil fuel and renewable energy systems.</skos:definition>
    <skos:altLabel>Energy sector</skos:altLabel>
    <skos:altLabel>Power generation</skos:altLabel>
    <skos:altLabel>Mining</skos:altLabel>
