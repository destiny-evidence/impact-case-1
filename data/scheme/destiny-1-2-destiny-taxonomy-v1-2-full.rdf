    <skos:altLabel>Dementia</skos:altLabel>
    <skos:altLabel>Alzheimer's disease</skos:altLabel>
    <skos:altLabel>AD</skos:altLabel>
    <skos:altLabel>Vascular dementia</skos:altLabel>
    <skos:altLabel>Cognitive decline</skos:altLabel>
    <skos:broader rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000415"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/population-age">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <dct:title>A.1 Population - Age</dct:title>
    <dct:description>Age group classifications used to stratify populations in climate and health research, from newborns to older adults.</dct:description>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000254"/>
    <skos:hasTopConcept rdf:resource="https://vocab.destiny-evidence.org/population-age/DSNY000255"/>
