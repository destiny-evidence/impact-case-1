    <skos:narrower rdf:resource="https://vocab.destiny-evidence.org/health-outcomes/DSNY000472"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000363">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Z_Other unspecified infectious diseases</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Infectious diseases not elsewhere classified, including rare, emerging, or unspecified infections not captured in major GBD sub-categories.</skos:definition>
