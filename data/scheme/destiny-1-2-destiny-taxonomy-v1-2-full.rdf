  </rdf:Description>
  <rdf:Description rdf:about="https://vocab.destiny-evidence.org/health-outcomes/DSNY000432">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:prefLabel>Idiopathic developmental intellectual disability</skos:prefLabel>
    <skos:inScheme rdf:resource="https://vocab.destiny-evidence.org/health-outcomes"/>
    <skos:definition>Significantly impaired intellectual functioning and adaptive behaviour arising from neurodevelopmental causes, without an identifiable acquired or genetic aetiology.</skos:definition>
    <skos:scopeNote>GBD ref: 582</skos:scopeNote>
    <skos:altLabel>Intellectual disability</skos:altLabel>
