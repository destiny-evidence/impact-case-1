  {
    "@id": "https://vocab.destiny-evidence.org/health-exposure/DSNY000264",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@value": "Water security"
      },
      {
        "@value": "Water availability"
      },
      {
        "@value": "Water contamination"
      },
      {
        "@value": "Drinking water quality"
      },
      {
        "@value": "Flood water exposure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Changes in the availability, quality, and safety of freshwater and other water sources, including flooding, drought, and contamination affecting drinking water and sanitation."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://vocab.destiny-evidence.org/health-exposure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Water quality and quantity (Exposure)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@value": "Climate change may compromise water quality through several pathways, such as favouring the growth of organisms that cause waterborne gastrointestinal illness and boosting the growth of harmful algae, Cyanobacteria, Escherichia coli and other bacterial strains, and viruses. Clean water may not even be available owing to drought or contamination after extreme weather, storm surges and floodings. Potential health impacts include: campylobacter infection, cholera, cryptosporidiosis, harmful algal blooms, leptospirosis, norovirus infection, typhoid fever, rotavirus infection, diarrhoea (E.coli), melioidosis, hepatitis E, dysentery.\n"
      }
    ]
  },
