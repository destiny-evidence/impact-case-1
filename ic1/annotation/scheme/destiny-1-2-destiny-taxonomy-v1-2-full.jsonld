      {
        "@value": "Migration"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@value": "Refers to migration as a deliberate adaptive behaviour in response to climate hazards — the act of relocating as a coping or protective strategy. Distinct from 'Migrants' in the Population scheme, which classifies people who have migrated as a potentially vulnerable population group."
      }
    ]
  },
  {
    "@id": "https://vocab.destiny-evidence.org/health-metrics/DSNY000291",
    "@type": [
