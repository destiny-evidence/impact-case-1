  {
    "@id": "https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000105",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@value": "Climate migration"
      },
      {
        "@value": "Relocation"
      },
      {
        "@value": "Displacement"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
