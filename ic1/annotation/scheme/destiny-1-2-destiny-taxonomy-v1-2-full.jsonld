  {
    "@id": "https://vocab.destiny-evidence.org/topic/DSNY000490",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@value": "Mal-adaptation"
      },
      {
        "@value": "Adaptive failure"
      },
      {
        "@value": "Counterproductive adaptation"
      },
      {
        "@value": "Failed adaptation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broader": [
      {
        "@id": "https://vocab.destiny-evidence.org/topic/DSNY000052"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Adaptation actions that inadvertently increase vulnerability or exposure to harm, reduce adaptive capacity, or create new risks for human or natural systems, often as an unintended consequence of well-intentioned interventions."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://vocab.destiny-evidence.org/topic"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Maladaptation"
      }
    ]
  },
  {
    "@id": "https://vocab.destiny-evidence.org/health-exposure/DSNY000266",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#altLabel": [
      {
        "@value": "Vector-borne disease risk"
      },
      {
        "@value": "Mosquito distribution"
      },
      {
        "@value": "Tick distribution"
      },
      {
        "@value": "Vector ecology"
      },
      {
        "@value": "Disease vector range"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Changes in the geographic range, abundance, and seasonal activity of vectors — such as mosquitoes, ticks and mites — that alter the transmission risk of vector-borne diseases."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://vocab.destiny-evidence.org/health-exposure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@value": "Vector distribution and ecology (Exposure)"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@value": "Climate change is altering the geographic distributions and life cycles of insect vectors, such as mosquitoes, ticks and mites, which may increase the risk, incidence, or geographic range of some vector-borne diseases and the emergence of new diseases (e.g. climate-sensitive zoonotic diseases). Animal disease vectors also comprise other taxonomic groups than insects, e.g. ticks (mites, arachnids), other arthropods, and also mammals (e.g. bats, rats and mice). These changes have important implications for several diseases such as Chikungunya (vector: mosquitoes), dengue (vector: mosquitoes), encephalitis (e.g. tick-borne encephalitis, Japanese encephalitis, Murray Valley encephalitis, or West Nile encephalitis.), Hantavirus infection (vector: rodents), Lyme disease (vector: ticks), malaria (vector: mosquitoes), Rift Valley fever (vector: mosquitoes), West Nile virus infection (vector: mosquitoes), Zika virus infection (vector: mosquitoes), Ross River fever (vector: mosquitoes), Crimean-Congo haemorrhagic fever (vector: ticks), Leishmaniasis (vector: sandflies), Oropouche virus disease/fever (vector: midges, especially Culicoides paraensis). \n\n\n"
      }
    ]
  },
