        "@id": "https://vocab.destiny-evidence.org/interventions-measures-responses/DSNY000098"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Movement of individuals or communities away from areas made uninhabitable or highly hazardous by climate change, including both voluntary relocation and forced displacement."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
